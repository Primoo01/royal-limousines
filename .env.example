# Chave pública de acesso do Web3Forms (https://web3forms.com/).
# Crie uma conta gratuita, gere a chave e cole aqui (e nas variáveis de
# ambiente do Cloudflare Pages em produção). Precisa do prefixo PUBLIC_
# porque o Astro só expõe ao navegador variáveis com esse prefixo.
PUBLIC_WEB3FORMS_ACCESS_KEY=
