---
// Página "Frota" — os dois Chrysler 300C e a transição dia→noite (ver CLAUDE.md
// > Signature). A animação de scroll fica pra Etapa 4; aqui já entra a estrutura:
// bloco do 300C branco (mundo claro, conteúdo real do backup) seguido do bloco
// do 300C preto (mundo escuro).
//
// A assimetria entre as duas seções é proposital (ver CLAUDE.md > Design):
// o 300C branco é espetáculo (chegada, festa), o 300C preto é discrição
// (transfer, viagem, saída sem alarde) — por isso a seção dele é
// deliberadamente mais curta. O texto do sedan mora isolado em
// src/data/sedan-preto.js pra ser completado quando o cliente confirmar mais
// detalhes (capacidade, itens de série, ano, serviços).
import BaseLayout from '../layouts/BaseLayout.astro';
import Foto from '../components/Foto.astro';
import { fotosLimo } from '../data/fotos-limo.js';
import Marquee from '../components/Marquee.astro';
import Botao from '../components/Botao.astro';
import EntradaTitulo from '../components/EntradaTitulo.astro';
import Carrossel from '../components/Carrossel.astro';
import Video360 from '../components/Video360.astro';
// Reaproveitado do Hero 1, não recriado: é o mesmo componente, entrando aqui
// como ambiente dentro da camada de fundo (ver .fundo-dinamico no CSS).
import CortinaDeLuz from '../components/CortinaDeLuz.astro';
import { videos360 } from '../data/videos-360.js';
import { Image } from 'astro:assets';
import silhuetaSedan from '../assets/fundos/300c-sedan-silhueta.png';
import site from '../config/site.js';
import paginas from '../data/paginas-antigas.json';
import sedanPreto from '../data/sedan-preto.js';
import { fichaSegura } from '../data/sedan.js';
import { fotosGaleriaSedan } from '../data/galeria-sedan.js';

const dados = paginas.paginas.find((p) => p.url === '/limousines/');
// O backup não tinha meta description nesta página. Escrita a partir de fatos
// reais já usados no corpo da própria página (Chrysler 300C branco, 8m, 8
// passageiros, casamentos/aniversários/eventos, São Paulo).
const description =
  'Aluguel de limousine em São Paulo: conheça o Chrysler 300C branco, com 8 metros e capacidade para 8 passageiros, para casamentos, aniversários e eventos.';
---

<BaseLayout title={dados.title} description={description}>
  <section class="u-container bloco-frota reveal">
    <p class="u-eyebrow">Frota Royal Limousines</p>
    <EntradaTitulo as="h1">Limousine | Aluguel de Limousine</EntradaTitulo>
    <div class="u-prosa bloco-frota__intro">
      <p>
        Limousine para casamento! As melhores limousines para locação,
        limousine para eventos, limousine para casamentos é só na Royal
        Limousines.
      </p>
      <p>
        Limousine para baladas, limousine para aniversários, limousine para
        jantares, você só encontra na Royal Limousines.
      </p>
    </div>

    <div class="bloco-frota__grade">
      <Foto
        src={fotosLimo.tresQuartosFrontal.src}
        alt={fotosLimo.tresQuartosFrontal.alt}
        posicao={fotosLimo.tresQuartosFrontal.posicao}
        aspectRatio="4/3"
        class="reveal"
      />
      <div>
        <EntradaTitulo as="h2">Limousine para Casamentos Chrysler 300C</EntradaTitulo>
        <div class="u-prosa">
          <p>
            A Royal Limousine é uma empresa especializada na locação de
            limousine. Estamos desde 2008 no mercado, no ramo de locação e
            aluguel de limousine. Limousine traz sofisticação, elegância e
            conforto.
          </p>
          <p>
            As nossas limousines têm um estilo clássico idealizado para
            atender os momentos especiais de sua vida.
          </p>
          <p>
            Com seus 8 metros de extensão e capacidade para 8 passageiros,
            foi projetada com base no contraste no clássico com o elegante.
          </p>
          <p>Tudo o que você precisa para causar grandes impressões.</p>
        </div>
      </div>
    </div>

    <div class="bloco-frota__interior">
      <div class="bloco-frota__interior-texto">
        <h3>Espaço interno</h3>
        <div class="u-prosa">
          <p>
            Nossas limousines têm sistema de iluminação party, com canhões de
            laser e neon, poltronas em couro marfim com detalhes em marrom.
          </p>
          <p>
            O interior da limousine, apesar de high-tech, dispõe de todo luxo e
            conforto que você deseja.
          </p>
          <p>
            Variedade de bebidas finas dispostas em seu bar, frigobar, 3 telas
            de vídeo (uma de 20” de plasma e duas de 8,5” LCD), ar condicionado
            bilateral, sistema completo de player (DVD, MP3, CD e foto)
            integrado ao seu sistema especial de áudio, saída interna de 110
            watts, comunicação com chofer através de head free e sistema party
            de decoração.
          </p>
          <p>Tudo isso com total privacidade com seu insulfim black out.</p>
        </div>
      </div>

      {/* A foto do salão de passageiros: é exatamente o que os parágrafos ao
          lado descrevem (bar, couro claro, iluminação de festa). */}
      <Foto
        src={fotosLimo.interna.src}
        alt={fotosLimo.interna.alt}
        aspectRatio="4/5"
        larguraServida={900}
        sizes="(max-width: 56rem) 100vw, 45vw"
        class="bloco-frota__interior-midia reveal"
      />
    </div>

    <div class="u-prosa bloco-frota__fechamento">
      {/*
        Reescrito na rodada "lote 2". A versão anterior repetia "limousine
        para X" oito vezes seguidas — keyword stuffing, que hoje o Google
        penaliza em vez de premiar. NENHUM termo foi removido: casamentos,
        festas, eventos, despedida de solteiro, debutantes, aluguel, locação,
        televisão, São Paulo, SP, 2008, preço justo e garantia continuam
        todos aqui, redistribuídos em frases que se leem. Ver a comparação
        termo a termo na resposta da rodada.
      */}
      <p>
        As melhores limousines para locação você só encontra na Royal
        Limousine, que está no mercado de limousines desde 2008. Somos
        líderes em aluguel de limousine para casamentos e festas em SP, e
        atendemos também eventos, despedida de solteiro, debutantes e
        televisão em São Paulo. Nossas limousines são diferenciadas do
        mercado, e trabalhamos com preço justo e garantia.
      </p>
      <p>
        Entre em contato com a Royal Limousine e solicite o seu orçamento
        para aluguel de limousine. Atendemos os serviços de limousine para
        casamentos, limousine para eventos, limousine para festas de
        despedida, limousine eventos e muito mais.
      </p>
    </div>

    <div class="cta-veiculo">
      <Botao variante="barra" href="/contato/">{site.cta.orcamento}</Botao>
      <Botao variante="barra" href={site.contato.whatsapp.link} target="_blank" rel="noopener">
        {site.cta.whatsapp}
      </Botao>
    </div>

    {/* Ponte para a seção do sedan. O scroll suave vem do
        `html { scroll-behavior: smooth }` que já existe em global.css — não
        precisa de JS, e vira instantâneo sozinho em prefers-reduced-motion. */}
    <p class="bloco-frota__ponte">
      Para traslados mais discretos, sem a exposição de um carro de festa, a
      frota também tem o Chrysler 300C preto.
    </p>
    <Botao variante="terciario" href="#sedan">Conhecer o sedan 300C preto</Botao>
  </section>

  <Marquee />

  <!--
    Transição dia→noite (ver CLAUDE.md > Signature). O fundo/texto/dourado
    de tudo daqui pra baixo é controlado por CSS custom properties no
    wrapper .mundo-dinamico, interpoladas via JS conforme o scroll (Movimento.astro).
    O style inline abaixo já nasce com os valores do mundo escuro — é o
    estado de repouso (fim da transição, ou fallback sem JS). Como a seção
    começa fora da viewport (depois do carro branco), o JS assume antes que
    desse valor inicial "flashar" pra quem está rolando a página. Com
    prefers-reduced-motion, global.css força esses mesmos valores e esconde
    o spacer da transição — sem JS nenhum rodando.
  -->
  <div
    class="mundo-dinamico"
    data-mundo-dinamico
    style="--bg-escuro-pagina:#020202;--surface:#211e18;--linha:#3a342a;--texto:#ede7db;--texto-mut:#8c857a;--ouro:#c6a25e;"
  >
    {/*
      CAMADA ÚNICA DE FUNDO. É a única coisa que pinta fundo daqui pra
      baixo — o `background-color` do wrapper e o `::before` de #020202 do
      bloco do sedan saíram, e o body virou transparente nesta página.
      `position: fixed` + `inset: 0`, então cobre a viewport em qualquer
      posição de scroll e não tem costura possível.
      A cortina de luz entra dentro dela como ambiente.
    */}
    <div class="fundo-dinamico" aria-hidden="true">
      <CortinaDeLuz />
    </div>

    <div class="transicao-dia-noite" data-transicao-dia-noite aria-hidden="true">
      <span class="ponto-luz" style="top: 15%; left: 12%;"></span>
      <span class="ponto-luz" style="top: 30%; left: 78%;"></span>
      <span class="ponto-luz" style="top: 48%; left: 35%;"></span>
      <span class="ponto-luz" style="top: 62%; left: 88%;"></span>
      <span class="ponto-luz" style="top: 75%; left: 20%;"></span>
      <span class="ponto-luz" style="top: 88%; left: 60%;"></span>
    </div>

    <section id="sedan" class="u-container bloco-frota bloco-frota--escuro reveal">
      <Image
        class="silhueta-fundo silhueta-fundo--escuro"
        src={silhuetaSedan}
        alt=""
        aria-hidden="true"
        widths={[700, 1400]}
        sizes="60vw"
        format="webp"
        loading="lazy"
      />
      <p class="u-eyebrow">{sedanPreto.eyebrow}</p>
      <EntradaTitulo as="h2">{sedanPreto.titulo}</EntradaTitulo>

      <div class="bloco-frota--escuro__corpo">
        <div class="u-prosa">
          {sedanPreto.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
        </div>

        {/* Só a ficha SEGURA. Os campos por confirmar (ano, versão, motor,
            potência, capacidade, itens de série, atendimento fora de SP)
            existem em sedan.js mas não são importados aqui de propósito. */}
        <dl class="ficha-tecnica">
          {
            fichaSegura.map((item) => (
              <div class="ficha-tecnica__item">
                <dt>{item.rotulo}</dt>
                <dd>{item.valor}</dd>
              </div>
            ))
          }
        </dl>

        <div class="cta-veiculo">
          <Botao variante="barra" href="/contato/">{site.cta.orcamento}</Botao>
          <Botao variante="barra" href={site.contato.whatsapp.link} target="_blank" rel="noopener">
            {site.cta.whatsapp}
          </Botao>
        </div>
      </div>
    </section>

    {/* Fora do u-container: vídeo e carrossel são de sangria total. O vídeo
        vem primeiro — a volta em torno do carro antes dos detalhes. */}
    {/* Sem a classe .fotos-sedan: aquele filtro corrige a subexposição das
        FOTOS do sedan (e a regra em global.css mira `img`, não `video`). O
        vídeo já vem exposto e não precisa da correção. */}
    <div class="bloco-sedan__video">
      <Video360
        src={videos360.sedan.src}
        poster={videos360.sedan.poster}
        largura={videos360.sedan.largura}
        altura={videos360.sedan.altura}
        alt={videos360.sedan.alt}
      />
    </div>
    <Carrossel fotos={fotosGaleriaSedan} mundo="escuro" class="fotos-sedan" />
  </div>
</BaseLayout>

<style>
  .bloco-frota {
    min-height: 100svh;
    padding-block: var(--espaco-7);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .bloco-frota__intro {
    margin-top: var(--espaco-3);
    display: flex;
    flex-direction: column;
    gap: var(--espaco-2);
    color: var(--texto);
  }

  .bloco-frota__grade {
    margin-top: var(--espaco-5);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--espaco-5);
    align-items: center;
  }

  .bloco-frota__grade--inverso {
    grid-template-columns: 1fr 1fr;
  }

  .bloco-frota__grade .u-prosa p {
    color: var(--texto);
    margin-top: var(--espaco-2);
  }

  /* Texto à esquerda, foto à direita sangrando até a borda da tela. */
  .bloco-frota__interior {
    margin-top: var(--espaco-5);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--espaco-5);
    /* Foto alinhada ao TOPO do texto, não centralizada na linha. */
    align-items: start;
  }

  .bloco-frota__interior-texto {
    max-width: 44rem;
  }

  /* Sangria só à direita: a seção é .u-container (centralizada, teto de
     --largura-container), então a distância da borda do conteúdo até a
     borda da tela é o padding do container mais a metade da sobra. É essa
     distância que a margem negativa devolve. */
  .bloco-frota__interior-midia {
    margin-right: calc(-1 * (var(--espaco-3) + max(0px, (100vw - var(--largura-container)) / 2)));
  }

  .bloco-frota__interior .u-prosa {
    margin-top: var(--espaco-2);
    display: flex;
    flex-direction: column;
    gap: var(--espaco-2);
    color: var(--texto);
  }

  .bloco-frota__fechamento {
    margin-top: var(--espaco-5);
    display: flex;
    flex-direction: column;
    gap: var(--espaco-2);
    color: var(--texto);
  }

  /* Duas barras de fim de seção empilhadas (uma por ação) — a de baixo não
     repete o fio de cima, pra não dobrar a linha no meio. */
  .cta-veiculo {
    display: flex;
    flex-direction: column;
    margin-top: var(--espaco-4);
  }

  .cta-veiculo > .botao--barra + .botao--barra {
    border-top: none;
  }

  /* Ponte pro sedan, no fim da seção branca. */
  .bloco-frota__ponte {
    margin-top: var(--espaco-6);
    padding-top: var(--espaco-4);
    border-top: 1px solid var(--linha);
    max-width: 34rem;
    color: var(--texto);
  }

  .bloco-frota__ponte + :global(.botao) {
    margin-top: var(--espaco-2);
  }

  /* A seção do sedan resolve por PESO VISUAL, não por quantidade de texto:
     tela cheia, título bem maior, muito mais respiro. A contenção do texto é
     proposital (branco = espetáculo, preto = discrição). */
  .bloco-frota--escuro {
    position: relative;
    min-height: 100svh;
    padding-block: var(--espaco-7);
    /* Alvo do link "#sedan": sem isto o título nasce por baixo do header. */
    scroll-margin-top: var(--altura-header);
    /* Recorta a silhueta que sangra pela borda direita. */
    overflow: hidden;
  }

  /* O ::before que pintava #020202 chapado aqui FOI REMOVIDO — era ele a
     faixa de borda dura da transição. Com `z-index: -1` ele normalmente
     ficaria atrás do fundo do wrapper e invisível, mas a classe `reveal`
     deixa esta seção em opacity 0.92 enquanto anima, e opacity < 1 cria
     contexto de empilhamento: isso promovia o pseudo-elemento para cima do
     fundo do ancestral. Daí a faixa aparecer só durante a animação de
     entrada, e persistir no mobile, onde ela roda junto com a transição.
     O preto mais fundo continua existindo — agora como destino da
     interpolação (data-bg-escuro), então chega até ele sem emenda. */

  .bloco-frota--escuro > .u-eyebrow {
    margin-bottom: var(--espaco-4);
  }

  .bloco-frota--escuro h2 {
    font-size: clamp(3.5rem, 2rem + 7.5vw, 8rem);
    max-width: 16ch;
  }

  .bloco-frota--escuro__corpo {
    margin-top: var(--espaco-7);
    max-width: 40rem;
  }

  .bloco-frota--escuro .u-prosa p {
    font-size: 1.25rem;
  }

  .bloco-frota--escuro .u-prosa p + p {
    margin-top: var(--espaco-3);
  }

  .ficha-tecnica {
    margin-top: var(--espaco-6);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espaco-3) var(--espaco-4);
  }

  .ficha-tecnica dt {
    font-family: var(--fonte-sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ouro);
  }

  .ficha-tecnica dd {
    margin-top: var(--espaco-1);
    font-family: var(--fonte-serif);
    font-size: 1.125rem;
  }

  .bloco-frota--escuro .cta-veiculo {
    margin-top: var(--espaco-6);
  }

  /* Respiro entre a ficha do sedan e o bloco de mídia. O carrossel logo
     abaixo tem padding próprio, então só o vídeo precisa da folga de cima. */
  .bloco-sedan__video {
    margin-top: var(--espaco-5);
  }

  /* O wrapper só carrega as variáveis e a cor do TEXTO. Quem pinta fundo é
     a camada fixa abaixo — duas camadas pintando é o que criava costura. */
  .mundo-dinamico {
    /* FONTE ÚNICA do preto mais fundo desta página. `--bg-escuro-pagina`
       vem inline (junto do resto do estado de repouso) e é lido em três
       lugares, todos por referência: aqui como repouso/sem-JS, pelo JS como
       destino da interpolação, e pelo reforço de prefers-reduced-motion em
       global.css. Assim o valor existe uma vez só. */
    --bg: var(--bg-escuro-pagina);
    color: var(--texto);
  }

  /* A camada. `z-index: -1` a põe atrás de todo o conteúdo sem precisar
     empilhar nada; ela é irmã do conteúdo, não ancestral, então nenhum
     `overflow: hidden` de seção a recorta. Nenhum ancestral dela tem
     transform, requisito do `position: fixed`. */
  .fundo-dinamico {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: var(--bg);
    pointer-events: none;
  }

  /* O body pinta `var(--bg)` por global.css e cobriria a camada, que tem
     z-index negativo. O html assume a cor de repouso como rede de
     segurança: se a camada falhar, a página fica clara — nunca branca. */
  :global(body) {
    background-color: transparent;
  }

  :global(html) {
    background-color: var(--claro-bg);
  }

  /* Cortina de luz como AMBIENTE: entra no começo da passagem, sai no fim,
     teto em 0.5 — a rampa é calculada no JS e chega em `--cortina-op`.
     Sem JS fica 0: é decoração, e exibi-la no mundo claro estaria errado.
     A regra de "visível por padrão" do CLAUDE.md vale para conteúdo. */
  .fundo-dinamico :global(.cortina) {
    opacity: var(--cortina-op, 0);
  }

  /* O véu do componente é uma elipse escura (rgba(20,18,16,.94)) feita pra
     dar legibilidade ao texto do hero. Aqui a camada está ATRÁS de tudo e,
     no mundo claro, o véu viraria uma mancha escura enorme no centro. */
  .fundo-dinamico :global(.cortina__veu) {
    display: none;
  }

  .transicao-dia-noite {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }

  .ponto-luz {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: var(--ouro-escuro);
    box-shadow: 0 0 6px 1px var(--ouro-escuro);
    opacity: 0;
  }

  @media (max-width: 56rem) {
    .bloco-frota__grade,
    .bloco-frota__grade--inverso {
      grid-template-columns: 1fr;
    }

    /* Coluna única: a foto empilha ABAIXO do texto, em largura total, e a
       sangria lateral perde a função. */
    .bloco-frota__interior {
      grid-template-columns: 1fr;
    }

    .bloco-frota__interior-midia {
      margin-right: 0;
    }

    .ficha-tecnica {
      grid-template-columns: 1fr;
    }

    .transicao-dia-noite {
      min-height: 60svh;
    }

    /* Metade das linhas da cortina: 8 nós animando em tela pequena não se
       paga, e o desenho lê igual com 4. Só `display: none` — não recria o
       componente nem duplica markup. */
    .fundo-dinamico :global(.cortina__linha:nth-child(even)) {
      display: none;
    }

    /* SILHUETA NO MOBILE. A regra global esconde `.silhueta-fundo` abaixo de
       900px por contraste (ver global.css) — a justificativa era texto por
       cima do traço. Aqui ela volta com a MESMA ideia do desktop (fundo
       decorativo sangrando pela borda), adaptada à coluna única: ancorada na
       BASE da seção, onde não há texto, centrada, sangrando pelas duas
       laterais e com opacidade muito menor (0.5 → 0.14). O `screen` do
       --escuro continua, então o fundo chapado da arte desaparece e sobra
       só o traço. O `overflow: hidden` da seção recorta a sangria. */
    .bloco-frota--escuro .silhueta-fundo {
      display: block;
      top: auto;
      bottom: var(--espaco-5);
      left: 50%;
      width: 132%;
      opacity: 0.14;
      transform: translateX(-50%);
    }
  }

  /* Ambiente é o primeiro a sair quando o usuário pede menos movimento. */
  @media (prefers-reduced-motion: reduce) {
    .fundo-dinamico :global(.cortina) {
      display: none;
    }
  }
</style>
