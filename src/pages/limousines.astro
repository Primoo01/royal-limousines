     transform, requisito do `position: fixed`. */
  .fundo-dinamico {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: var(--bg);
    pointer-events: none;
  }

  /* O body pinta `var(--bg)` por global.css e cobriria a camada, que tem
     z-index negativo. O html assume a cor de repouso como rede de
     segurança: se a camada falhar, a página fica clara — nunca branca. */
  :global(body) {
    background-color: transparent;
  }

  :global(html) {
    background-color: var(--claro-bg);
  }

