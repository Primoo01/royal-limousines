---
// A página antiga não tinha meta description. Escrita a partir das categorias
// de serviço reais da própria página (casamento, bodas, jantares românticos,
// festas debutantes) e do fato real "São Paulo" já usado em outras páginas.
import BaseLayout from '../layouts/BaseLayout.astro';
import Foto from '../components/Foto.astro';
import { getImage } from 'astro:assets';
import { fotosLimo } from '../data/fotos-limo.js';
import Botao from '../components/Botao.astro';
import CabecalhoConteudo from '../components/CabecalhoConteudo.astro';
import site from '../config/site.js';
import paginas from '../data/paginas-antigas.json';

const dados = paginas.paginas.find((p) => p.url === '/servicos/');
const description =
  dados.meta_description ??
  'Serviços da Royal Limousines em São Paulo: aluguel de limousine para casamento e bodas, jantares românticos e festas debutantes, com conforto e segurança.';

const servicos = [
  {
    titulo: 'Casamento e Bodas',
    imagem: fotosLimo.tresQuartosFrontal,
    itens: [
      'Disponível para a noiva desde o salão de beleza até o final do evento',
      'Conforto e segurança',
      'Como cortesia oferecemos água, refrigerante, Champagne e bombons finos',
      'Placa personalizada (opcional)',
    ],
  },
  {
    titulo: 'Jantares Românticos',
    imagem: fotosLimo.interna,
    itens: [
      '4 horas inesquecíveis com luxo e sofisticação',
      'Pacotes e condições especiais para jantares de 2ª a 6ª',
      'Ambiente romântico e personalizado (opcional)',
      'Como cortesia oferecemos água, refrigerante, Champagne e bombons finos',
    ],
  },
  {
    titulo: 'Festas Debutantes',
    imagem: fotosLimo.lateral,
    // Enquadramento SÓ DESTE CARTÃO — não mexe na foto em lugar nenhum.
    // A `lateral` é retrato (2268×4032) e aqui entra num contêiner 16/9, o
    // corte vertical mais agressivo do site. O `center bottom` que ela
    // carrega por padrão ancora a base da FOTO, e a base da foto é chão de
    // paralelepípedo: o carro subia pro topo do quadro com uma faixa larga
    // de chão embaixo. 68% sobe o recorte até as rodas encostarem na base.
    // Testado quadro a quadro: em 66% as rodas já começam a ser cortadas.
    posicao: 'center 68%',
    itens: [
      '2 horas de muita alegria e celebração',
      'Pacotes e condições especiais para eventos de 2ª a 6ª',
      'Infraestrutura de multimídia moderna (áudio e vídeo)',
      'Como cortesia oferecemos água, refrigerante, Champagne sem álcool e bombons finos',
    ],
  },
];

// PRELOAD DA FOTO DO LCP — a do PRIMEIRO cartão. Mesmo padrão da /limousines/:
// o `prioridade` no <Foto> dá eager + fetchpriority=high, mas a descoberta
// continua esperando o CSS resolver. O preload é o que antecipa a requisição
// para o parse do <head>. Medido antes: descoberta em 977ms, LCP em 1936ms,
// com as duas fotos de baixo da dobra (106 + 43 KB) dividindo banda.
//
// `widths` e `format` têm que ser IDÊNTICOS aos que o <Foto> gera, senão o
// navegador baixa o arquivo DUAS vezes. Este cartão passa larguraServida={800}
// e não passa `larguras`, então o componente usa [480, 800, larguraServida] —
// é essa lista, com o 800 repetido, que se reproduz aqui de propósito.
const lcpFoto = await getImage({
  src: servicos[0].imagem.src,
  widths: [480, 800, 800],
  format: 'webp',
});
// O `sizes` padrão do <Foto>, que este cartão não sobrescreve. Também precisa
// bater exatamente, pelo mesmo motivo.
const lcpSizes = '(max-width: 56.25rem) 100vw, 50vw';
---

<BaseLayout title={dados.title} description={description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={lcpFoto.srcSet.attribute}
    imagesizes={lcpSizes}
    fetchpriority="high"
  />

  {/*
    Linha de apoio realocada: era o parágrafo de lead logo abaixo do h1,
    palavra por palavra. Saiu do corpo e virou a linha do cabeçalho.
  */}
  {/* O eyebrow dizia "Serviços", a mesma palavra do h1 logo abaixo. O h1 vem
      do backup (era ["Serviços", "Royal Limousines"] no original) e é sinal
      de SEO congelado, então quem muda é o eyebrow — texto decorativo escrito
      aqui, que não existe no site antigo. */}
  <CabecalhoConteudo
    eyebrow="Nosso trabalho"
    titulo="Serviços"
    apoio="Para clientes que exigem modernidade associada ao luxo e conforto que só uma limousine pode oferecer."
  />

  <section class="u-container secao-servicos reveal">
    <div class="secao-servicos__grade reveal-grupo">
      {
        servicos.map((servico, i) => (
          <article class="servico-card">
            <Foto
              src={servico.imagem.src}
              alt={servico.imagem.alt}
              {/* O cartão pode sobrescrever o enquadramento que a foto traz
                  por padrão; sem override, vale o da própria foto. */}
              posicao={servico.posicao ?? servico.imagem.posicao}
              aspectRatio="16/9"
              larguraServida={800}
              {/* SÓ O PRIMEIRO CARTÃO. Medido a 390px: ele nasce com o topo em
                  506px, DENTRO da viewport de 844, e é o elemento LCP da
                  página. Nascia `loading="lazy"` — lazy numa imagem da
                  primeira tela — e a descoberta só acontecia em 977ms, depois
                  do layout. Os outros dois cartões ficam em 974 e 1492px e
                  continuam lazy, corretamente. */}
              prioridade={i === 0}
            />
            <h2>{servico.titulo}</h2>
            <ul>
              {servico.itens.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="hero__cta">
      <Botao variante="primario" href="/contato/">{site.cta.orcamento}</Botao>
      <Botao variante="secundario" href={site.contato.whatsapp.link} target="_blank" rel="noopener">
        {site.cta.whatsapp}
      </Botao>
    </div>
  </section>
</BaseLayout>

<style>
  /* Topo reduzido: o respiro inicial agora vem do CabecalhoConteudo. */
  .secao-servicos {
    padding-block: var(--espaco-4) var(--espaco-6);
  }

  .secao-servicos__grade {
    margin-top: var(--espaco-5);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--espaco-4);
  }

  .servico-card h2 {
    margin-top: var(--espaco-3);
    font-size: 1.375rem;
  }

  .servico-card ul {
    margin-top: var(--espaco-2);
    display: flex;
    flex-direction: column;
    gap: var(--espaco-1);
  }

  .servico-card li {
    position: relative;
    padding-left: 1.1em;
    color: var(--texto);
    font-size: 0.9375rem;
  }

  .servico-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    background-color: var(--ouro);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-2);
    margin-top: var(--espaco-5);
  }

  @media (max-width: 56rem) {
    .secao-servicos__grade {
      grid-template-columns: 1fr;
    }
  }
</style>
