---
import BaseLayout from '../layouts/BaseLayout.astro';
import Foto from '../components/Foto.astro';
import { fotosLimo } from '../data/fotos-limo.js';
import Botao from '../components/Botao.astro';
import CabecalhoConteudo from '../components/CabecalhoConteudo.astro';
import site from '../config/site.js';
import paginas from '../data/paginas-antigas.json';

const dados = paginas.paginas.find((p) => p.url === '/empresa/');
// A description original do backup (142c) ficava abaixo da faixa de 150-160
// pedida na revisão de SEO. Reescrita a partir do mesmo texto real da página
// (mesmas palavras-chave: locação de limousines, eventos, casamentos,
// aniversários, São Paulo), só ajustando o tamanho.
const description =
  'Limousines para Casamentos SP. Somos especializados em locação de limousines para eventos, casamentos e aniversários em São Paulo. Ligue e peça um orçamento.';
---

<BaseLayout title={dados.title} description={description}>
  {/*
    Linha de apoio realocada do corpo: era o primeiro parágrafo desta mesma
    página. Saiu de baixo e subiu pro cabeçalho — não foi duplicada nem
    reescrita.
  */}
  <CabecalhoConteudo
    eyebrow="Empresa"
    titulo="Limousines Royal"
    apoio="Estamos desde 2008 oferecendo traslados especiais com limousines modernas e choffer's altamente qualificados."
  />

  <section class="u-container secao-empresa reveal">
    <div class="secao-empresa__texto">
      <div class="u-prosa">
        <p>
          Somos especializados em eventos sociais, principalmente focados em
          casamentos, bodas, jantares românticos e festas debutantes.
        </p>
        <p>
          Optamos em atender pessoas sofisticadas que desejem entender o bom
          ambiente familiar para suas festas e eventos, celebrando junto a
          seus amigos e parentes momentos inesquecíveis.
        </p>
      </div>
      <Botao variante="primario" href="/contato/">{site.cta.orcamento}</Botao>
    </div>
    <Foto src={fotosLimo.frontal.src} alt={fotosLimo.frontal.alt} aspectRatio="4/3" class="reveal" />
  </section>
</BaseLayout>

<style>
  /* Topo reduzido: o respiro inicial agora vem do CabecalhoConteudo. */
  .secao-empresa {
    padding-block: var(--espaco-4) var(--espaco-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--espaco-5);
    /* `start` e não `center`: esta grade é a primeira coisa abaixo do divisor
       do CabecalhoConteudo, e o divisor cai justamente sobre a coluna de
       texto. Como a foto (4/3) é mais alta que o texto, o centramento
       empurrava a coluna curta 45,8px para baixo — o vão abaixo do divisor
       virava 85,8px contra os 40px de cima, enquanto a foto já estava nos
       40px. Com `start` os dois topos ficam na mesma linha, ambos a 40px. */
    align-items: start;
  }

  /* Sem margem no topo: este é o primeiro conteúdo visível abaixo do divisor,
     e o respiro dele já é o `padding-bottom` do cabeçalho (40px, o mesmo
     `var(--espaco-4)` que o divisor tem acima). A regra de `:first-child` do
     CabecalhoConteudo não alcançava esta margem — ela zera o
     `.secao-empresa__texto`, e os 24px moravam no `.u-prosa` aninhado dentro
     dele. Mesmo tratamento que as 8 páginas de região já tinham. */
  .secao-empresa__texto .u-prosa {
    display: flex;
    flex-direction: column;
    gap: var(--espaco-2);
    color: var(--texto);
  }

  .secao-empresa__texto .botao {
    margin-top: var(--espaco-4);
  }

  @media (max-width: 56rem) {
    .secao-empresa {
      grid-template-columns: 1fr;
    }
  }
</style>
