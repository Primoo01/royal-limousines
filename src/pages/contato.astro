---
// A página antiga não tinha meta description (nem tinha nenhuma frase de
// corpo aproveitável — só rótulos de telefone/e-mail/formulário). A
// description abaixo é factual, feita só com dados que já existem em outro
// lugar do backup (telefone, e-mail, "aluguel de limousine para casamentos e
// eventos em São Paulo"), não é uma frase nova inventada.
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Faq from '../components/Faq.astro';
import CabecalhoConteudo from '../components/CabecalhoConteudo.astro';
import site from '../config/site.js';
import paginas from '../data/paginas-antigas.json';
import faq from '../data/faq.js';

const dados = paginas.paginas.find((p) => p.url === '/contato/');
const description =
  dados.meta_description ??
  'Fale com a Royal Limousines: telefone, WhatsApp e e-mail para orçamento de aluguel de limousine para casamentos e eventos em São Paulo, 7 dias por semana.';

// JSON-LD FAQPage (ver CLAUDE.md > SEO técnico). Só AQUI: a /lp-limousine/
// também mostra o mesmo FAQ, mas é noindex — marcar lá não valeria nada e
// ainda duplicaria a marcação para o Google. As perguntas vêm de faq.js,
// que por sua vez veio do backup; nada inventado.
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.pergunta,
    acceptedAnswer: { '@type': 'Answer', text: item.resposta },
  })),
};
---

<BaseLayout title={dados.title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqPage)} />
  {/*
    Única página das quatro sem frase de corpo pra realocar (o backup só
    tinha rótulos de telefone/e-mail/formulário). A linha de apoio reusa a
    descrição curta que já existe em site.js e já aparece no rodapé — é
    conteúdo existente do site, não frase nova inventada aqui.
  */}
  {/* O eyebrow dizia "Contato", a mesma palavra do h1 logo abaixo. O h1 vem
      do backup e é sinal de SEO congelado, então quem muda é o eyebrow —
      texto decorativo escrito aqui, que não existe no site antigo e não
      carrega palavra-chave nenhuma. */}
  <CabecalhoConteudo
    eyebrow="Fale conosco"
    titulo="Contato"
    apoio={site.descricaoCurta}
    linha="assinatura"
  />

  <section class="u-container secao-contato reveal">
    <div class="secao-contato__grade">
      <div class="secao-contato__dados">
        <p><a href={site.contato.telefone.link}>{site.contato.telefone.exibicao}</a></p>
        <p><a href={site.contato.whatsapp.link} target="_blank" rel="noopener">{site.contato.whatsapp.exibicao}</a></p>
        <p><a href={`mailto:${site.contato.email}`}>{site.contato.email}</a></p>
        <p class="secao-contato__area">{site.contato.areaAtendida}</p>
      </div>

      <ContactForm />
    </div>
  </section>

  <Faq />
</BaseLayout>

<style>
  /* Topo reduzido: o respiro inicial agora vem do CabecalhoConteudo. */
  .secao-contato {
    padding-block: var(--espaco-4);
  }

  .secao-contato__grade {
    margin-top: var(--espaco-4);
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) 1fr;
    gap: var(--espaco-5);
  }

  .secao-contato__dados p {
    margin-top: var(--espaco-1);
  }

  .secao-contato__dados a {
    text-decoration: none;
    color: var(--texto);
    font-family: var(--fonte-serif);
    font-size: 1.25rem;
  }

  .secao-contato__dados a:hover {
    color: var(--ouro);
  }

  .secao-contato__area {
    color: var(--texto-mut);
    font-family: var(--fonte-sans);
    font-size: 0.9375rem;
  }

  @media (max-width: 56rem) {
    .secao-contato__grade {
      grid-template-columns: 1fr;
    }
  }
</style>
