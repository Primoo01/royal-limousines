---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Movimento from '../components/Movimento.astro';
import site from '../config/site.js';

interface Props {
  /** <title> da página — vem do backup, sem reescrever. */
  title: string;
  /** Meta description — vem do backup. Pode ser null se a página de origem não tinha. */
  description?: string | null;
  /** Caminho a usar no canonical, se diferente da URL atual. */
  canonicalPath?: string;
  /** Quando true, não renderiza nenhum <link rel="canonical"> (caso do /lp-limousine/, que não é conteúdo duplicado de mais nada). */
  semCanonical?: boolean;
  /** Conteúdo de <meta name="robots">. Só usado em páginas noindex, como a /lp-limousine/. */
  robots?: string;
  /** Caminho absoluto de uma imagem para Open Graph / Twitter card. */
  ogImage?: string | null;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = null,
  canonicalPath,
  semCanonical = false,
  robots,
  ogImage = site.seo.imagemPadrao,
  ogType = 'website',
} = Astro.props;

const paginaUrl = new URL(Astro.url.pathname, Astro.site);
const canonicalUrl = canonicalPath ? new URL(canonicalPath, Astro.site) : paginaUrl;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : null;

// JSON-LD LocalBusiness (ver CLAUDE.md > SEO técnico). Vai em TODAS as
// páginas: é a ficha do negócio, não da página. Todos os dados vêm do
// site.js — nenhum campo inventado aqui.
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nome,
  description: site.descricaoCurta,
  url: site.url,
  telephone: site.contato.telefone.link.replace('tel:', ''),
  email: site.contato.email,
  areaServed: { '@type': 'Place', name: site.contato.areaAtendida },
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
};
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1eb" />
    {/*
      Favicon. A ORDEM IMPORTA: o PNG vem primeiro e o SVG depois, porque
      navegador que entende os dois fica com a última declaração que
      suporta — então o SVG ganha, e quem não lê SVG (agregadores, leitores
      de feed, versões antigas) cai no PNG sem perceber.

      O SVG traz `prefers-color-scheme` embutido: #A8823C na aba clara,
      #EDE7DB na escura. O PNG é estático e não herda media query, por isso
      é gerado sempre no dourado #A8823C, que é o que funciona nos dois.
    */}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    {!semCanonical && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:site_name" content={site.nome} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={paginaUrl} />
    <meta property="og:locale" content={site.localeOg} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <Movimento />
  </body>
</html>
