---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '../styles/global.css';

// PRELOAD DOS 4 SUBSETS QUE O SITE REALMENTE USA.
//
// O @fontsource declara 16 @font-face (5 subsets para Cormorant, 3 para Space
// Grotesk), mas o `unicode-range` faz só os latinos serem baixados — medido:
// os 12 restantes (cyrillic, cyrillic-ext, vietnamese, latin-ext) nunca são
// requisitados. Preload de fonte não usada é banda gasta e atraso no que
// importa, então só estes quatro entram. `font-display: swap` continua no CSS
// do @fontsource, intocado.
//
// O QUE ISTO RESOLVE: o CSS é inline, mas as fontes só são DESCOBERTAS quando
// o navegador aplica esse CSS e encontra um elemento que precisa delas —
// medido em ~670ms com Fast 3G. Daí o texto passa ~600ms na fonte de fallback
// na mediana, e é essa troca que produz o CLS registrado no site.
//
// O QUE ISTO CUSTA, medido e aceito por decisão do cliente: os quatro
// arquivos têm prioridade alta e disputam banda com o próprio HTML, que é
// onde mora o CSS inline de 55 KB. Na home em 390px, com Fast 3G + CPU 4x e
// n=9, o FCP foi de 816ms para 2120ms. Sem throttling não há penalidade
// (276 → 244ms). Reduzir para 2 preloads não recuperou o FCP.
//
// `?url` faz o Vite devolver o caminho final com hash, o mesmo que o
// @font-face vai pedir — caminho escrito à mão erraria o hash e baixaria o
// arquivo duas vezes.
import cormorant500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import cormorant600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import grotesk400 from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import grotesk500 from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';

// Ordem = ordem de necessidade na tela: o <h1> é Cormorant 600 e é ele que
// reflui; o corpo é Grotesk 400.
const fontesCriticas = [cormorant600, grotesk400, cormorant500, grotesk500];

import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Movimento from '../components/Movimento.astro';
import site from '../config/site.js';

interface Props {
  /** <title> da página — vem do backup, sem reescrever. */
  title: string;
  /** Meta description — vem do backup. Pode ser null se a página de origem não tinha. */
  description?: string | null;
  /** Caminho a usar no canonical, se diferente da URL atual. */
  canonicalPath?: string;
  /** Quando true, não renderiza nenhum <link rel="canonical"> (caso do /lp-limousine/, que não é conteúdo duplicado de mais nada). */
  semCanonical?: boolean;
  /** Conteúdo de <meta name="robots">. Só usado em páginas noindex, como a /lp-limousine/. */
  robots?: string;
  /** Caminho absoluto de uma imagem para Open Graph / Twitter card. */
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  /**
   * True quando a página ABRE sobre um hero do mundo escuro. Põe a classe
   * `topo-escuro` no <html>, e é o CSS — não o JS — que passa a decidir a
   * cor do header e do botão de WhatsApp no primeiro paint.
   *
   * Antes essas seis variáveis eram escritas em document.documentElement
   * por JavaScript depois do primeiro paint: medido, o header e o botão
   * nasciam CLAROS sobre o hero escuro por 164ms no mobile e 270ms no
   * desktop. Com a classe vindo no HTML do build, o flash deixa de existir.
   * O JS continua responsável por REMOVER a classe quando o scroll sai do
   * hero — mas isso já é interação, não carregamento.
   */
  topoEscuro?: boolean;
}

const {
  title,
  description = null,
  canonicalPath,
  semCanonical = false,
  robots,
  ogImage = site.seo.imagemPadrao,
  ogType = 'website',
  topoEscuro = false,
} = Astro.props;

const paginaUrl = new URL(Astro.url.pathname, Astro.site);
const canonicalUrl = canonicalPath ? new URL(canonicalPath, Astro.site) : paginaUrl;
// URL ABSOLUTA, e é `Astro.site` quem manda: o host congelado é
// www.limousinesroyal.com.br. Verificado no backup do site antigo — 507
// ocorrências absolutas, todas com www, zero sem, incluindo o `home_url` que o
// próprio WordPress declara. Trocar para apex seria mudar as 14 canônicas.
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : null;
// Largura/altura/alt só saem quando a imagem é a padrão — são as dimensões
// DELA. Se uma página passar `ogImage` própria, declarar 1200x630 mentiria, e
// o Facebook desenha a moldura pelo que a tag diz antes de baixar o arquivo.
const ogPadraoEmUso = ogImage === site.seo.imagemPadrao;

// JSON-LD LocalBusiness (ver CLAUDE.md > SEO técnico). Vai em TODAS as
// páginas: é a ficha do negócio, não da página. Todos os dados vêm do
// site.js — nenhum campo inventado aqui.
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nome,
  description: site.descricaoCurta,
  url: site.url,
  telephone: site.contato.telefone.link.replace('tel:', ''),
  email: site.contato.email,
  areaServed: { '@type': 'Place', name: site.contato.areaAtendida },
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
};
---

<!doctype html>
<html lang={site.idioma} class:list={{ 'topo-escuro': topoEscuro }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1eb" />

    {/*
      Antes de qualquer outra coisa buscável no <head>: o preload só vale se a
      requisição sair cedo. `crossorigin` é OBRIGATÓRIO em preload de fonte,
      mesmo com o arquivo no mesmo domínio — sem ele o navegador busca num modo
      diferente do que o @font-face vai usar e baixa tudo DUAS vezes. Ver a
      nota no frontmatter sobre por que só 4 dos 16 subsets.
    */}
    {fontesCriticas.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    {/*
      Favicon. A ORDEM IMPORTA: o PNG vem primeiro e o SVG depois, porque
      navegador que entende os dois fica com a última declaração que
      suporta — então o SVG ganha, e quem não lê SVG (agregadores, leitores
      de feed, versões antigas) cai no PNG sem perceber.

      O SVG traz `prefers-color-scheme` embutido: #A8823C na aba clara,
      #EDE7DB na escura. O PNG é estático e não herda media query, por isso
      é gerado sempre no dourado #A8823C, que é o que funciona nos dois.
    */}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    {!semCanonical && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:site_name" content={site.nome} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={paginaUrl} />
    <meta property="og:locale" content={site.localeOg} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {
      ogImageUrl && ogPadraoEmUso && (
        <>
          <meta property="og:image:type" content={site.seo.imagemPadraoTipo} />
          <meta property="og:image:width" content={String(site.seo.imagemPadraoLargura)} />
          <meta property="og:image:height" content={String(site.seo.imagemPadraoAltura)} />
          <meta property="og:image:alt" content={site.seo.imagemPadraoAlt} />
        </>
      )
    }

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && ogPadraoEmUso && <meta name="twitter:image:alt" content={site.seo.imagemPadraoAlt} />}

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

    {/*
      PRELOADER — decisão e timeout. `is:inline` e no <head> de propósito: o
      Astro não deve processar nem mover este bloco, e ele precisa rodar antes
      do primeiro paint, senão a camada apareceria DEPOIS de a página já estar
      na tela, que é pior que não ter camada nenhuma.

      Três garantias, nesta ordem:

      1. QUEM ESCONDE É O JS. O CSS do Preloader nasce com a camada ausente
         (opacity 0 + visibility hidden); só a classe `preloader-ativo` a liga.
         Com JS desligado a classe nunca é escrita e a página entra normal.

      2. reduced-motion nem liga a camada. Sai antes de escrever a classe, em
         vez de ligar e revelar em seguida — ligar para desligar no quadro
         seguinte é justamente o flash que se quer evitar.

      3. O TIMEOUT É INDEPENDENTE. `setTimeout(revelar, 800)` está solto, fora
         de qualquer callback, promise ou listener. Se `document.fonts` não
         existir, lançar, ou nunca resolver, a página aparece aos 800ms de
         qualquer forma. O caminho das fontes só ANTECIPA a revelação; ele
         nunca é a única via.

      Só na primeira visita da SESSÃO: navegação interna não repete. Em modo
      privado onde sessionStorage lança, mostra e não persiste — o custo de
      errar para o lado de mostrar é 800ms, e para o outro lado é uma tela
      preta permanente.
    */}
    <script is:inline>
      (function () {
        var raiz = document.documentElement;

        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        try {
          if (sessionStorage.getItem('royal:preloader') === 'visto') return;
          sessionStorage.setItem('royal:preloader', 'visto');
        } catch (e) {}

        raiz.classList.add('preloader-ativo');

        var revelado = false;
        function revelar() {
          if (revelado) return;
          revelado = true;
          raiz.classList.remove('preloader-ativo');
        }

        // A rede de segurança. Não mexa nisto sem reler a nota acima.
        setTimeout(revelar, 800);

        // Exposto para o caminho rápido, no fim do <body> — lá o CSS já foi
        // parseado e as @font-face existem. Perguntar por elas aqui devolveria
        // "pronto" na hora, porque a família ainda não estaria declarada, e a
        // camada piscaria sem nunca esperar nada.
        window.__royalRevelarPreloader = revelar;
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <Preloader />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <Movimento />

    {/*
      CAMINHO RÁPIDO do preloader: revela assim que as duas fontes de fato
      usadas estiverem carregadas, em vez de esperar os 800ms cheios.

      Aqui no fim do <body> as @font-face já foram parseadas — pedir por elas
      no <head> devolveria "pronto" imediatamente, porque a família ainda não
      existiria. `document.fonts.load` pede as faces por nome, ao contrário de
      `document.fonts.ready`, que resolve quando nada está pendente (medido:
      ~600ms, antes de qualquer layout ter acontecido) e por isso não serve
      como sinal.

      Nada aqui é obrigatório: se este bloco não rodar, o timeout do <head>
      revela sozinho.
    */}
    <script is:inline>
      (function () {
        var revelar = window.__royalRevelarPreloader;
        if (!revelar) return;
        if (!document.fonts || !document.fonts.load) return revelar();
        Promise.all([
          document.fonts.load('600 1em "Cormorant Garamond"'),
          document.fonts.load('400 1em "Space Grotesk"'),
        ]).then(revelar, revelar);
      })();
    </script>
  </body>
</html>
