---
// Persianas horizontais — revelação por scroll (ver CLAUDE.md).
// Substitui a passagem do Hero 1 para o Hero 2 na home.
// Técnica do tutorial de Hiroki Watanabe (Codrops, licença MIT),
// reimplementada sem GSAP.
//
// É MÁSCARA, não tiras coloridas por cima: um <mask> com um retângulo preto
// que esconde tudo e, sobre ele, retângulos brancos que revelam. Funciona
// sobre qualquer fundo, porque o que abre é a própria imagem.
//
// Cada persiana são DOIS retângulos que nascem com altura zero na mesma
// linha central e crescem em direções opostas — não é um retângulo
// encolhendo.
//
// SEGURANÇA: o atributo `mask` NÃO vem no HTML. Quem o aplica é o JS, e só
// depois de confirmar que vai poder animar. Sem JS, ou com
// prefers-reduced-motion, a <image> aparece inteira e nada fica escondido.
import { getImage } from 'astro:assets';

interface Props {
  imagem: ImageMetadata;
  alt: string;
}

const { imagem, alt } = Astro.props;

// 30 pares. O viewBox nasce com uma proporção 16:9 razoável só para o HTML
// não sair vazio — o valor real é escrito pelo JS a partir da janela, e
// recalculado no resize.
const PARES = 30;
const VB_INICIAL = 56.25;
const pares = Array.from({ length: PARES }, (_, i) => i);

// A imagem otimizada é resolvida aqui para poder entrar no href do <image>
// do SVG, que não aceita o componente <Image> do astro:assets diretamente.
const otimizada = await getImage({ src: imagem, format: 'webp', width: 1600 });
---

<section class="persianas" data-persianas>
  <div class="persianas__sticky">
    <svg
      class="persianas__svg"
      viewBox={`0 0 100 ${VB_INICIAL}`}
      preserveAspectRatio="none"
      data-persianas-svg
      role="img"
      aria-label={alt}
    >
      <defs>
        <mask id="persianas-mascara" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height={VB_INICIAL}>
          {/* Esconde tudo. Os retângulos brancos abaixo é que revelam. */}
          <rect x="0" y="0" width="100" height={VB_INICIAL} fill="black" data-persianas-fundo />
          {
            pares.map((i) => (
              <>
                <rect
                  class="persiana"
                  data-persiana
                  data-par={i}
                  data-lado="cima"
                  x="0"
                  width="100"
                  height="0"
                  fill="white"
                  shape-rendering="crispEdges"
                />
                <rect
                  class="persiana"
                  data-persiana
                  data-par={i}
                  data-lado="baixo"
                  x="0"
                  width="100"
                  height="0"
                  fill="white"
                  shape-rendering="crispEdges"
                />
              </>
            ))
          }
        </mask>
      </defs>

      {/* preserveAspectRatio "none" no <svg> (estica pra preencher a seção,
          que é o que faz o viewBox virtual funcionar) e "slice" na <image>
          (a foto mantém proporção e recorta, como object-fit: cover). */}
      <image
        data-persianas-imagem
        href={otimizada.src}
        x="0"
        y="0"
        width="100"
        height={VB_INICIAL}
        preserveAspectRatio="xMidYMid slice"
      />
    </svg>
  </div>
</section>

<style>
  /* O corredor de scroll. A altura é o que define quanto scroll a abertura
     consome; o painel dentro fica preso por sticky — CSS puro, sem pin em JS. */
  .persianas {
    position: relative;
    height: 180svh;
    background-color: var(--claro-bg);
  }

  .persianas__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .persianas__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Mobile e reduced-motion: sem corredor de scroll, a seção vira uma tela só. */
  @media (max-width: 56.25rem) {
    .persianas {
      height: 100svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .persianas {
      height: 100svh;
    }
  }

  /* Fade curto do mobile: o JS abre todas as persianas de uma vez e liga
     esta classe. No desktop a opacidade nunca é tocada. */
  .persianas__svg {
    opacity: 1;
  }

  .persianas[data-fade='preparado'] .persianas__svg {
    opacity: 0;
  }

  .persianas[data-fade='visivel'] .persianas__svg {
    opacity: 1;
    transition: opacity 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
</style>
