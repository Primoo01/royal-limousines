---
import site from '../config/site.js';
import MenuOverlay from './MenuOverlay.astro';
// Inline (?raw + set:html) e não <img>: só inlinada a logo enxerga o
// currentColor e acompanha a cor do mundo durante a passagem do hero.
import logoHorizontal from '../assets/logo/royal-horizontal.svg?raw';
---

<header class="header glass-real" data-header>
  <div class="header__conteudo u-container">
    <a href="/" class="header__marca" aria-label={site.nome}><span class="header__logo" set:html={logoHorizontal} /></a>

    <div class="header__acoes">
      <a
        href={site.contato.whatsapp.link}
        class="header__whatsapp"
        target="_blank"
        rel="noopener"
        aria-label={`${site.cta.whatsapp} no número ${site.contato.whatsapp.exibicao}`}
      >
        <svg viewBox="0 0 32 32" width="20" height="20" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.2.58 4.27 1.6 6.06L4 29l8.1-1.56a12 12 0 0 0 3.92.66c6.62 0 12.02-5.4 12.02-12.02C28.04 8.4 22.64 3 16.02 3Zm0 21.86c-1.9 0-3.68-.5-5.24-1.44l-.38-.22-4.8.93.94-4.68-.25-.4a9.83 9.83 0 0 1-1.5-5.03c0-5.43 4.42-9.85 9.85-9.85s9.85 4.42 9.85 9.85-4.42 9.84-9.85 9.84Zm5.4-7.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.63.07-.3-.15-1.24-.46-2.37-1.47-.87-.78-1.46-1.74-1.63-2.03-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.9-2.18-.24-.58-.48-.5-.66-.5h-.56c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.09 1.75-.71 2-1.4.24-.68.24-1.27.17-1.4-.07-.13-.27-.2-.56-.35Z"
          ></path>
        </svg>
      </a>

      <button
        type="button"
        class="header__menu-botao"
        id="botao-menu"
        aria-expanded="false"
        aria-controls="menu-overlay"
        aria-label="Abrir menu"
      >
        <span class="header__menu-icone" aria-hidden="true">
          <span class="header__menu-linha header__menu-linha--1"></span>
          <span class="header__menu-linha header__menu-linha--2"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<MenuOverlay />

<style>
  .header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-header);
    transform: translateY(0);
    transition: transform 0.35s ease;
  }

  .header[data-oculto='true'] {
    transform: translateY(-100%);
  }

  /* Com o menu aberto: o header fica travado em visível (a regra de
     esconder ao descer não se aplica) e o fundo glass vira transparente,
     na cor do mundo escuro — o overlay está por baixo dele no z-index (ver
     "Escala de z-index" no CLAUDE.md), mas visualmente parece contínuo
     porque o header deixa de parecer uma barra flutuando por cima. */
  body:has(#menu-overlay[data-aberto='true']) .header {
    --texto: var(--escuro-texto);
    --ouro: var(--ouro-escuro);
    background-color: transparent;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.35s ease;
  }

  body:has(#menu-overlay[data-aberto='true']) .header[data-oculto='true'] {
    transform: translateY(0);
  }

  /* Some junto com o resto do conteúdo do header (só logo e botão de menu
     continuam visíveis) — ajuste reversível, ver nota na resposta. */
  body:has(#menu-overlay[data-aberto='true']) .header__whatsapp {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .header {
      transition: none;
    }
  }

  .header__conteudo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espaco-3);
    min-height: var(--altura-header);
  }

  .header__marca {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--texto);
    opacity: 1;
    transition: opacity 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  /* :global porque o SVG entra por set:html — o escopo do Astro não alcança
     marcação que este arquivo não emite literalmente.
     A altura substitui a do texto que estava aqui (Cormorant 1.375rem); a
     largura sai sozinha do viewBox 405×114, então a logo nunca distorce. */
  .header__logo :global(svg) {
    display: block;
    height: 1.75rem;
    width: auto;
  }

  /* Nunca muda de peso — só uma leve queda de opacidade. */
  .header__marca:active,
  .header__marca:focus,
  .header__marca:visited {
    font-weight: 600;
  }

  .header__marca:active {
    opacity: 0.7;
  }

  .header__acoes {
    display: flex;
    align-items: center;
    gap: var(--espaco-3);
  }

  .header__whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Verde oficial do WhatsApp, igual ao botão flutuante (ver global.css). */
    color: var(--verde-whatsapp);
  }

  .header__menu-botao {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    padding: 0.5em 0.25em;
    color: var(--texto);
    cursor: pointer;
    /* Botão de menu único: continua clicável acima do overlay porque o
       header inteiro fica acima dele na escala de z-index (ver CLAUDE.md).
       Sem rótulo textual — só o ícone (ver CLAUDE.md > Botão de menu). */
  }

  /* Ícone de duas linhas paralelas → converge para um X. Só transform
     (translate + rotate), 350ms — nunca width/height. */
  .header__menu-icone {
    position: relative;
    display: inline-block;
    width: 1.875rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  .header__menu-linha {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--texto);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), background-color 0.25s ease;
  }

  .header__menu-linha--1 {
    top: 0;
  }

  .header__menu-linha--2 {
    bottom: 0;
  }

  .header__menu-botao[aria-expanded='true'] .header__menu-linha--1 {
    transform: translateY(4.5px) rotate(45deg);
  }

  .header__menu-botao[aria-expanded='true'] .header__menu-linha--2 {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  .header__menu-botao:hover .header__menu-linha,
  .header__menu-botao:focus-visible .header__menu-linha {
    background-color: var(--ouro);
  }

  @media (prefers-reduced-motion: reduce) {
    .header__menu-linha {
      transition: none;
    }
  }
</style>

<script>
  const botaoMenu = document.getElementById('botao-menu');
  const overlay = document.getElementById('menu-overlay');

  let ultimoFoco: HTMLElement | null = null;

  function seletorFocavel() {
    return 'a[href], button:not([disabled])';
  }

  // Mídia do painel esquerdo (ver CLAUDE.md > Navegação): troca em crossfade
  // no hover. São fotos, não vídeo (ver menu-midia.js), mas o carregamento sob
  // demanda ficou — e é obrigatório. O comentário que estava aqui dizia que o
  // `loading="lazy"` segurava o download até o painel entrar em cena: era
  // falso. O overlay é `position: fixed; inset: 0`, e o lazy loading do Chrome
  // decide pela posição de LAYOUT, não por opacity/visibility — as 6 fotos
  // baixavam sempre, 631 KB a 390px, com o menu fechado, disputando banda com
  // o LCP. Por isso elas nascem com data-src/data-srcset (MenuMidia.astro) e
  // são promovidas aqui, na primeira abertura.
  const camadasMidia = overlay ? Array.from(overlay.querySelectorAll<HTMLElement>('[data-midia-camada]')) : [];
  const gruposComMidia = overlay ? Array.from(overlay.querySelectorAll<HTMLElement>('[data-midia-grupo]')) : [];

  // Promove data-src/data-srcset → src/srcset. Roda uma vez só: o removeAttribute
  // marca o próprio elemento, então nem depende da flag pra ser idempotente.
  // A ORDEM IMPORTA: srcset primeiro, src depois. Ao contrário, o navegador
  // resolveria o `src` sozinho e baixaria o fallback de 1600px (367–709 KB)
  // antes de ver os candidatos de 640px.
  let midiaPromovida = false;

  function promoverMidia() {
    if (midiaPromovida || !overlay) return;
    midiaPromovida = true;
    overlay.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
      const src = img.getAttribute('data-src');
      const srcset = img.getAttribute('data-srcset');
      if (srcset) {
        img.setAttribute('srcset', srcset);
        img.removeAttribute('data-srcset');
      }
      if (src) {
        img.setAttribute('src', src);
        img.removeAttribute('data-src');
      }
    });
  }

  function ativarMidia(grupo: string) {
    camadasMidia.forEach((camada) => {
      camada.setAttribute('data-ativa', String(camada.getAttribute('data-midia-camada') === grupo));
    });
  }

  gruposComMidia.forEach((grupo) => {
    const chave = grupo.getAttribute('data-midia-grupo');
    if (!chave) return;
    grupo.addEventListener('mouseenter', () => ativarMidia(chave));
    grupo.addEventListener('focusin', () => ativarMidia(chave));
  });

  overlay?.querySelector('.menu-overlay__painel')?.addEventListener('mouseleave', () => ativarMidia('padrao'));

  // Acordeão de Serviços (ver CLAUDE.md > Acordeão de Serviços): "Serviços"
  // continua link normal; a seta ao lado é o único controle que abre/fecha
  // os subitens, sempre por clique (nunca hover). Fechado por padrão toda
  // vez que o menu abre — ver reset em fecharMenu().
  const botaoAcordeaoServicos = document.querySelector<HTMLButtonElement>('[data-acordeao-servicos]');
  const grupoServicos = botaoAcordeaoServicos?.closest<HTMLElement>('.menu-overlay__grupo') ?? null;

  function fecharAcordeaoServicos() {
    if (!botaoAcordeaoServicos || !grupoServicos) return;
    botaoAcordeaoServicos.setAttribute('aria-expanded', 'false');
    botaoAcordeaoServicos.setAttribute('aria-label', 'Mostrar serviços');
    grupoServicos.setAttribute('data-acordeao', 'false');
  }

  botaoAcordeaoServicos?.addEventListener('click', () => {
    if (!grupoServicos) return;
    const aberto = botaoAcordeaoServicos.getAttribute('aria-expanded') === 'true';
    botaoAcordeaoServicos.setAttribute('aria-expanded', String(!aberto));
    botaoAcordeaoServicos.setAttribute('aria-label', aberto ? 'Mostrar serviços' : 'Esconder serviços');
    grupoServicos.setAttribute('data-acordeao', String(!aberto));
  });

  // Única fonte de verdade do estado do overlay: o atributo data-aberto.
  // O CSS cuida de opacity/visibility/pointer-events a partir dele — nada
  // de alternar "hidden" pelo JS (era um segundo mecanismo concorrente,
  // e o motivo do bug de clique interceptado).
  function abrirMenu() {
    if (!overlay || !botaoMenu) return;
    // Antes de qualquer coisa: quanto mais cedo o fetch começa, menos o
    // crossfade do primeiro hover espera.
    promoverMidia();
    ultimoFoco = document.activeElement as HTMLElement;
    overlay.setAttribute('data-aberto', 'true');
    botaoMenu.setAttribute('aria-expanded', 'true');
    botaoMenu.setAttribute('aria-label', 'Fechar menu');
    document.body.style.overflow = 'hidden';
    const primeiroFocavel = overlay.querySelector<HTMLElement>(seletorFocavel());
    primeiroFocavel?.focus();
    document.addEventListener('keydown', aoTeclar);
  }

  function fecharMenu() {
    if (!overlay || !botaoMenu) return;
    overlay.setAttribute('data-aberto', 'false');
    botaoMenu.setAttribute('aria-expanded', 'false');
    botaoMenu.setAttribute('aria-label', 'Abrir menu');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', aoTeclar);
    ativarMidia('padrao');
    fecharAcordeaoServicos();
    (ultimoFoco ?? botaoMenu).focus();
  }

  function aoTeclar(evento: KeyboardEvent) {
    if (!overlay) return;

    if (evento.key === 'Escape') {
      evento.preventDefault();
      fecharMenu();
      return;
    }

    if (evento.key === 'Tab') {
      const focaveis = Array.from(overlay.querySelectorAll<HTMLElement>(seletorFocavel()));
      if (focaveis.length === 0) return;
      const primeiro = focaveis[0];
      const ultimo = focaveis[focaveis.length - 1];

      if (evento.shiftKey && document.activeElement === primeiro) {
        evento.preventDefault();
        ultimo.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        primeiro.focus();
      }
    }
  }

  botaoMenu?.addEventListener('click', () => {
    const aberto = botaoMenu.getAttribute('aria-expanded') === 'true';
    if (aberto) fecharMenu();
    else abrirMenu();
  });

  overlay?.addEventListener('click', (evento) => {
    if (evento.target === overlay) fecharMenu();
  });

  overlay?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', fecharMenu);
  });
</script>
