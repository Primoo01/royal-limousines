---
// Conteúdo da home (/). Título, meta description e h1 continuam intocados
// (são eles que ranqueiam). A prosa ao redor foi reescrita num tom mais
// sóbrio, inspirado na /lp-limousine/, mas toda frase com palavra-chave do
// backup original foi preservada — ver comparação de keywords no relatório
// da etapa. A seção "Segurança e confiança" é nova aqui: existia só na LP.
import { Image, getImage } from 'astro:assets';
import Foto from './Foto.astro';
import Carrossel from './Carrossel.astro';
import Video360 from './Video360.astro';
import { videos360 } from '../data/videos-360.js';
import { fotosLimo } from '../data/fotos-limo.js';
import { fotosSedan } from '../data/fotos-sedan.js';
import { fotosGaleriaLimo } from '../data/galeria-limo.js';
import silhuetaLimo from '../assets/fundos/300c-limo-silhueta-2.png';
// Arte de fundo da seção de abertura. Vem da pasta de origem na raiz e
// passa pelo astro:assets como qualquer outra imagem (WebP, redimensionada).
import silhuetaAbertura from '../assets/fundos/300c-limo-silhueta-3.png';
import CortinaDeLuz from './CortinaDeLuz.astro';
import Wordmark from './Wordmark.astro';
import Marquee from './Marquee.astro';
import Botao from './Botao.astro';
import EntradaTitulo from './EntradaTitulo.astro';
import site from '../config/site.js';

// ---------------------------------------------------------------------------
// SELETOR DE DOIS CARROS DO HERO 1
// ---------------------------------------------------------------------------
// Quatro imagens, não duas. Cada carro tem a CHEIA (o palco) e a FRESTA (a
// faixa clicável que mostra o outro carro).
//
// A fresta é uma DERIVADA RECORTADA na proporção da faixa — nunca a imagem
// cheia encolhida por CSS. `fit: 'cover'` + `width`/`height` no getImage faz o
// recorte no build (suportado pelo serviço sharp do Astro), então o arquivo
// que chega ao navegador já tem a forma da faixa e nenhum pixel viaja para ser
// descartado no `object-fit`.
//
// Os degraus são 1x e 2x da faixa REAL medida no CSS abaixo:
//   vertical  (desktop, ao lado do palco): 160 x 582 CSS px
//   horizontal (mobile, no pé do palco):   450 x  75 CSS px
//
// Por que o 2x da vertical para no que para: a foto do sedan tem 820x954, e
// 320x1164 pede 1.22x de ampliação. Numa faixa decorativa de 160px isso não é
// perceptível; ampliar mais seria. Ver a nota de resolução em fotos-sedan.js.
const FRESTA = {
  vertical: [
    { w: 160, h: 582 },
    { w: 320, h: 1164 },
  ],
  horizontal: [
    { w: 450, h: 75 },
    { w: 900, h: 150 },
  ],
};

// DEGRAU QUE A FONTE NÃO ALCANÇA É DESCARTADO, não encolhido.
//
// O serviço do Astro não amplia além do original, mas TAMBÉM não avisa: pedir
// 900x150 de uma foto com 820px de largura devolve um arquivo 820x150 — e o
// `attributes.width` do getImage continua dizendo 900, porque ele reflete o
// que foi PEDIDO. Escrever "900w" no srcset seria mentir para o navegador:
// num aparelho de 450 CSS px em DPR 2 ele escolheria esse candidato esperando
// 900px, receberia 820 e ampliaria de novo — exatamente o que a fresta existe
// para evitar.
//
// Pior: com a largura capada e a altura não, a proporção do arquivo muda
// (5.47 em vez de 6.00) e o `cover` passa a recortar num lugar que ninguém
// escolheu.
//
// Então o teste é nas DUAS dimensões, e o degrau que não couber sai fora. A
// consequência real: a foto do sedan (820x954) só sustenta o degrau 1x das
// duas frestas. É a limitação de resolução aceita pelo cliente aparecendo
// aqui — ver a nota em fotos-sedan.js.
async function recortarFresta(src, degraus) {
  const cabem = degraus.filter(({ w, h }) => w <= src.width && h <= src.height);
  const usados = cabem.length ? cabem : [degraus[0]];

  const gerados = await Promise.all(
    usados.map(({ w, h }) => getImage({ src, width: w, height: h, fit: 'cover', position: 'center', format: 'webp', quality: 72 }))
  );

  return {
    src: gerados[0].src,
    srcset: gerados.map((g, i) => `${g.src} ${usados[i].w}w`).join(', '),
    // Dimensões do 1x, para o `width`/`height` do <img>: elas só existem para
    // reservar a caixa e evitar CLS, e a caixa é a do CSS.
    largura: usados[0].w,
    altura: usados[0].h,
  };
}

const [frestaLimoV, frestaLimoH, frestaSedanV, frestaSedanH] = await Promise.all([
  recortarFresta(fotosLimo.casamentoNoivos.srcRetrato, FRESTA.vertical),
  recortarFresta(fotosLimo.casamentoNoivos.src, FRESTA.horizontal),
  recortarFresta(fotosSedan.heroGaragem.src, FRESTA.vertical),
  recortarFresta(fotosSedan.heroGaragem.src, FRESTA.horizontal),
]);

// A CHEIA DO SEDAN. Não usa <Foto> porque precisa nascer sem `src`: ela é a
// única imagem grande da página que NÃO deve competir com o LCP. Quem a
// promove é o script do fim deste arquivo, em requestIdleCallback DEPOIS do
// load — assim o clique na fresta já encontra a imagem em cache e parece
// instantâneo, sem ter disputado banda com o elemento LCP.
//
// Um só arquivo serve os dois layouts (decisão do cliente): 0.86 recorta bem
// tanto na caixa 1.30 do desktop quanto na 0.46 do mobile — conferido gerando
// os dois recortes e olhando. Por isso não há art direction aqui, ao
// contrário da limousine.
const sedanCheia = await getImage({
  src: fotosSedan.heroGaragem.src,
  widths: [480, 820],
  format: 'webp',
  quality: 82,
});

const passos = [
  {
    numero: '01',
    titulo: 'Atendimento especializado',
    texto: 'Equipe habituada a eventos sociais como casamentos, bodas, debutantes e jantares românticos.',
  },
  {
    numero: '02',
    titulo: 'Roteiro confirmado',
    texto: 'Data, horário, saída, destino, duração e passageiros são alinhados antes da contratação.',
  },
  {
    numero: '03',
    titulo: 'Contato acessível',
    texto: 'Atendimento por WhatsApp, telefone e e-mail para tirar dúvidas e consultar disponibilidade.',
  },
];
---

<!--
  Hero da home em dois estágios (ver CLAUDE.md > Hero da home).

  O wrapper carrega os valores do mundo ESCURO inline: é o mundo do
  Estágio 1, e também o fallback se o JS não rodar. Eles NÃO são
  interpolados — a passagem pro Estágio 2 é corte limpo por enquanto (a
  transição animada está descrita no CLAUDE.md, mas ainda não
  implementada). O que muda de cor por scroll é só a barra fixa do topo,
  também em corte limpo, porque ela mora fora deste wrapper.

  O Estágio 2 NUNCA depende dessas variáveis: tem sobrescrita própria pro
  mundo claro no CSS. Sem JS ele nunca fica escuro nem ilegível.
-->
<div
  class="hero-dinamico"
  data-hero-dinamico
  style="--bg:#141210;--surface:#211e18;--linha:#3a342a;--texto:#ede7db;--texto-mut:#8c857a;--ouro:#c6a25e;"
>
  <section class="hero-estagio1" data-hero-estagio1>
    <CortinaDeLuz />

    <div class="hero-estagio1__grade u-container">
      {/* Sem eyebrow: "Royal Limousines" já aparece no logo do header, logo
          acima. Repetir ali era redundância, não hierarquia. */}
      <div class="hero-estagio1__topo">
        <EntradaTitulo as="h1">Aluguel de Limousines para casamentos em SP</EntradaTitulo>
        {/*
          NÃO REPONHA um parágrafo de apoio aqui. Existia um, e ele abria
          repetindo a frase inteira do h1 acima ("Aluguel de Limousines para
          casamentos em SP. Luxo e sofisticação para momentos especiais, com a
          Royal Limousines.") — a mesma frase duas vezes, uma embaixo da outra,
          na primeira tela. Removido por decisão do cliente.

          A cobertura de palavra-chave não se perdeu: a frase segue no h1 logo
          acima e em seis meta tags desta página (title, description, og:title,
          og:description, twitter:title, twitter:description). O parágrafo era
          repetição visual, não cobertura adicional.

          O espaçamento até os botões vem do `margin-top` do próprio
          `.hero__cta`, então não sobrou vão órfão aqui.
        */}
        <div class="hero__cta">
          <Botao variante="primario" href="/contato/">{site.cta.orcamento}</Botao>
          <Botao variante="secundario" href={site.contato.whatsapp.link} target="_blank" rel="noopener">
            {site.cta.whatsapp}
          </Botao>
        </div>
        <p class="hero-estagio1__nota">{site.contato.areaAtendida}</p>
      </div>
    </div>

    {/* Fora do grid, sangrando a partir de ~55% da largura da tela até a
        mesma margem lateral do container (ver .hero-estagio1__midia). No
        mobile volta pro fluxo normal, como último item da coluna.

        SELETOR DE DOIS CARROS. `data-seletor-ativo` no wrapper é o ÚNICO
        estado: todo o resto (qual cheia aparece, qual fresta aparece, qual
        ação aparece, o rótulo do botão) é CSS reagindo a esse atributo. O JS
        só troca o valor entre "limo" e "sedan".

        SEM JS a página fica no estado inicial e completo: a limousine no
        palco, a fresta do sedan visível, e a ação da limousine com href real.
        O que não funciona é a troca — nada some, nada quebra. */}
    <div class="hero-estagio1__midia seletor" data-seletor data-seletor-ativo="limo">
      {/* PALCO — as duas imagens cheias, empilhadas. Só a ativa fica opaca. */}
      <div class="seletor__palco">
      <div class="seletor__cheia" data-cheia="limo">
      <Foto
        src={fotosLimo.casamentoNoivos.src}
        alt={fotosLimo.casamentoNoivos.alt}
        {/* Sem `aspectRatio`: aqui a proporção muda por breakpoint (4/5 no
            desktop, 8/5 no mobile) e é definida no CSS abaixo. Passar a
            prop escreveria style inline, que venceria a media query. */}
        {/* Teto de 1600px do CLAUDE.md, e é ele que manda aqui — NÃO é mais a
            largura nativa. O arquivo em src/assets/limo/ é uma redução do
            original de 3064x1376 (midias-originais/.../Casamento1-hd.png).
            Subir deste número serve imagem acima do teto do projeto e precisa
            de decisão explícita; descer joga fora nitidez que existe. */}
        larguraServida={1600}
        {/* Degrau intermediário de 1100: sem ele um desktop de ~1100 CSS px em
            DPR 2 pula direto pro arquivo de 1600 (275 KB) para exibir o que
            cabe em 1100 (142 KB). O celular não passa por aqui — abaixo de
            56.25rem quem serve é a retrato, com o srcset próprio dela. */}
        larguras={[480, 800, 1100, 1600]}
        {/* Abaixo de 56.25rem quem entra é a retrato, com `sizes` próprio —
            este vale só para o desktop agora, sem a cláusula de mobile.
            NÃO é a largura da caixa: é a largura que a imagem TERIA antes do
            recorte do `cover`, que é o que o navegador precisa baixar. Em
            1440px a caixa de 754 exibe 1371 de largura, ou 95vw. */}
        sizes="95vw"
        {/* A RETRATO DO CELULAR. Arquivo diferente, não outro tamanho: a tela
            do telefone é vertical e a paisagem 2.22 do desktop não serve.
            `media` idêntica ao breakpoint do CSS abaixo — se as duas
            divergirem, a imagem de uma tela aparece no layout da outra.
            `100vw`: a caixa é a largura da tela, e como o recorte do `cover`
            aqui é VERTICAL (a foto é mais estreita que a tela), a largura
            exibida é igual à da caixa — nada de multiplicar por causa do
            corte, ao contrário do desktop.
            Degraus até 720, a largura nativa. Não há original maior: em tela
            cheia de iPhone a DPR 3 o aparelho amplia ~1,6x. */}
        srcEstreito={fotosLimo.casamentoNoivos.srcRetrato}
        mediaEstreito="(max-width: 56.25rem)"
        largurasEstreito={[480, 720]}
        sizesEstreito="100vw"
        {/* Céu em gradiente e lataria branca fazem banding com compressão
            agressiva — 85 é o piso aceitável para esta foto. */}
        qualidade={85}
        comFallback
        prioridade
      />
      </div>

        {/* A CHEIA DO SEDAN nasce SEM src — ver a nota no frontmatter. É a
            única imagem grande da home que não pode competir com o LCP.
            `srcset` é promovido ANTES de `src`: na ordem inversa o navegador
            resolve o `src` sozinho e baixa o candidato de largura cheia antes
            de ver os degraus (regra do CLAUDE.md > Mídia pesada). */}
        <div class="seletor__cheia" data-cheia="sedan">
          <img
            data-src={sedanCheia.src}
            data-srcset={sedanCheia.srcSet.attribute}
            sizes="(max-width: 56.25rem) 100vw, 95vw"
            width={sedanCheia.attributes.width}
            height={sedanCheia.attributes.height}
            alt={fotosSedan.heroGaragem.alt}
            decoding="async"
          />
        </div>
      </div>

      {/* FRESTA — o controle de troca. É <button> porque troca estado na
          página; não é navegação. Mostra sempre o carro INATIVO, que é o que
          o clique vai trazer para o palco. */}
      {/* SEM aria-label, de propósito.
          Ele existia e dizia "Ver o Chrysler 300C preto no destaque", enquanto
          o texto VISÍVEL do botão era "Sedan 300C preto". `aria-label`
          SOBRESCREVE o conteúdo, então o nome acessível não continha o rótulo
          visível — é falha do WCAG 2.5.3 (Label in Name), e quebra comando de
          voz: quem diz "clicar em Sedan 300C preto" não acerta um botão cujo
          nome é outro.
          Sem ele, o nome acessível passa a ser o próprio rótulo, que já troca
          com o estado. As imagens dentro têm alt="" e aria-hidden, então não
          entram no cálculo do nome. */}
      <button class="seletor__fresta" type="button" data-seletor-troca>
        {/* Duas frestas por carro: a vertical serve o desktop e a horizontal
            o mobile. `media` idêntica ao breakpoint do CSS — se divergirem, a
            faixa de um layout aparece no outro. */}
        <span class="seletor__faixa" data-faixa="sedan">
          <picture>
            <source media="(max-width: 56.25rem)" srcset={frestaSedanH.srcset} sizes="100vw" />
            <img src={frestaSedanV.src} srcset={frestaSedanV.srcset} sizes="160px"
              width={frestaSedanV.largura} height={frestaSedanV.altura}
              alt="" aria-hidden="true" decoding="async" />
          </picture>
        </span>
        {/* A fresta da limousine só aparece DEPOIS da primeira troca, então
            nasce sem src como a cheia do sedan. São ~4 KB, mas o princípio é
            o mesmo: nada que não seja visto no primeiro paint disputa banda
            com o LCP. */}
        <span class="seletor__faixa" data-faixa="limo">
          <picture>
            <source media="(max-width: 56.25rem)" data-srcset={frestaLimoH.srcset} sizes="100vw" />
            <img data-src={frestaLimoV.src} data-srcset={frestaLimoV.srcset} sizes="160px"
              width={frestaLimoV.largura} height={frestaLimoV.altura}
              alt="" aria-hidden="true" decoding="async" />
          </picture>
        </span>
        <span class="seletor__rotulo" data-seletor-rotulo>Ver o Sedan 300C preto</span>
        {/* CONTADOR — dois pontos, o cheio é o carro que está no palco.
            `aria-hidden` porque é redundante: o rótulo já diz o que o clique
            faz, e o nome acessível do botão é o rótulo (WCAG 2.5.3). Ler
            "dois pontos" no leitor de tela só atrapalharia. */}
        <span class="seletor__contador" aria-hidden="true">
          <span class="seletor__ponto" data-ponto="limo"></span>
          <span class="seletor__ponto" data-ponto="sedan"></span>
        </span>
      </button>

      {/* AÇÕES — uma por carro, só a do ativo visível. Links reais, então
          funcionam sem JS. `#video-limusine` e `/limousines/#sedan` são os
          dois destinos; os dois alvos levam scroll-margin-top. */}
      <div class="seletor__acoes">
        <span class="seletor__acao" data-acao="limo">
          <Botao variante="terciario" href="#video-limusine">A limousine em detalhe</Botao>
        </span>
        <span class="seletor__acao" data-acao="sedan">
          <Botao variante="terciario" href="/limousines/#sedan">Chrysler 300C Sedan em detalhe</Botao>
        </span>
      </div>
    </div>

    {/* Marquee fora do grid, como irmão: no desktop é uma linha reservada da
        seção (nada entra nela), e no mobile é o último item da coluna. */}
    <div class="hero-estagio1__marquee">
      <Marquee tamanho="grande" />
    </div>
  </section>

  {/*
    TRANSIÇÃO HERO 1 → HERO 2 (ver CLAUDE.md > Transição Hero 1 → Hero 2).

    O trilho tem 250vh (160svh no mobile) e o painel dentro fica preso por
    `position: sticky` — CSS puro, sem pin em JavaScript. O painel É o
    Hero 2: ele entra pela direita cobrindo a tela e, dentro dele, a
    assinatura se monta em cinco fases conduzidas pelo scroll.

    TUDO AQUI É HTML COMUM. Nenhum conteúdo de texto ou layout mora dentro
    de <svg> — foi exatamente isso que apagou o hero na tentativa das
    persianas: o navegador descarta silenciosamente HTML dentro de <svg>.
    O único SVG é o do logo, que entra por set:html no Wordmark e não
    carrega layout nenhum.
  */}
  <section class="transicao-hero" data-transicao-hero>
    <div class="transicao-hero__sticky">
      <div class="transicao-hero__painel" data-transicao-painel>
        <div class="transicao-hero__miolo">
          {/*
            BLOCO SUPERIOR. Largura total, e é ele o referencial da silhueta:
            como o logo é o único filho no fluxo, a altura deste bloco é a
            altura do logo — então a silhueta, centrada em 50% daqui, cai
            exatamente no mesmo eixo horizontal do logo. A silhueta fica fora
            do u-container de propósito, para poder sangrar pela borda da
            TELA; o logo, dentro, para alinhar com a margem de conteúdo.
          */}
          <div class="transicao-hero__topo">
            <Image
              class="silhueta-fundo silhueta-fundo--claro transicao-hero__silhueta"
              data-transicao-silhueta
              src={silhuetaLimo}
              alt=""
              aria-hidden="true"
              widths={[700, 1400]}
              sizes="50vw"
              format="webp"
              loading="lazy"
            />
            {/* O logo aparece por transparência, no lugar onde já está — por
                isso o wrapper carrega só opacity, sem deslocamento. */}
            <div class="transicao-hero__logo u-container" data-transicao-logo>
              <Wordmark />
            </div>
          </div>

          {/*
            BLOCO INFERIOR. Empilhado e centrado na largura TOTAL da página,
            não na do logo.

            A ORDEM DO DOM É A ORDEM DE ENTRADA — e agora ela coincide com a
            ordem visual: os valores entram antes (fase 4) e ficam em cima, a
            procedência entra por último (fase 5) e fica embaixo. Por isso o
            `order` que invertia as duas no CSS deixou de existir.
          */}
          <div class="transicao-hero__assinatura">
            <p class="hero-estagio2__valores" data-transicao-valores>
              <span>Pontualidade</span><span aria-hidden="true"> · </span><span>Discrição</span><span aria-hidden="true"> · </span><span
                >Elegância</span
              >
            </p>
            <p class="hero-estagio2__tagline" data-transicao-tagline>Desde 2008 · São Paulo</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<!--
  Os parágrafos de conteúdo que estavam dentro do hero. Foram MOVIDOS pra
  cá, palavra por palavra — é este texto que carrega as palavras-chave da
  home, e nenhuma delas pode sair da página.
-->
<section class="secao-abertura u-container reveal">
  {/* Silhueta de fundo própria desta seção — arte diferente da do Hero 2 e
      bem mais apagada (25% contra 50%), porque aqui ela fica ATRÁS do
      texto, não ao lado dele. Decorativa: aria-hidden e sem ponteiro. */}
  <Image
    class="secao-abertura__fundo"
    src={silhuetaAbertura}
    alt=""
    aria-hidden="true"
    widths={[900, 1600]}
    {/* Acima de 34rem a arte é exibida em exatamente 100vw — largura da
        caixa e largura exibida coincidem, porque não há mais recorte.
        Abaixo de 34rem ainda há `cover`, e aí a largura exibida é maior que
        a caixa: 19rem de altura x 3,3755 = 1026px de arte num viewport de
        390 = 263vw. Anunciar 100vw ali faria o navegador pedir arquivo
        pequeno demais para o carro ampliado. */}
    sizes="(max-width: 34rem) 265vw, 100vw"
    format="webp"
    loading="lazy"
  />
  <div class="u-prosa secao-abertura__texto">
    <p>
      Desde 2008, oferecemos aluguel de limousines em São Paulo para
      casamentos, aniversários, eventos e jantares, com translados conduzidos
      por chofferes qualificados.
    </p>
    <p>
      Somos especializados em eventos sociais, com foco em casamentos, bodas,
      jantares românticos e festas debutantes.
    </p>
    <p>
      Atendemos pessoas que valorizam um ambiente familiar e elegante, ao
      lado de amigos e parentes, em momentos que merecem ser lembrados.
    </p>
  </div>
</section>

<section class="secao-frota u-container reveal">
  <div class="secao-frota__texto">
    <EntradaTitulo as="h2">Limousine para Casamentos em SP</EntradaTitulo>
    <p class="secao-frota__lead">Sofisticação, elegância e conforto.</p>
    <p>
      Procurando por aluguel de limousines para casamentos? Ligue para a Royal
      Limousines e solicite um orçamento. Atendemos todo o estado de SP.
    </p>
    <p>Modelo clássico, idealizado para os momentos especiais da sua vida.</p>
    <p>
      Com seus 8 metros de extensão e capacidade para 8 passageiros, foi
      projetada com base no contraste entre o clássico e o elegante.
    </p>
    <p>Feita para causar uma boa impressão.</p>
    <Botao variante="terciario" href="/limousines/">Conhecer a frota</Botao>
  </div>
  <Foto
    src={fotosLimo.tresQuartosFrontal.src}
    alt={fotosLimo.tresQuartosFrontal.alt}
    posicao={fotosLimo.tresQuartosFrontal.posicao}
    aspectRatio="4/3"
    class="reveal"
  />
</section>

<Marquee />

<section class="secao-passos u-container reveal">
  <p class="u-eyebrow">Segurança e confiança</p>
  <EntradaTitulo as="h2">Uma contratação com informações claras desde o primeiro contato.</EntradaTitulo>
