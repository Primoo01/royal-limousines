---
// Conteúdo da home (/). Título, meta description e h1 continuam intocados
// (são eles que ranqueiam). A prosa ao redor foi reescrita num tom mais
// sóbrio, inspirado na /lp-limousine/, mas toda frase com palavra-chave do
// backup original foi preservada — ver comparação de keywords no relatório
// da etapa. A seção "Segurança e confiança" é nova aqui: existia só na LP.
import { Image } from 'astro:assets';
import Foto from './Foto.astro';
import Carrossel from './Carrossel.astro';
import Video360 from './Video360.astro';
import { videos360 } from '../data/videos-360.js';
import { fotosLimo } from '../data/fotos-limo.js';
import { fotosGaleriaLimo } from '../data/galeria-limo.js';
import silhuetaLimo from '../assets/fundos/300c-limo-silhueta-2.png';
// Arte de fundo da seção de abertura. Vem da pasta de origem na raiz e
// passa pelo astro:assets como qualquer outra imagem (WebP, redimensionada).
import silhuetaAbertura from '../../Images/backgrounds/300c-limo-silhueta-3.png';
import CortinaDeLuz from './CortinaDeLuz.astro';
import Wordmark from './Wordmark.astro';
import Marquee from './Marquee.astro';
import Botao from './Botao.astro';
import EntradaTitulo from './EntradaTitulo.astro';
import site from '../config/site.js';

const passos = [
  {
    numero: '01',
    titulo: 'Atendimento especializado',
    texto: 'Equipe habituada a eventos sociais como casamentos, bodas, debutantes e jantares românticos.',
  },
  {
    numero: '02',
    titulo: 'Roteiro confirmado',
    texto: 'Data, horário, saída, destino, duração e passageiros são alinhados antes da contratação.',
  },
  {
    numero: '03',
    titulo: 'Contato acessível',
    texto: 'Atendimento por WhatsApp, telefone e e-mail para tirar dúvidas e consultar disponibilidade.',
  },
];
---

<!--
  Hero da home em dois estágios (ver CLAUDE.md > Hero da home).

  O wrapper carrega os valores do mundo ESCURO inline: é o mundo do
  Estágio 1, e também o fallback se o JS não rodar. Eles NÃO são
  interpolados — a passagem pro Estágio 2 é corte limpo por enquanto (a
  transição animada está descrita no CLAUDE.md, mas ainda não
  implementada). O que muda de cor por scroll é só a barra fixa do topo,
  também em corte limpo, porque ela mora fora deste wrapper.

  O Estágio 2 NUNCA depende dessas variáveis: tem sobrescrita própria pro
  mundo claro no CSS. Sem JS ele nunca fica escuro nem ilegível.
-->
<div
  class="hero-dinamico"
  data-hero-dinamico
  style="--bg:#141210;--surface:#211e18;--linha:#3a342a;--texto:#ede7db;--texto-mut:#8c857a;--ouro:#c6a25e;"
>
  <section class="hero-estagio1" data-hero-estagio1>
    <CortinaDeLuz />

    <div class="hero-estagio1__grade u-container">
      {/* Sem eyebrow: "Royal Limousines" já aparece no logo do header, logo
          acima. Repetir ali era redundância, não hierarquia. */}
      <div class="hero-estagio1__topo">
        <EntradaTitulo as="h1">Aluguel de Limousines para casamentos em SP</EntradaTitulo>
        {/*
          Parágrafo curto do hero (máximo duas linhas, conforme o CLAUDE.md).
          É o parágrafo de abertura que já existia aqui — os três parágrafos
          de conteúdo desceram inteiros para a seção logo abaixo.
        */}
        <p class="hero-estagio1__lead">
          Aluguel de Limousines para casamentos em SP. Luxo e sofisticação
          para momentos especiais, com a Royal Limousines.
        </p>
        <div class="hero__cta">
          <Botao variante="primario" href="/contato/">{site.cta.orcamento}</Botao>
          <Botao variante="secundario" href={site.contato.whatsapp.link} target="_blank" rel="noopener">
            {site.cta.whatsapp}
          </Botao>
        </div>
        <p class="hero-estagio1__nota">{site.contato.areaAtendida}</p>
      </div>
    </div>

    {/* Fora do grid, sangrando a partir de ~55% da largura da tela até a
        mesma margem lateral do container (ver .hero-estagio1__midia). No
        mobile volta pro fluxo normal, como último item da coluna. */}
    <div class="hero-estagio1__midia">
      <Foto
        src={fotosLimo.tresQuartosFrontalDark.src}
        alt={fotosLimo.tresQuartosFrontalDark.alt}
        posicao={fotosLimo.tresQuartosFrontalDark.posicao}
        aspectRatio="4/5"
        larguraServida={900}
        sizes="(max-width: 56.25rem) 100vw, 45vw"
        prioridade
      />
    </div>

    {/* Marquee fora do grid, como irmão: no desktop é uma linha reservada da
        seção (nada entra nela), e no mobile é o último item da coluna. */}
    <div class="hero-estagio1__marquee">
      <Marquee tamanho="grande" />
    </div>
  </section>

  {/*
    TRANSIÇÃO HERO 1 → HERO 2 (ver CLAUDE.md > Transição Hero 1 → Hero 2).

    O trilho tem 250vh (160svh no mobile) e o painel dentro fica preso por
    `position: sticky` — CSS puro, sem pin em JavaScript. O painel É o
    Hero 2: ele entra pela direita cobrindo a tela e, dentro dele, a
    assinatura se monta em cinco fases conduzidas pelo scroll.

    TUDO AQUI É HTML COMUM. Nenhum conteúdo de texto ou layout mora dentro
    de <svg> — foi exatamente isso que apagou o hero na tentativa das
    persianas: o navegador descarta silenciosamente HTML dentro de <svg>.
    O único SVG é o do logo, que entra por set:html no Wordmark e não
    carrega layout nenhum.
  */}
  <section class="transicao-hero" data-transicao-hero>
    <div class="transicao-hero__sticky">
      <div class="transicao-hero__painel" data-transicao-painel>
        <Image
          class="silhueta-fundo silhueta-fundo--claro transicao-hero__silhueta"
          data-transicao-silhueta
          src={silhuetaLimo}
          alt=""
          aria-hidden="true"
          widths={[700, 1400]}
          sizes="50vw"
          format="webp"
          loading="lazy"
        />
        <div class="transicao-hero__miolo u-container">
          {/* O logo aparece por transparência, no lugar onde já está — por
              isso o wrapper carrega só opacity, sem deslocamento. */}
          <div class="transicao-hero__logo" data-transicao-logo>
            <Wordmark />
          </div>
          {/* Os dois textos são IRMÃOS numa linha só, logo abaixo do logo:
              a procedência sob a coroa, os valores sob a palavra ROYAL.
              A ordem no DOM é a ordem de entrada (fase 4 e depois 5). */}
          <div class="transicao-hero__assinatura">
            <p class="hero-estagio2__tagline" data-transicao-tagline>Desde 2008 · São Paulo</p>
            <p class="hero-estagio2__valores" data-transicao-valores>
              <span>Pontualidade</span><span aria-hidden="true"> · </span><span>Discrição</span><span aria-hidden="true"> · </span><span
                >Elegância</span
              >
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<!--
  Os parágrafos de conteúdo que estavam dentro do hero. Foram MOVIDOS pra
  cá, palavra por palavra — é este texto que carrega as palavras-chave da
  home, e nenhuma delas pode sair da página.
-->
<section class="secao-abertura u-container reveal">
  {/* Silhueta de fundo própria desta seção — arte diferente da do Hero 2 e
      bem mais apagada (25% contra 50%), porque aqui ela fica ATRÁS do
      texto, não ao lado dele. Decorativa: aria-hidden e sem ponteiro. */}
  <Image
    class="secao-abertura__fundo"
    src={silhuetaAbertura}
    alt=""
    aria-hidden="true"
    widths={[900, 1600]}
    sizes="(max-width: 56.25rem) 120vw, 90vw"
    format="webp"
    loading="lazy"
  />
  <div class="u-prosa secao-abertura__texto">
    <p>
      Desde 2008, oferecemos aluguel de limousines em São Paulo para
      casamentos, aniversários, eventos e jantares, com translados conduzidos
      por chofferes qualificados.
    </p>
    <p>
      Somos especializados em eventos sociais, com foco em casamentos, bodas,
      jantares românticos e festas debutantes.
    </p>
    <p>
      Atendemos pessoas que valorizam um ambiente familiar e elegante, ao
      lado de amigos e parentes, em momentos que merecem ser lembrados.
    </p>
  </div>
</section>

<section class="secao-frota u-container reveal">
  <div class="secao-frota__texto">
    <EntradaTitulo as="h2">Limousine para Casamentos em SP</EntradaTitulo>
    <p class="secao-frota__lead">Sofisticação, elegância e conforto.</p>
    <p>
      Procurando por aluguel de limousines para casamentos? Ligue para a Royal
      Limousines e solicite um orçamento. Atendemos todo o estado de SP.
    </p>
    <p>Modelo clássico, idealizado para os momentos especiais da sua vida.</p>
    <p>
      Com seus 8 metros de extensão e capacidade para 8 passageiros, foi
      projetada com base no contraste entre o clássico e o elegante.
    </p>
    <p>Feita para causar uma boa impressão.</p>
    <Botao variante="terciario" href="/limousines/">Conhecer a frota</Botao>
  </div>
  <Foto
    src={fotosLimo.tresQuartosFrontal.src}
    alt={fotosLimo.tresQuartosFrontal.alt}
    posicao={fotosLimo.tresQuartosFrontal.posicao}
    aspectRatio="4/3"
    class="reveal"
  />
</section>

<Marquee />

<section class="secao-passos u-container reveal">
  <p class="u-eyebrow">Segurança e confiança</p>
  <EntradaTitulo as="h2">Uma contratação com informações claras desde o primeiro contato.</EntradaTitulo>
  <p class="u-prosa secao-passos__intro">
    A proposta é feita com base nas informações do evento. Isso evita
    dúvidas, organiza o roteiro e melhora a previsibilidade do atendimento.
  </p>

  <ol class="secao-passos__lista reveal-grupo">
    {
      passos.map((passo) => (
        <li>
          <span class="secao-passos__numero">{passo.numero}</span>
          <div>
            <h3>{passo.titulo}</h3>
            <p>{passo.texto}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<section class="secao-galeria reveal">
  <div class="u-container">
    <p class="u-eyebrow">Fotos</p>
    <EntradaTitulo as="h2">A limousine em detalhe</EntradaTitulo>
  </div>
  {/* Sangria total, então fora do u-container — vale pro vídeo e pro
      carrossel. O vídeo vem primeiro: é a volta em torno do carro, e o
      carrossel logo abaixo mostra os detalhes. */}
  <div class="secao-galeria__video">
    <Video360
      src={videos360.limo.src}
      poster={videos360.limo.poster}
      largura={videos360.limo.largura}
      altura={videos360.limo.altura}
      alt={videos360.limo.alt}
    />
  </div>
  <div class="secao-galeria__carrossel">
    <Carrossel fotos={fotosGaleriaLimo} />
  </div>
</section>

<section class="secao-contato u-container reveal">
  <p class="u-eyebrow">Contato</p>
  <EntradaTitulo as="h2">Faça um orçamento hoje mesmo</EntradaTitulo>
  <div class="secao-contato__dados">
    <p><a href={site.contato.telefone.link}>{site.contato.telefone.exibicao}</a></p>
    <p><a href={`mailto:${site.contato.email}`}>{site.contato.email}</a></p>
  </div>
  <div class="hero__cta">
    <Botao variante="primario" href="/contato/">{site.cta.orcamento}</Botao>
    <Botao variante="secundario" href={site.contato.whatsapp.link} target="_blank" rel="noopener">
      {site.cta.whatsapp}
    </Botao>
  </div>
</section>

<style>
  /* ---- Hero em dois estágios ---------------------------------------- */

  /* É este wrapper que pinta fundo e texto com as variáveis que o JS
     interpola durante a passagem. */
  .hero-dinamico {
    background-color: var(--bg);
    color: var(--texto);
  }

  .hero-estagio1 {
    position: relative;
    min-height: 100svh;
    padding-top: var(--altura-header);
    /* Folga na base pro chevron (fixo na viewport) ficar ABAIXO da faixa do
       marquee em vez de dentro dela. Reduzida de --espaco-6 pra --espaco-5:
       a seção é min-height (cresce com o conteúdo, nunca corta), então essa
       folga é o que sobra entre o fim da faixa e a borda de baixo quando a
       soma passa de 100svh. Ver a conta em Marquee.astro > .marquee--grande. */
    padding-bottom: var(--espaco-5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .hero-estagio1__grade {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'topo  .'
      '.     .';
    gap: var(--espaco-3) var(--espaco-4);
    align-items: start;
    /* Ocupa o que sobra acima da faixa do marquee. */
    flex: 1;
    min-height: 0;
  }

  .hero-estagio1__topo {
    grid-area: topo;
    align-self: center;
  }

  .hero-estagio1__topo h1 {
    margin-top: var(--espaco-2);
  }

  .hero-estagio1__lead {
    margin-top: var(--espaco-3);
    max-width: 40ch;
    color: var(--texto);
  }

  /* Fora do grid — sangra a partir da largura da TELA (não do container),
     por isso é posicionada em relação à seção inteira, não à coluna.
     Esquerda: ~55vw. Direita: a mesma margem lateral que o container usa
     à esquerda (largura-container centralizada + padding-inline), pra
     terminar exatamente onde o texto termina do outro lado. */
  .hero-estagio1__midia {
    position: absolute;
    z-index: 1;
    top: var(--altura-header);
    left: 55%;
    right: calc((100% - min(100%, var(--largura-container))) / 2 + var(--espaco-3));
    /* Base: alinhada com o topo do bloco de texto, termina acima da faixa
       do marquee. A conta espelha a altura do Marquee (tamanho grande) +
       sua margin-top + o padding-bottom da seção — ver Marquee.astro. */
    bottom: calc(var(--espaco-5) + 40px + clamp(6rem, calc(100svh - 620px), 30svh));
  }

  /* A <img> do Foto já é width:100% + object-fit:cover; aqui só precisamos
     que ela preencha a ALTURA definida por este box (top+bottom acima) em
     vez da altura vinda do aspect-ratio do componente. Com width e height
     definidos (não-auto), o aspect-ratio inline do Foto passa a ser
     ignorado — não precisa de !important. */
  .hero-estagio1__midia :global(.foto) {
    height: 100%;
  }

  /* Faixa inferior do hero: linha própria da seção, no fluxo. Como é o
     último item do flex e o grid acima ocupa o resto, nada consegue entrar
     aqui — a folga de 40px é a margem, não uma coincidência de posição. */
  .hero-estagio1__marquee {
    flex: none;
    margin-top: 40px;
    width: 50vw;
    z-index: 2;
    pointer-events: none;
  }

  /* Dentro do bloco de texto, logo abaixo dos botões — alinhada à esquerda
     junto com o h1 e o parágrafo, sem posicionamento próprio. */
  .hero-estagio1__nota {
    margin-top: var(--espaco-4);
    font-family: var(--fonte-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-mut);
  }

  /* ---- Transição Hero 1 → Hero 2 -------------------------------------
     (ver CLAUDE.md > Transição Hero 1 → Hero 2)

     O TRILHO. A altura é o que define quanto scroll a sequência consome.
     O fundo é o mundo ESCURO: é ele que aparece atrás do painel enquanto
     o painel ainda não cobriu a tela, dando continuidade ao Hero 1. */
  .transicao-hero {
    position: relative;
    height: 250vh;
    background-color: var(--escuro-bg);
  }

  /* O "prender na tela" é CSS puro — nunca pin em JavaScript.
     O overflow: hidden mora AQUI, no próprio elemento sticky, e não em
     nenhum ancestral: a restrição do sticky é sobre ancestrais, e um
     ancestral com overflow o mataria silenciosamente. É este overflow que
     impede o painel (que parte de translateX(100%)) de gerar barra de
     rolagem horizontal. */
  .transicao-hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  /* O PAINEL — é o Hero 2. Mundo claro SEMPRE, sem depender das variáveis
     que o JS interpola: se o JS não rodar, ele nunca fica escuro.

     O transform mora aqui, no painel, e em nenhum dos pais: transform em
     ancestral quebra position: sticky no iOS Safari. */
  .transicao-hero__painel {
    --bg: var(--claro-bg);
    --surface: var(--claro-surface);
    --linha: var(--claro-linha);
    --texto: var(--claro-texto);
    --texto-mut: var(--claro-texto-mut);
    --ouro: var(--ouro-claro);
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--claro-bg);
    color: var(--claro-texto);
  }

  .transicao-hero__miolo {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Composição da silhueta durante a fase 2. O deslocamento entra por
     variável pra somar ao translateY(-50%) que a regra global já aplica —
     escrever `transform` cru aqui apagaria a centralização vertical. */
  .transicao-hero__silhueta {
    transform: translate(var(--silhueta-x, 0%), -50%);
  }

  /* Os dois textos da assinatura, lado a lado sob o logo.
     A coluna é medida do PRÓPRIO SVG do logo (viewBox 0 0 405 114): a
     coroa ocupa 0→170 e a palavra ROYAL começa em 186. 186/405 = 45.93%.
     Por isso a primeira coluna tem exatamente essa largura — a tagline
     alinha com a borda esquerda da coroa (que é a borda do logo) e os
     valores começam alinhados com o R de ROYAL.
     A largura do grid repete a do logo (ver Wordmark.astro) pra que as
     duas réguas sejam a mesma. */
  .transicao-hero__assinatura {
    /* Largura do logo, repetida de Wordmark.astro. */
    --logo-largura: min(100%, 40rem);
    /* 186/405 do viewBox = onde o R de ROYAL começa. */
    --logo-royal: 0.4593;
    margin-top: var(--espaco-3);
    display: grid;
    /* A primeira coluna é medida sobre a largura do LOGO (é o que alinha
       com o ROYAL). A segunda ocupa o resto do CONTAINER, não o resto do
       logo: em 40rem sobravam 346px e os valores quebravam em duas linhas,
       o que jogava a segunda linha abaixo da linha de base comum. */
    grid-template-columns: calc(var(--logo-largura) * var(--logo-royal)) 1fr;
    align-items: baseline;
    column-gap: 0;
  }

  /* Uma linha só: a quebra é justamente o que desalinhava a base. */
  .transicao-hero__assinatura > * {
    white-space: nowrap;
  }

  .hero-estagio2__tagline {
    margin: 0;
    font-family: var(--fonte-sans);
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ouro-claro);
  }

  /* As três palavras. Entram por último, depois da assinatura. */
  .hero-estagio2__valores {
    margin: 0;
    font-family: var(--fonte-serif);
    font-size: clamp(1.125rem, 0.9rem + 0.9vw, 1.75rem);
    letter-spacing: 0.02em;
    color: var(--claro-texto);
  }

  .hero-estagio2__valores span[aria-hidden='true'] {
    color: var(--ouro-claro);
  }

  /* REGRA DE SEGURANÇA (CLAUDE.md): o estado escrito no CSS é o estado
     FINAL — tudo visível, no lugar. Quem prepara os estados iniciais é o
     JS, e só depois de confirmar que vai poder animar. Se o JS falhar,
     nada some.

     Mobile: svh e nunca vh. 100vh no celular vale a viewport SEM a barra
     do navegador; quando ela aparece a altura muda e a composição pula.
     E a distância cai de 250vh pra 160svh, porque um gesto de toque
     percorre muito mais scroll que uma rolagem de mouse. */
  @media (max-width: 56.25rem) {
    .transicao-hero {
      height: 160svh;
    }

    .transicao-hero__sticky {
      height: 100svh;
    }

    /* Composição própria: empilhada e centralizada, com a silhueta de
       fundo ATRÁS do conteúdo em vez de coluna ao lado. */
    .transicao-hero__miolo {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    /* Lado a lado não cabe em 390px: vira coluna centralizada. O
       alinhamento com a coroa e com o ROYAL só faz sentido no desktop,
       onde o logo é largo. */
    .transicao-hero__assinatura {
      grid-template-columns: 1fr;
      row-gap: var(--espaco-2);
      justify-items: center;
    }

    /* Em 390px os valores não cabem numa linha só; aqui podem quebrar,
       porque empilhados não existe linha de base compartilhada. */
    .transicao-hero__assinatura > * {
      white-space: normal;
    }

    /* A regra global esconde a silhueta abaixo de 900px por contraste.
       Aqui ela volta como fundo, mas com opacidade bem menor pra não
       comprometer a leitura do texto por cima. */
    .transicao-hero__silhueta {
      display: block;
      left: 50%;
      width: min(150%, 34rem);
      opacity: 0.15;
      transform: translate(calc(-50% + var(--silhueta-x, 0%)), -50%);
    }
  }

  /* Sem sequência: tudo no estado final e sem trilho de scroll morto. */
  @media (prefers-reduced-motion: reduce) {
    .transicao-hero {
      height: auto;
    }

    .transicao-hero__sticky {
      position: static;
      height: auto;
      min-height: 100svh;
    }
  }

  /* O position: relative e o overflow existem por causa da silhueta de
     fundo, que é absoluta e sangra além da caixa. O padding vertical é o
     mesmo de antes: a seção não muda de posição na página. */
  .secao-abertura {
    position: relative;
    overflow: hidden;
    padding-block: var(--espaco-6);
  }

  /* Atrás do texto, centralizada, e bem mais apagada que a silhueta do
     Hero 2 (25% contra 50%) justamente porque aqui há texto por cima. */
  .secao-abertura__fundo {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
