---
// Conteúdo da home (/). Título, meta description e h1 continuam intocados
// (são eles que ranqueiam). A prosa ao redor foi reescrita num tom mais
// sóbrio, inspirado na /lp-limousine/, mas toda frase com palavra-chave do
// backup original foi preservada — ver comparação de keywords no relatório
// da etapa. A seção "Segurança e confiança" é nova aqui: existia só na LP.
import { Image } from 'astro:assets';
import Foto from './Foto.astro';
import Carrossel from './Carrossel.astro';
import Video360 from './Video360.astro';
import { videos360 } from '../data/videos-360.js';
import { fotosLimo } from '../data/fotos-limo.js';
import { fotosGaleriaLimo } from '../data/galeria-limo.js';
import silhuetaLimo from '../assets/fundos/300c-limo-silhueta-2.png';
// Arte de fundo da seção de abertura. Vem da pasta de origem na raiz e
// passa pelo astro:assets como qualquer outra imagem (WebP, redimensionada).
import silhuetaAbertura from '../assets/fundos/300c-limo-silhueta-3.png';
import CortinaDeLuz from './CortinaDeLuz.astro';
import Wordmark from './Wordmark.astro';
import Marquee from './Marquee.astro';
import Botao from './Botao.astro';
import EntradaTitulo from './EntradaTitulo.astro';
import site from '../config/site.js';

const passos = [
  {
    numero: '01',
    titulo: 'Atendimento especializado',
    texto: 'Equipe habituada a eventos sociais como casamentos, bodas, debutantes e jantares românticos.',
  },
  {
    numero: '02',
    titulo: 'Roteiro confirmado',
    texto: 'Data, horário, saída, destino, duração e passageiros são alinhados antes da contratação.',
  },
  {
    numero: '03',
    titulo: 'Contato acessível',
    texto: 'Atendimento por WhatsApp, telefone e e-mail para tirar dúvidas e consultar disponibilidade.',
  },
];
---

<!--
  Hero da home em dois estágios (ver CLAUDE.md > Hero da home).

  O wrapper carrega os valores do mundo ESCURO inline: é o mundo do
  Estágio 1, e também o fallback se o JS não rodar. Eles NÃO são
  interpolados — a passagem pro Estágio 2 é corte limpo por enquanto (a
  transição animada está descrita no CLAUDE.md, mas ainda não
  implementada). O que muda de cor por scroll é só a barra fixa do topo,
  também em corte limpo, porque ela mora fora deste wrapper.

  O Estágio 2 NUNCA depende dessas variáveis: tem sobrescrita própria pro
  mundo claro no CSS. Sem JS ele nunca fica escuro nem ilegível.
-->
<div
  class="hero-dinamico"
  data-hero-dinamico
  style="--bg:#141210;--surface:#211e18;--linha:#3a342a;--texto:#ede7db;--texto-mut:#8c857a;--ouro:#c6a25e;"
>
  <section class="hero-estagio1" data-hero-estagio1>
    <CortinaDeLuz />

    <div class="hero-estagio1__grade u-container">
      {/* Sem eyebrow: "Royal Limousines" já aparece no logo do header, logo
          acima. Repetir ali era redundância, não hierarquia. */}
      <div class="hero-estagio1__topo">
        <EntradaTitulo as="h1">Aluguel de Limousines para casamentos em SP</EntradaTitulo>
        {/*
          Parágrafo curto do hero (máximo duas linhas, conforme o CLAUDE.md).
          É o parágrafo de abertura que já existia aqui — os três parágrafos
          de conteúdo desceram inteiros para a seção logo abaixo.
        */}
        <p class="hero-estagio1__lead">
          Aluguel de Limousines para casamentos em SP. Luxo e sofisticação
          para momentos especiais, com a Royal Limousines.
        </p>
        <div class="hero__cta">
          <Botao variante="primario" href="/contato/">{site.cta.orcamento}</Botao>
          <Botao variante="secundario" href={site.contato.whatsapp.link} target="_blank" rel="noopener">
            {site.cta.whatsapp}
          </Botao>
        </div>
        <p class="hero-estagio1__nota">{site.contato.areaAtendida}</p>
      </div>
    </div>

    {/* Fora do grid, sangrando a partir de ~55% da largura da tela até a
        mesma margem lateral do container (ver .hero-estagio1__midia). No
        mobile volta pro fluxo normal, como último item da coluna. */}
    <div class="hero-estagio1__midia">
      <Foto
        src={fotosLimo.casamentoNoivos.src}
        alt={fotosLimo.casamentoNoivos.alt}
        {/* Sem `aspectRatio`: aqui a proporção muda por breakpoint (4/5 no
            desktop, 8/5 no mobile) e é definida no CSS abaixo. Passar a
            prop escreveria style inline, que venceria a media query. */}
        {/* Nativa do arquivo. Abaixo disso o 2x sairia do build já
            ampliado; acima, o astro:assets inventaria pixel. */}
        larguraServida={1600}
        {/* Degrau intermediário de 1100: sem ele o 390 precisava de 1084
            para chegar a 2x e pulava direto pro arquivo de 1600 (244 KB).
            Com 1100 ele atinge os mesmos 2x por ~115 KB. */}
        larguras={[480, 800, 1100, 1600]}
        {/* NÃO é a largura da caixa — é a largura que a imagem TERIA antes
            do recorte do `cover`, que é o que o navegador precisa baixar.
            A caixa de 390 exibe uma imagem de 541.7 de largura (o resto é
            cortado), ou seja 139vw; no desktop a de 754 exibe 1371, ou
            95vw. Com os 100vw/45vw anteriores o navegador pedia arquivo
            pequeno e o mobile saía em 1.48x em vez de 2x — era daí que
            vinha a moleza da imagem. */}
        sizes="(max-width: 56.25rem) 139vw, 95vw"
        {/* Céu em gradiente e lataria branca fazem banding com compressão
            agressiva — 85 é o piso aceitável para esta foto. */}
        qualidade={85}
        comFallback
        prioridade
      />
    </div>

    {/* Marquee fora do grid, como irmão: no desktop é uma linha reservada da
        seção (nada entra nela), e no mobile é o último item da coluna. */}
    <div class="hero-estagio1__marquee">
      <Marquee tamanho="grande" />
    </div>
  </section>

  {/*
    TRANSIÇÃO HERO 1 → HERO 2 (ver CLAUDE.md > Transição Hero 1 → Hero 2).

    O trilho tem 250vh (160svh no mobile) e o painel dentro fica preso por
    `position: sticky` — CSS puro, sem pin em JavaScript. O painel É o
    Hero 2: ele entra pela direita cobrindo a tela e, dentro dele, a
    assinatura se monta em cinco fases conduzidas pelo scroll.

    TUDO AQUI É HTML COMUM. Nenhum conteúdo de texto ou layout mora dentro
    de <svg> — foi exatamente isso que apagou o hero na tentativa das
    persianas: o navegador descarta silenciosamente HTML dentro de <svg>.
    O único SVG é o do logo, que entra por set:html no Wordmark e não
    carrega layout nenhum.
  */}
  <section class="transicao-hero" data-transicao-hero>
    <div class="transicao-hero__sticky">
      <div class="transicao-hero__painel" data-transicao-painel>
        <div class="transicao-hero__miolo">
          {/*
            BLOCO SUPERIOR. Largura total, e é ele o referencial da silhueta:
            como o logo é o único filho no fluxo, a altura deste bloco é a
            altura do logo — então a silhueta, centrada em 50% daqui, cai
            exatamente no mesmo eixo horizontal do logo. A silhueta fica fora
            do u-container de propósito, para poder sangrar pela borda da
            TELA; o logo, dentro, para alinhar com a margem de conteúdo.
          */}
          <div class="transicao-hero__topo">
            <Image
              class="silhueta-fundo silhueta-fundo--claro transicao-hero__silhueta"
              data-transicao-silhueta
              src={silhuetaLimo}
              alt=""
              aria-hidden="true"
              widths={[700, 1400]}
              sizes="50vw"
              format="webp"
              loading="lazy"
            />
            {/* O logo aparece por transparência, no lugar onde já está — por
                isso o wrapper carrega só opacity, sem deslocamento. */}
            <div class="transicao-hero__logo u-container" data-transicao-logo>
              <Wordmark />
            </div>
          </div>

          {/*
            BLOCO INFERIOR. Empilhado e centrado na largura TOTAL da página,
            não na do logo.

            A ORDEM DO DOM É A ORDEM DE ENTRADA — e agora ela coincide com a
            ordem visual: os valores entram antes (fase 4) e ficam em cima, a
            procedência entra por último (fase 5) e fica embaixo. Por isso o
            `order` que invertia as duas no CSS deixou de existir.
          */}
          <div class="transicao-hero__assinatura">
            <p class="hero-estagio2__valores" data-transicao-valores>
              <span>Pontualidade</span><span aria-hidden="true"> · </span><span>Discrição</span><span aria-hidden="true"> · </span><span
                >Elegância</span
              >
            </p>
            <p class="hero-estagio2__tagline" data-transicao-tagline>Desde 2008 · São Paulo</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<!--
  Os parágrafos de conteúdo que estavam dentro do hero. Foram MOVIDOS pra
  cá, palavra por palavra — é este texto que carrega as palavras-chave da
  home, e nenhuma delas pode sair da página.
-->
<section class="secao-abertura u-container reveal">
  {/* Silhueta de fundo própria desta seção — arte diferente da do Hero 2 e
      bem mais apagada (25% contra 50%), porque aqui ela fica ATRÁS do
      texto, não ao lado dele. Decorativa: aria-hidden e sem ponteiro. */}
  <Image
    class="secao-abertura__fundo"
    src={silhuetaAbertura}
    alt=""
    aria-hidden="true"
    widths={[900, 1600]}
    {/* Com `cover` isto não é a largura da CAIXA — é a largura que a imagem
        tem depois de escalada para cobrir, que é maior. Em 1440px a seção
        mede 1200x531 e a arte (3.38 de proporção) precisa de ~1793px de
        largura para cobrir a altura. Anunciar 90vw fazia o navegador pedir
        arquivo pequeno demais. */}
    sizes="(max-width: 56.25rem) 150vw, 125vw"
    format="webp"
    loading="lazy"
  />
  <div class="u-prosa secao-abertura__texto">
    <p>
      Desde 2008, oferecemos aluguel de limousines em São Paulo para
      casamentos, aniversários, eventos e jantares, com translados conduzidos
      por chofferes qualificados.
    </p>
    <p>
      Somos especializados em eventos sociais, com foco em casamentos, bodas,
      jantares românticos e festas debutantes.
    </p>
    <p>
      Atendemos pessoas que valorizam um ambiente familiar e elegante, ao
      lado de amigos e parentes, em momentos que merecem ser lembrados.
    </p>
  </div>
</section>

<section class="secao-frota u-container reveal">
  <div class="secao-frota__texto">
    <EntradaTitulo as="h2">Limousine para Casamentos em SP</EntradaTitulo>
    <p class="secao-frota__lead">Sofisticação, elegância e conforto.</p>
    <p>
      Procurando por aluguel de limousines para casamentos? Ligue para a Royal
      Limousines e solicite um orçamento. Atendemos todo o estado de SP.
    </p>
    <p>Modelo clássico, idealizado para os momentos especiais da sua vida.</p>
    <p>
      Com seus 8 metros de extensão e capacidade para 8 passageiros, foi
      projetada com base no contraste entre o clássico e o elegante.
    </p>
    <p>Feita para causar uma boa impressão.</p>
    <Botao variante="terciario" href="/limousines/">Conhecer a frota</Botao>
  </div>
  <Foto
    src={fotosLimo.tresQuartosFrontal.src}
    alt={fotosLimo.tresQuartosFrontal.alt}
    posicao={fotosLimo.tresQuartosFrontal.posicao}
    aspectRatio="4/3"
    class="reveal"
  />
</section>

<Marquee />

<section class="secao-passos u-container reveal">
  <p class="u-eyebrow">Segurança e confiança</p>
  <EntradaTitulo as="h2">Uma contratação com informações claras desde o primeiro contato.</EntradaTitulo>
  <p class="u-prosa secao-passos__intro">
    A proposta é feita com base nas informações do evento. Isso evita
    dúvidas, organiza o roteiro e melhora a previsibilidade do atendimento.
  </p>

  <ol class="secao-passos__lista reveal-grupo">
    {
      passos.map((passo) => (
        <li>
          <span class="secao-passos__numero">{passo.numero}</span>
          <div>
            <h3>{passo.titulo}</h3>
            <p>{passo.texto}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<section class="secao-galeria reveal">
  <div class="u-container">
    <p class="u-eyebrow">Fotos</p>
    <EntradaTitulo as="h2">A limousine em detalhe</EntradaTitulo>
  </div>
  {/* Sangria total, então fora do u-container — vale pro vídeo e pro
      carrossel. O vídeo vem primeiro: é a volta em torno do carro, e o
      carrossel logo abaixo mostra os detalhes. */}
  <div class="secao-galeria__video">
    <Video360
      src={videos360.limo.src}
      poster={videos360.limo.poster}
      largura={videos360.limo.largura}
      altura={videos360.limo.altura}
      alt={videos360.limo.alt}
    />
  </div>
  <div class="secao-galeria__carrossel">
    <Carrossel fotos={fotosGaleriaLimo} />
  </div>
</section>

<section class="secao-contato u-container reveal">
  <p class="u-eyebrow">Contato</p>
  <EntradaTitulo as="h2">Faça um orçamento hoje mesmo</EntradaTitulo>
  <div class="secao-contato__dados">
    <p><a href={site.contato.telefone.link}>{site.contato.telefone.exibicao}</a></p>
    <p><a href={`mailto:${site.contato.email}`}>{site.contato.email}</a></p>
  </div>
  <div class="hero__cta">
    <Botao variante="primario" href="/contato/">{site.cta.orcamento}</Botao>
    <Botao variante="secundario" href={site.contato.whatsapp.link} target="_blank" rel="noopener">
      {site.cta.whatsapp}
    </Botao>
  </div>
</section>

<style>
  /* ---- Hero em dois estágios ---------------------------------------- */

  /* É este wrapper que pinta fundo e texto com as variáveis que o JS
     interpola durante a passagem. */
  .hero-dinamico {
    background-color: var(--bg);
    color: var(--texto);
  }

  .hero-estagio1 {
    position: relative;
    min-height: 100svh;
    padding-top: var(--altura-header);
    /* Folga na base pro chevron (fixo na viewport) ficar ABAIXO da faixa do
       marquee em vez de dentro dela. Reduzida de --espaco-6 pra --espaco-5:
       a seção é min-height (cresce com o conteúdo, nunca corta), então essa
       folga é o que sobra entre o fim da faixa e a borda de baixo quando a
       soma passa de 100svh. Ver a conta em Marquee.astro > .marquee--grande. */
    padding-bottom: var(--espaco-5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .hero-estagio1__grade {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'topo  .'
      '.     .';
    gap: var(--espaco-3) var(--espaco-4);
    align-items: start;
    /* Ocupa o que sobra acima da faixa do marquee. */
    flex: 1;
    min-height: 0;
  }

  .hero-estagio1__topo {
    grid-area: topo;
    align-self: center;
    /* Desce o bloco inteiro — h1, lead, botões e a nota — de uma vez, pelo
       contêiner que já os agrupa. `transform` e não `margin`: com
       `align-self: center` a margem seria redistribuída pela centralização
       e o deslocamento sairia pela metade. Assim são 90px exatos, e o
       marquee (irmão, fora deste bloco) não se mexe. */
    transform: translateY(90px);
  }

  .hero-estagio1__topo h1 {
    margin-top: var(--espaco-2);
  }

  .hero-estagio1__lead {
    margin-top: var(--espaco-3);
    max-width: 40ch;
    color: var(--texto);
  }

  /* Fora do grid — sangra a partir da largura da TELA (não do container),
     por isso é posicionada em relação à seção inteira, não à coluna.
     Esquerda: ~55vw. Direita: a mesma margem lateral que o container usa
     à esquerda (largura-container centralizada + padding-inline), pra
     terminar exatamente onde o texto termina do outro lado. */
  .hero-estagio1__midia {
    position: absolute;
    z-index: 1;
    /* CRESCIMENTO ANCORADO NO CANTO INFERIOR DIREITO.
       `right` e `bottom` NÃO mudam — é isso que trava a base e a borda
       direita. A caixa cresce subtraindo de `left` e de `top`, então ela
       só pode avançar para cima e para a esquerda.

       -106px vem da proporção medida (1.2225): com a altura ganhando 87px
       e passando a 617, a largura proporcional é 617 × 1.2225 = 754, ou
       seja +106. Manter a proporção é o que preserva o enquadramento —
       o object-position continua em 22% e o corte é o mesmo, só maior.

       DESLOCAMENTO DE 20px PARA A DIREITA: os +20px em `left` e os -20px
       em `right` andam JUNTOS, então a caixa desliza sem mudar de tamanho
       — largura, proporção e enquadramento continuam idênticos. Os 20px
       que passam da borda são recortados pelo `overflow: hidden` da
       seção, sem gerar barra de rolagem. */
    left: calc(55% - 106px + 20px);
    /* Passa 20px da borda direita da SEÇÃO em vez de parar nela. O valor
       original recuava até a margem do .u-container (144px em 1440px) e
       era exatamente de lá que vinha o gap. */
    right: -20px;
    /* Centralizada na altura da seção. As duas folgas são a MESMA
       expressão, então são iguais por construção — não por ajuste fino.
       Sobra 55% de altura para a caixa, o que dá ~1.22 de proporção em
       1440x900: justamente o enquadramento pedido (céu no topo, pedra
       portuguesa na base).
       Não colide com o marquee: ele tem width: 50vw e vive na metade
       esquerda, enquanto a foto começa em 55%.

       Os -87px sobem o topo sem tocar em `bottom`, então a altura ganha
       exatamente 87px e a base fica no lugar. Medido em 1440x900: o topo
       vai de 216.84 para 129.84, e o header termina em 74 — sobram 55.84
       de folga, sem colisão. */
    top: calc(22.5% - 87px);
    bottom: 22.5%;
    /* ENTRADA NO LOAD. O estado BASE deste elemento é o FINAL — opacity 1
       e translateX(0) — e o deslocado/transparente existe só no `from` do
       @keyframes. Se a animação não rodar, a foto está visível e no lugar;
       nenhum JS prepara estado inicial (regra do CLAUDE.md).
       `both` cobre os dois lados: sem delay o preenchimento para trás é
       instantâneo, e o para frente trava o estado final. */
    animation: hero1-foto-entra 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Só opacity e transform — as duas compostas na GPU. Nada de left,
     margin ou width, que disparariam layout a cada quadro.

     Os 120px de partida não geram rolagem horizontal porque
     `.hero-estagio1` já tem `overflow: hidden` (ver a regra da seção). Esse
     recorte é seguro para o `position: sticky` do Hero 2: o sticky mora em
     `.transicao-hero`, uma seção IRMÃ, e a restrição do sticky vale só
     para ancestrais — `.hero-estagio1` não é ancestral dele. */
  @keyframes hero1-foto-entra {
    from {
      opacity: 0;
      transform: translateX(120px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Sem deslocamento: só um fade curto, como manda o CLAUDE.md. */
  @keyframes hero1-foto-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-estagio1__midia {
      animation: hero1-foto-fade 0.3s ease both;
    }
  }

  /* A <img> do Foto já é width:100% + object-fit:cover; aqui só precisamos
     que ela preencha a ALTURA definida por este box (top+bottom acima) em
     vez da altura vinda do aspect-ratio do componente. Com width e height
     definidos (não-auto), o aspect-ratio inline do Foto passa a ser
     ignorado — não precisa de !important. */
  .hero-estagio1__midia :global(.foto) {
    height: 100%;
    /* No desktop este valor é inerte — a caixa é dimensionada por
       top/bottom/left/right e o `height: 100%` manda. Fica declarado para
       o componente nunca cair no fallback 4/3 se o posicionamento mudar. */
    --foto-proporcao: 4 / 5;
    /* Cantos arredondados SÓ à esquerda. À direita a foto sangra até a
       margem do container, e arredondar ali abriria uma falha visível no
       meio do sangramento. Esta é a única exceção do site ao
       `--raio-imagem: 3px` global (ver global.css) — deliberada, e por
       isso mora aqui em vez de virar mais uma variável de tema. */
    border-radius: 50px 0 0 50px;
  }

  /* A regra global também dá 3px à <img>. Com o .foto arredondado em 50px
     e overflow: hidden, esse raio interno deixaria um fio do fundo do
     .foto aparecendo nos cantos. Zerado aqui: quem arredonda é a caixa. */
  .hero-estagio1__midia :global(.foto img) {
    border-radius: 0;
    /* Âncoras do enquadramento: buquê inteiro à esquerda, corte da
       limousine na porta traseira à direita, céu no topo e pedra
       portuguesa na base. Como a origem é 2.22 e a caixa é 1.22, o cover
       preserva 880px da largura de 1600 — e `left` = (1600-880) × 22% =
       158, dois passos antes do buquê, que começa em 175. Medido, não
       estimado. A altura entra inteira: nada de corte vertical. */
    object-position: 22% center;
  }

  /* Faixa inferior do hero: linha própria da seção, no fluxo. Como é o
     último item do flex e o grid acima ocupa o resto, nada consegue entrar
     aqui — a folga de 40px é a margem, não uma coincidência de posição. */
  .hero-estagio1__marquee {
    flex: none;
    margin-top: 40px;
    width: 50vw;
    z-index: 2;
    pointer-events: none;
  }

  /* Dentro do bloco de texto, logo abaixo dos botões — alinhada à esquerda
     junto com o h1 e o parágrafo, sem posicionamento próprio. */
  .hero-estagio1__nota {
    margin-top: var(--espaco-4);
    font-family: var(--fonte-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-mut);
  }

  /* ---- Transição Hero 1 → Hero 2 -------------------------------------
     (ver CLAUDE.md > Transição Hero 1 → Hero 2)

     O TRILHO. A altura é o que define quanto scroll a sequência consome.
     O fundo é o mundo ESCURO: é ele que aparece atrás do painel enquanto
     o painel ainda não cobriu a tela, dando continuidade ao Hero 1. */
  .transicao-hero {
    position: relative;
    height: 250vh;
    background-color: var(--escuro-bg);
  }

  /* O "prender na tela" é CSS puro — nunca pin em JavaScript.
     O overflow: hidden mora AQUI, no próprio elemento sticky, e não em
     nenhum ancestral: a restrição do sticky é sobre ancestrais, e um
     ancestral com overflow o mataria silenciosamente. É este overflow que
     impede o painel (que parte de translateX(100%)) de gerar barra de
     rolagem horizontal. */
  .transicao-hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  /* O PAINEL — é o Hero 2. Mundo claro SEMPRE, sem depender das variáveis
     que o JS interpola: se o JS não rodar, ele nunca fica escuro.

     O transform mora aqui, no painel, e em nenhum dos pais: transform em
     ancestral quebra position: sticky no iOS Safari. */
  .transicao-hero__painel {
    --bg: var(--claro-bg);
    --surface: var(--claro-surface);
    --linha: var(--claro-linha);
    --texto: var(--claro-texto);
    --texto-mut: var(--claro-texto-mut);
    --ouro: var(--ouro-claro);
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--claro-bg);
    color: var(--claro-texto);
  }

  .transicao-hero__miolo {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Bloco superior: logo + silhueta no mesmo eixo horizontal. A altura vem
     do logo (único filho no fluxo), e a silhueta é absoluta — por isso os
     centros coincidem sem número mágico nenhum. */
  .transicao-hero__topo {
    position: relative;
  }

  /* CAMADAS — o logo é conteúdo, a silhueta é fundo.
     A ordem do DOM não bastava: a silhueta é `position: absolute` e o
     wrapper do logo era um div estático, e no algoritmo de pintura
     TODO elemento posicionado vem depois de qualquer irmão não
     posicionado, esteja ele onde estiver no HTML. Era daí que saía o
     traço do carro cruzando a coroa e a palavra LIMOUSINES no mobile.
     O `position: relative` (sem deslocamento) é o que dá direito ao
     z-index; a silhueta continua no z-index 0 da regra global. */
  .transicao-hero__logo {
    position: relative;
    z-index: 1;
  }

  /* Composição da silhueta durante a fase 3. O deslocamento entra por
     variável pra somar ao translateY(-50%) que a regra global já aplica —
     escrever `transform` cru aqui apagaria a centralização vertical.
     O `left` posiciona o repouso logo após a palavra ROYAL; a largura leva
     o desenho para além da borda direita da tela, que é a sangria pedida.

     A PARTIDA É FORA DA TELA, e a distância é medida em vw — nunca em
     pixel nem em % da própria imagem. O erro anterior era usar 60% da
     LARGURA DELA: como a imagem é menor que o vão até a borda, sobravam
     ~100px dentro da tela e ela ficava à mostra desde que o painel
     pousava, muito antes da vez dela.

     Aqui o repouso é 57vw (o `left: 57%` de um painel que ocupa a tela
     toda), então faltam 43vw para a borda esquerda sair de cena. Os 2vw
     a mais são folga contra arredondamento e barra de rolagem.

     `--silhueta-entrada` vem do JS e vai de 1 (fora) a 0 (no lugar). O
     fallback 0 é a REGRA DE SEGURANÇA: sem JS ela nasce no lugar final. */
  .transicao-hero__silhueta {
    left: 57%;
    --silhueta-fuga: 45vw;
    transform: translate(calc(var(--silhueta-entrada, 0) * var(--silhueta-fuga)), -50%);
  }

  /* Respiro generoso entre o bloco superior e o inferior. */
  .transicao-hero__assinatura {
    margin-top: var(--espaco-6);
    display: flex;
    flex-direction: column;
    /* Centrado na largura TOTAL da página, não na do logo. */
    align-items: center;
    text-align: center;
    /* Pequeno, para as duas linhas lerem como um bloco só. */
    gap: var(--espaco-1);
  }

  .hero-estagio2__tagline {
    margin: 0;
    font-family: var(--fonte-sans);
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ouro-claro);
  }

  /* As três palavras. Entram por último, depois da assinatura. */
  .hero-estagio2__valores {
    margin: 0;
    font-family: var(--fonte-serif);
    font-size: clamp(1.125rem, 0.9rem + 0.9vw, 1.75rem);
    letter-spacing: 0.02em;
    color: var(--claro-texto);
  }

  .hero-estagio2__valores span[aria-hidden='true'] {
    color: var(--ouro-claro);
  }

  /* REGRA DE SEGURANÇA (CLAUDE.md): o estado escrito no CSS é o estado
     FINAL — tudo visível, no lugar. Quem prepara os estados iniciais é o
     JS, e só depois de confirmar que vai poder animar. Se o JS falhar,
     nada some.

     Mobile: svh e nunca vh. 100vh no celular vale a viewport SEM a barra
     do navegador; quando ela aparece a altura muda e a composição pula.
     E a distância cai de 250vh pra 160svh, porque um gesto de toque
     percorre muito mais scroll que uma rolagem de mouse. */
  @media (max-width: 56.25rem) {
    .transicao-hero {
      height: 160svh;
    }

    .transicao-hero__sticky {
      height: 100svh;
    }

    /* Composição própria: empilhada e centralizada, com a silhueta de
       fundo ATRÁS do conteúdo em vez de coluna ao lado. */
    .transicao-hero__miolo {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    /* Coluna: logo em cima, silhueta logo abaixo. Não existe mais
       `padding-bottom` reservando espaço para uma silhueta absoluta —
       ela agora ocupa espaço sozinha, no fluxo. */
    .transicao-hero__topo {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* O logo perde a régua da margem de conteúdo e centraliza. Mais
       ESTREITO que a silhueta de propósito: é essa diferença que faz o
       desenho ler como fundo e o logo como elemento principal. */
    .transicao-hero__logo {
      order: 1;
      width: 100%;
      max-width: 77%;
      padding-inline: 0;
      margin-inline: auto;
    }

    /* Respiro menor que no desktop: a tela é curta. */
    .transicao-hero__assinatura {
      margin-top: var(--espaco-4);
    }

    /* A regra global esconde a silhueta abaixo de 900px. Aqui ela volta —
       mas NO FLUXO, como uma faixa própria entre o logo e as três
       palavras, e não mais como camada absoluta por cima do logo.

       `position: static` é o que desfaz a sobreposição na raiz: sem
       posicionamento não há como ela pintar sobre o logo, e a folga entre
       os dois passa a ser layout de verdade em vez de um `top` chutado.
       O `order` põe o logo primeiro sem mexer no DOM — a ordem do HTML é
       a ordem de ENTRADA das fases e não pode ser trocada.

       Largura presa à margem de conteúdo do site — a tela inteira menos
       o mesmo `--espaco-3` que o u-container usa dos dois lados. Nada
       sangra pelas bordas. */
    .transicao-hero__silhueta {
      display: block;
      position: static;
      order: 2;
      width: calc(100% - var(--espaco-3) * 2);
      margin-top: var(--espaco-3);
      opacity: 0.3;
      /* Aqui o repouso encosta na margem de conteúdo, então a fuga é a tela
         inteira. Os dois `--espaco-3` a mais não são enfeite: abaixo de
         382px o Chrome mobile reduz o zoom (o header impõe essa largura
         mínima de conteúdo) e passa a exibir MAIS do que 100vw. Sem essa
         folga, em 320px reapareciam 38px da frente do carro, e em 360px a
         margem era de apenas 2px. */
      --silhueta-fuga: calc(100vw + var(--espaco-3) * 2);
      transform: translateX(calc(var(--silhueta-entrada, 0) * var(--silhueta-fuga)));
    }
  }

  /* Sem sequência: tudo no estado final e sem trilho de scroll morto. */
  @media (prefers-reduced-motion: reduce) {
    .transicao-hero {
      height: auto;
    }

    .transicao-hero__sticky {
      position: static;
      height: auto;
      min-height: 100svh;
    }
  }

  /* O position: relative e o overflow existem por causa da silhueta de
     fundo, que é absoluta e sangra além da caixa. O padding vertical é o
     mesmo de antes: a seção não muda de posição na página. */
  .secao-abertura {
    position: relative;
    overflow: hidden;
    padding-block: var(--espaco-6);
  }

  /* Atrás do texto, centralizada, e bem mais apagada que a silhueta do
     Hero 2 (25% contra 50%) justamente porque aqui há texto por cima. */
  /* COBRE A SEÇÃO INTEIRA, encostando nas quatro bordas.
     Antes era dimensionada pela LARGURA com `height: auto`: como a arte é
     3.38 de proporção (muito larga e baixa) e a seção é bem mais alta,
     sobrava faixa vazia em cima e embaixo — 80,8px de cada lado em 1440px,
     109,8 em 768 e 216,1 em 390. Não era `contain` nem padding do
     contêiner: era o `height: auto` seguindo a proporção nativa.
     Agora `inset: 0` + `cover` recorta o excedente em vez de encolher a
     imagem, e o `overflow: hidden` da seção já estava lá para conter. */
  .secao-abertura__fundo {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    /* O reset global tem `img { max-width: 100% }`; aqui não atrapalha
       mais, mas fica explícito porque a regra é sobre esta imagem. */
    max-width: none;
    /* `cover` preserva a proporção e recorta — nunca deforma. */
    object-fit: cover;
    object-position: center center;
    opacity: 0.25;
    pointer-events: none;
    user-select: none;
  }

  /* Bloco centralizado na página, texto centralizado, e uma medida de
     leitura confortável — 46ch evita a linha longa demais que 48rem
     permitia. O z-index tira o texto de baixo da silhueta. */
  .secao-abertura__texto {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    /* Respiro entre os três parágrafos. O vão real é este `gap` MAIS o
       `p + p { margin-top: var(--espaco-2) }` do global.css, que continua
       valendo dentro do flex — ou seja 40 + 16 = 56px, contra os 32px de
       antes. Um degrau da escala do projeto, nada de px solto. */
    gap: var(--espaco-4);
    max-width: 46ch;
    margin-inline: auto;
    text-align: center;
    color: var(--texto);
  }

  @media (max-width: 56.25rem) {
    .secao-abertura__fundo {
      /* A largura de 130% que morava aqui saiu junto com o dimensionamento
         por largura: com `cover` quem manda é o `inset: 0`, e esticar além
         de 100% só criaria transbordo sem cobrir mais nada.
         A opacidade menor fica: no mobile a coluna de texto ocupa a largura
         toda e passa por cima do desenho. */
      opacity: 0.18;
    }
  }

  /* ---- Mobile: layout próprio, não uma adaptação do desktop -----------
     Abaixo de 900px a composição do desktop (grid de duas colunas + mídia
     em sangria) NÃO é reaproveitada. Vira coluna única, tudo no fluxo
     normal, sem posicionamento absoluto: a ordem visual passa a ser h1,
     parágrafo, botões, nota, marquee, mídia (a nota já vem nessa ordem
     por estar dentro do bloco de texto; marquee e mídia são reordenados
     abaixo). */
  @media (max-width: 56.25rem) {
    .hero-estagio1 {
      /* O conteúdo empilhado passa de uma tela; forçar 100svh só cortaria. */
      min-height: 0;
      /* Folga CONSTANTE abaixo do header fixo. O header é position: fixed,
         então o padding-top compensa a barra uma única vez — o respiro
         visível é só o --espaco-3 somado aqui. */
      padding-top: calc(var(--altura-header) + var(--espaco-3));
      padding-bottom: var(--espaco-5);
      gap: var(--espaco-4);
    }

    /* A grade deixa de ser caixa pra que topo e mídia virem irmãos diretos
       da seção e possam ser reordenados: o marquee precisa entrar logo
       abaixo dos botões, antes da mídia. Como o box do .u-container some
       junto, a margem lateral e o z-index (que punham o conteúdo acima da
       cortina) voltam item a item abaixo. */
    .hero-estagio1__grade {
      display: contents;
    }

    .hero-estagio1__topo,
    .hero-estagio1__midia {
      position: relative;
      z-index: 1;
      /* Mesma margem lateral do .u-container, que deixou de envolvê-los. */
      padding-inline: var(--espaco-3);
      /* A seção é flex column: sem isto o align-self: center herdado do
         desktop encolheria a caixa no eixo horizontal. */
      align-self: stretch;
    }

    .hero-estagio1__topo {
      order: 1;
      /* Os 50px do desktop não valem aqui. Medido: no empilhado do mobile
         eles jogam "SÃO PAULO E REGIÃO" 10px por dentro do marquee, que
         no desktop fica no rodapé da seção mas aqui vem logo abaixo do
         bloco de texto. Os botões continuariam dentro da dobra (sobram
         300px em 390), então não é a dobra que impede — é a colisão. */
      transform: none;
      /* Sem tela cheia e sem centralização vertical: era daí que vinha o
         vazio grande e variável entre o header e o h1. O bloco agora
         encosta no topo e a folga é só o padding da seção. */
      min-height: 0;
      display: block;
    }

    .hero-estagio1__marquee {
      order: 2;
      width: 100%;
      margin-top: 0;
      /* Espaço onde o chevron (fixo na base da viewport) pousa, em vez de
         cair sobre a mídia que vem logo depois. */
      margin-bottom: var(--espaco-5);
    }

    .hero-estagio1__midia {
      order: 4;
      /* Sai do posicionamento absoluto do desktop: `inset: auto` zera
         top/left/right/bottom daquela regra, que com position: relative
         (herdado da regra compartilhada acima) virariam deslocamento. */
      inset: auto;
      /* Largura da PÁGINA inteira, de borda a borda. A regra compartilhada
         acima dá `padding-inline: var(--espaco-3)` a este bloco e ao topo;
         aqui ele é zerado, e como a própria seção não tem padding
         horizontal, isso já basta pra foto encostar nas duas bordas.
         Nada de `100vw` com margem negativa: aquilo estoura a largura do
         documento quando existe barra de rolagem. */
      padding-inline: 0;
      /* Sem transform: no mobile a mídia não cresce na passagem (largura
         total já é o tamanho final, e escalar só geraria vazamento). */
      width: 100%;
      max-width: none;
      margin-left: 0;
      transform: none;
    }

    /* Encostada nas duas bordas, qualquer raio abriria uma falha de fundo
       nos cantos — então some. Vale também pra borda esquerda: o
       arredondamento de 50px é uma composição de desktop, onde a foto
       flutua dentro da tela. */
    .hero-estagio1__midia :global(.foto) {
      border-radius: 0;
      /* METADE DA ALTURA de antes, com a largura seguindo nas duas
         extremidades da página. Como a largura já era 100% e não pode
         crescer mais, quem muda é a proporção: 4/5 (0.8) → 8/5 (1.6),
         que é exatamente o dobro da largura em relação à altura.
         Em 390px: 390x487.5 → 390x243.75. Em 768px: 768x960 → 768x480.

         Ganho lateral: a janela do `cover` sobe de 576px para 1152px da
         origem, o que acaba com a ampliação de 1.33x que existia no 768. */
      --foto-proporcao: 8 / 5;
    }

    /* Com a caixa em 8/5 a janela do cover passa a 1152px da origem — o
       dobro de antes —, então o casal e o carro inteiro cabem com folga e
       o recorte deixa de ser apertado. 12% começa em 54, e o buquê abre em
       175: 121px de margem. Acima de 25% o buquê começaria a sair. */
    .hero-estagio1__midia :global(.foto img) {
      object-position: 12% center;
    }

  }

  /* Rede de segurança: mesmo que algum estado inicial tenha sido aplicado
     antes de o JS ler a preferência, nada da assinatura fica escondido. */
  @media (prefers-reduced-motion: reduce) {
    .transicao-hero__painel,
    .transicao-hero__logo,
    .hero-estagio2__valores,
    .hero-estagio2__tagline {
      opacity: 1 !important;
      transform: none !important;
    }

    .transicao-hero__silhueta {
      --silhueta-entrada: 0;
    }
  }

  /* .hero, .hero__miolo e .hero__texto saíram junto com o hero antigo de uma
     seção só — o Estágio 1 tem grade própria. .hero__cta continua, porque é
     usado aqui e em outras seções. */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-2);
    margin-top: var(--espaco-4);
  }

  .secao-frota,
  .secao-galeria,
  .secao-contato {
    padding-block: var(--espaco-6);
    border-top: 1px solid var(--linha);
  }

  /* .secao-passos não leva border-top: o <Marquee> logo acima já faz esse
     papel de divisor entre seções. */
  .secao-passos {
    padding-block: var(--espaco-6);
  }

  .secao-frota {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--espaco-5);
    align-items: center;
  }

  .secao-frota__texto p {
    color: var(--texto);
    margin-top: var(--espaco-2);
  }

  .secao-frota__lead {
    font-family: var(--fonte-serif);
    font-size: 1.25rem;
    color: var(--texto);
  }

  .secao-frota__texto .botao {
    margin-top: var(--espaco-3);
  }

  .secao-passos__intro {
    margin-top: var(--espaco-2);
    color: var(--texto);
    max-width: 40rem;
  }

  .secao-passos__lista {
    margin-top: var(--espaco-4);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--espaco-4);
  }

  .secao-passos__lista li {
    display: flex;
    gap: var(--espaco-2);
  }

  .secao-passos__numero {
    font-family: var(--fonte-serif);
    font-size: 1.75rem;
    color: var(--ouro);
    flex-shrink: 0;
  }

  .secao-passos__lista h3 {
    font-size: 1.0625rem;
  }

  .secao-passos__lista p {
    margin-top: 0.3rem;
    color: var(--texto);
    font-size: 0.9375rem;
  }

  .secao-galeria__video {
    margin-top: var(--espaco-4);
  }

  /* Menor que o respiro do vídeo pro título: vídeo e carrossel são o mesmo
     bloco de mídia, e um vão grande entre eles quebraria a leitura. */
  .secao-galeria__carrossel {
    margin-top: var(--espaco-3);
  }

  .secao-contato__dados {
    margin-top: var(--espaco-2);
    display: flex;
    flex-direction: column;
    gap: var(--espaco-1);
  }

  .secao-contato__dados a {
    text-decoration: none;
    color: var(--texto);
  }

  .secao-contato__dados a:hover {
    color: var(--ouro);
  }

  @media (max-width: 56rem) {
    .secao-frota {
      grid-template-columns: 1fr;
    }

    .secao-passos__lista {
      grid-template-columns: 1fr;
    }

  }
</style>
