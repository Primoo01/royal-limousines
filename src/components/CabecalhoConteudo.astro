---
// Cabeçalho das páginas de conteúdo (ver CLAUDE.md > Cabeçalho das páginas
// de conteúdo). Vale para as 8 páginas de serviço/região, /empresa/,
// /servicos/ e /contato/ — resolve o vazio no topo dessas páginas com uma
// solução única.
//
// 60svh de propósito: menor que o hero da home (100svh), pra não competir
// com ele. svh e não vh — vh quebra no mobile por causa da barra do
// navegador (CLAUDE.md > Altura de seção).
//
// Mundo claro. Nenhuma variável de cor é definida aqui: as páginas de
// conteúdo já vivem no mundo claro padrão do documento.
//
// A linha de apoio NUNCA é texto novo: cada página passa uma frase que já
// existia no seu próprio conteúdo (regra inviolável 5 — não inventar
// conteúdo). Quem chama é responsável por remover a frase do corpo, pra
// realocar e não duplicar.
//
// Segurança: os dois efeitos daqui (EntradaTitulo e LinhaDesenhada) já
// nascem visíveis no CSS. Quem esconde é o JS de Movimento.astro, e só em
// elemento que ainda não entrou na viewport. Se o JS falhar, o h1, a linha
// de apoio, a curva e o ponto continuam todos visíveis.
import EntradaTitulo from './EntradaTitulo.astro';
import LinhaDesenhada from './LinhaDesenhada.astro';

interface Props {
  /** Texto do eyebrow, acima do h1 */
  eyebrow: string;
  /** Conteúdo do h1 — é sinal de SEO, vem do backup e não pode ser alterado */
  titulo: string;
  /** Linha de apoio curta. Precisa ser frase que já existia na página. */
  apoio: string;
  /** Variante do traço. 'assinatura' é exclusiva da /contato/. */
  linha?: 'curva' | 'assinatura';
}

const { eyebrow, titulo, apoio, linha = 'curva' } = Astro.props;
---

<header class="cabecalho-conteudo u-container">
  <p class="u-eyebrow">{eyebrow}</p>

  {/*
    EntradaTitulo e LinhaDesenhada são envolvidos por divs renderizadas AQUI,
    em vez de receberem uma prop `class` estilizada por este arquivo. O
    escopo de estilo do Astro só casa com elementos renderizados pelo próprio
    componente: uma regra `.x` escrita aqui vira `.x[data-astro-cid-DESTE]`, e
    o elemento filho carrega o cid do OUTRO componente — a regra nunca
    aplicaria. A div intermediária é o que torna o espaçamento controlável
    daqui.
  */}
  <div class="cabecalho-conteudo__titulo">
    <EntradaTitulo as="h1">{titulo}</EntradaTitulo>
  </div>

  <p class="cabecalho-conteudo__apoio">{apoio}</p>

  <div class="cabecalho-conteudo__linha">
    <LinhaDesenhada variante={linha} />
  </div>
</header>

<style>
  .cabecalho-conteudo {
    min-height: 60svh;
    /* A barra do topo é fixa: sem esta reserva o eyebrow nasce por baixo dela. */
    padding-top: calc(var(--altura-header) + var(--espaco-4));
    padding-bottom: var(--espaco-4);
    display: flex;
    flex-direction: column;
    /* `flex-end` e não `center`: com o centramento, a sobra do
       `min-height: 60svh` era dividida metade acima e metade abaixo do
       conteúdo — e a metade de baixo caía justamente entre o divisor e a
       seção seguinte, variando de 1,8px a 112,9px conforme a altura da
       tela. Empurrando o bloco para a base, toda a sobra vai para cima e o
       vão abaixo do divisor passa a ser só o `padding-bottom`: 40px fixos,
       exatamente os mesmos 40px que o divisor tem acima dele.
       O `min-height: 60svh` do CLAUDE.md continua valendo — o cabeçalho
       ocupa a mesma altura, só distribui o vazio de outro jeito. */
    justify-content: flex-end;
  }

  .cabecalho-conteudo__titulo {
    margin-top: var(--espaco-2);
  }

  /* Cor de texto normal, não a atenuada: esta linha é CONTEÚDO, não legenda —
     é a frase de apoio do <h1>, e ela sustenta a hierarquia do cabeçalho.
     O motivo original também citava contraste: --texto-mut dava 3,26:1 sobre o
     fundo claro. Esse argumento caiu — a variável foi escurecida para #656158
     e hoje dá 5,47:1, passando no AA. A escolha continua sendo --texto, agora
     por hierarquia e só por isso. */
  .cabecalho-conteudo__apoio {
    margin-top: var(--espaco-3);
    max-width: 44ch;
    color: var(--texto);
  }

  .cabecalho-conteudo__linha {
    margin-top: var(--espaco-4);
  }

  /* O espaço ABAIXO do divisor é o `padding-bottom` deste cabeçalho —
     var(--espaco-4), exatamente os mesmos 40px que o `margin-top` acima
     dá. A seção seguinte estava REPETINDO esse respiro duas vezes: o
     `padding-top` dela (40px) mais a margem do primeiro filho (64px em
     /servicos/ e nas 8 de região, 40px em /contato/). Somados, o vão de
     baixo chegava a 133–217px contra os 40 de cima.
     Zerar aqui, uma vez, vale para as 11 páginas que usam este cabeçalho.
     O `:global` é necessário porque a seção é irmã, renderizada por outro
     arquivo — o escopo do Astro não a alcançaria. */
  .cabecalho-conteudo + :global(section) {
    padding-top: 0;
  }

  .cabecalho-conteudo + :global(section) > :global(:first-child) {
    margin-top: 0;
  }
</style>
