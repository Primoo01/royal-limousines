---
// Painel de mídia do menu (ver CLAUDE.md > Navegação).
// Uma camada por grupo, empilhadas, trocando em crossfade (opacity) via
// data-ativa — o Header.astro liga isso ao hover dos links.
//
// Sem vídeo: são fotos com um zoom lento e contínuo (ver menu-midia.js pra
// por quê). O movimento é só transform, e some inteiro em reduced-motion.
// NASCEM SEM `src`/`srcset`, e é por isso que aqui tem getImage() em vez de
// <Image>: o overlay é `position: fixed; inset: 0`, e o lazy loading do Chrome
// decide pela posição de LAYOUT — um elemento fixo cobrindo a viewport conta
// como dentro da viewport, então `loading="lazy"` não adiava nada. Medido na
// home a 390px, com o menu FECHADO: as 6 fotos disparavam juntas em 1134ms e
// ocupavam o tubo até 5,7s, 631 KB disputando banda com o LCP. Quem promove
// data-src → src é o abrirMenu() do Header.astro, na primeira abertura. Mesmo
// padrão que o CLAUDE.md já manda usar no vídeo do menu.
import { getImage } from 'astro:assets';
import menuMidiaData from '../data/menu-midia.js';

const grupos = await Promise.all(
  Object.entries(menuMidiaData).map(async ([chave, item]) => ({
    chave,
    item,
    imagem: await getImage({ src: item.src, widths: [640, 1080], format: 'webp' }),
  }))
);
---

<div class="menu-midia" data-menu-midia aria-hidden="true">
  {
    grupos.map(({ chave, item, imagem }) => (
      <div class="menu-midia__camada" data-midia-camada={chave} data-ativa={chave === 'padrao' ? 'true' : 'false'}>
        <img
          data-src={imagem.src}
          data-srcset={imagem.srcSet.attribute}
          sizes="(max-width: 56rem) 100vw, 40vw"
          width={imagem.attributes.width}
          height={imagem.attributes.height}
          alt=""
          loading="lazy"
          decoding="async"
          style={item.posicao ? `object-position: ${item.posicao};` : undefined}
        />
      </div>
    ))
  }
  <div class="menu-midia__escrim" />
</div>

<style>
  .menu-midia {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--escuro-surface);
    pointer-events: none;
  }

  .menu-midia__camada {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .menu-midia__camada[data-ativa='true'] {
    opacity: 1;
  }

  .menu-midia__camada :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* Zoom lento de aproximação: 1 → 1.08 em 6s. `alternate` faz a volta
       pelo mesmo caminho, então não existe salto no recomeço do ciclo.
       Só transform, como todo movimento do site. */
    animation: menu-midia-zoom 6s ease-in-out infinite alternate;
  }

  @keyframes menu-midia-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  /* O painel é do mundo escuro e quatro das seis fotos são do carro branco
     em plena luz. Este véu é o que sustenta o contraste do texto do menu:
     no desktop o texto fica AO LADO da mídia, mas no mobile ele fica POR
     CIMA, e é lá que o véu precisa ser pesado. Ver a medição de contraste
     na resposta da rodada de inserção de mídias. */
  .menu-midia__escrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(20, 18, 16, 0.3), rgba(20, 18, 16, 0.65));
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-midia__camada :global(img) {
      animation: none;
    }

    .menu-midia__camada {
      transition: none;
    }
  }

  /* Mobile: sem painel — a mídia vira fundo atrás dos links (ver Header.astro
     / MenuOverlay.astro pra como o container é reposicionado). Aqui o texto
     corre POR CIMA da foto, então o véu sobe bastante. */
  @media (max-width: 56rem) {
    .menu-midia__escrim {
      background: linear-gradient(
        to bottom,
        rgba(20, 18, 16, 0.72),
        rgba(20, 18, 16, 0.88) 40%,
        rgba(20, 18, 16, 0.95)
      );
    }
  }
</style>
