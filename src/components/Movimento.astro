---
// Movimento do site inteiro (ver CLAUDE.md > Movimento):
// 1) revelações no scroll (IntersectionObserver + classe .reveal)
// 2) scroll suave com Lenis, só desktop, só sem prefers-reduced-motion
// 3) chevron do hero, que some ao rolar
// 4) indicador "estrada" com as seções como paradas
// 6) âncoras internas, com o destino medido pelo layout e não pela posição
//    visual (que a revelação desloca)
// Um único componente, incluído uma vez no BaseLayout, pra manter o
// JavaScript do site inteiro fácil de auditar num só lugar.
---

<!--
  Puramente decorativo — não faz nada ao ser ativado, então não pode ser
  focável nem exposto a leitor de tela (senão é foco de teclado que não leva
  a lugar nenhum). Dar comportamento a ele é tarefa separada, futura.
-->
<div class="chevron-scroll" data-chevron aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="M4 9l8 8 8-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</div>

<nav class="estrada" data-estrada aria-hidden="true">
  <div class="estrada__linha">
    <span class="estrada__marcador" data-estrada-marcador></span>
  </div>
</nav>

<style>
  .chevron-scroll {
    position: fixed;
    bottom: var(--espaco-4);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-indicadores);
    color: var(--ouro);
    pointer-events: none;
    padding: var(--espaco-1);
    opacity: 1;
    transition: opacity 0.4s ease;
    animation: chevron-flutuar 1.8s ease-in-out infinite;
  }

  .chevron-scroll[data-oculto='true'] {
    opacity: 0;
  }

  @keyframes chevron-flutuar {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(8px);
    }
  }

  .estrada {
    position: fixed;
    left: var(--espaco-3);
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--z-indicadores);
    height: 40vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .estrada[data-visivel='true'] {
    opacity: 1;
  }

  .estrada__linha {
    position: relative;
    width: 1px;
    height: 100%;
    background-color: var(--linha);
  }

  .estrada__marcador {
    position: absolute;
    left: 50%;
    top: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--ouro);
    transform: translate(-50%, -50%);
  }

  .estrada__parada {
    position: absolute;
    left: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: var(--linha);
    transform: translate(-50%, -50%);
  }

  @media (max-width: 56rem) {
    .estrada {
      display: none;
    }

    /* O chevron continua visível no hero da home: o bloco de conteúdo do
       Estágio 1 reserva folga na base da primeira tela (ver ConteudoHome),
       então ele pousa em área livre em vez de cair por cima da mídia. */
  }

  /* No hero da home em desktop, o chevron sai do centro. O marquee ocupa a
     metade ESQUERDA da faixa inferior e nada pode se sobrepor a ele; como o
     chevron é fixo na viewport e a seção pode ficar mais alta que a tela,
     não existe altura em que ele fique garantidamente abaixo da faixa.
     Deslocá-lo pra metade direita resolve por geometria, em qualquer altura
     de tela, e ele continua ancorado à base. */
  @media (min-width: 56.25rem) {
    body:has([data-hero-estagio1]) .chevron-scroll {
      left: 75%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron-scroll {
      animation: none;
    }
  }
</style>

<script>
  const chevron = document.querySelector<HTMLElement>('[data-chevron]');
  const estrada = document.querySelector<HTMLElement>('[data-estrada]');
  const marcador = document.querySelector<HTMLElement>('[data-estrada-marcador]');
  const linha = document.querySelector<HTMLElement>('.estrada__linha');

  const reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1) Revelação no scroll ------------------------------------------------
  // .reveal (seções) e .reveal-grupo (escalonamento entre irmãos).
  //
  // Mesma regra de segurança do vocabulário de entrada: o conteúdo é visível
  // por padrão no CSS, e o JS só PREPARA (esconde) elementos que ainda não
  // entraram na viewport. Quem já está visível no carregamento não é tocado.
  // Se o JS não rodar, nada fica permanentemente invisível.
  //
  // A RAIZ é a viewport com uma faixa descontada na base: o elemento só conta
  // como "entrou" depois de cruzar essa linha. É a MESMA raiz do observer, e é
  // isso que impede as duas decisões — esconder e revelar — de discordarem.
  //
  // O BUG QUE ISTO CORRIGE (medido nas 8 páginas de região, em 390px): os dois
  // lados decidiam por PROPORÇÃO DA ALTURA DO PRÓPRIO ELEMENTO, e nem contra a
  // mesma raiz. A seção .secao-regiao empilha numa coluna só no celular e fica
  // com 2667px de altura: 15% dela são 400px, mais de um terço da tela. Com
  // 282px de texto já legível em cena, a conta da preparação dava 282/2667 =
  // 0.106 < 0.15 e escondia; a do observer dava 222/2667 = 0.083 (222 porque
  // o rootMargin encurta a raiz em 60px) e não revelava. O texto sumia ~700ms
  // depois de aparecer e só voltava com 178px de scroll. Em 1440px o grid vira
  // duas colunas, a seção cai para 1737px, as duas contas passam de 0.15 e o
  // bug não aparece — era por isso que só o celular sofria.
  //
  // Agora as duas decisões saem de UM predicado, em PIXELS: entrou = tem ao
  // menos 1px dentro da raiz. `threshold: 0` com `rootMargin` de −60px na base
  // significa exatamente "60px do elemento estão na tela" — que é o que
  // `threshold: 0.15` já significava para um bloco de 400px (0.15 × 400 = 60).
  // Para elemento de altura normal o ponto de disparo quase não muda (medido:
  // o limiar antigo equivalia a 15–95px de tela na mediana); o que muda é o
  // caso patológico do elemento mais alto que a tela, onde ele pedia 551px.
  //
  // E a rede de segurança passa a ser ESTRUTURAL em vez de uma coincidência
  // entre dois números: como "preparado" é a negação exata da condição que o
  // observer usa para revelar, nenhum elemento visível é escondido, e nada que
  // foi escondido fica irrevelável.
  const MARGEM_REVEAL = 60;
  // Nos títulos do vocabulário de entrada o limiar de 0.35 equivalia a 22px
  // (390px) / 34px (1440px) de tela na mediana medida — 28px fica no meio.
  const MARGEM_ENTRADA = 28;

  function pxDentroDaRaiz(el: HTMLElement, margem: number) {
    const rect = el.getBoundingClientRect();
    const limite = window.innerHeight - margem;
    return Math.max(0, Math.min(rect.bottom, limite) - Math.max(rect.top, 0));
  }

  function prepararEObservar(
    elementos: HTMLElement[],
    classePreparado: string,
    classeVisivel: string,
    margem: number
  ) {
    const pendentes = elementos.filter((el) => pxDentroDaRaiz(el, margem) <= 0);

    pendentes.forEach((el) => {
      // Força o navegador a "commitar" o estado atual (visível, sem classe)
      // antes de aplicar a que traz opacity:0 + transition no mesmo
      // elemento — sem isso a mudança pode não virar uma transição de fato.
      void el.getBoundingClientRect();
      el.classList.add(classePreparado);
    });

    if (!pendentes.length) return;

    const observer = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (!entrada.isIntersecting) return;
          entrada.target.classList.remove(classePreparado);
          entrada.target.classList.add(classeVisivel);
          observer.unobserve(entrada.target);
        });
      },
      { threshold: 0, rootMargin: `0px 0px -${margem}px 0px` }
    );

    pendentes.forEach((el) => observer.observe(el));
  }

  const elementosReveal = Array.from(document.querySelectorAll<HTMLElement>('.reveal, .reveal-grupo'));

  // Com prefers-reduced-motion, ou sem IntersectionObserver, não há nada a
  // fazer aqui: o conteúdo já nasce visível.
  if (!reduzMovimento && 'IntersectionObserver' in window) {
    prepararEObservar(elementosReveal, 'reveal--preparado', 'reveal--visivel', MARGEM_REVEAL);

    // 1b) Vocabulário de entrada (ver EntradaTitulo.astro) -----------------
    // Regra de segurança (CLAUDE.md > Vocabulário de entrada): o texto é
    // visível por padrão no CSS. Só elementos que ainda NÃO estão na
    // viewport no carregamento recebem a classe que os prepara pra animar
    // (escondidos). Os que já estão visíveis nunca são tocados — se o JS
    // falhar ou demorar, nada fica invisível. Diferente do antigo
    // reveal-titulo, o elemento observado aqui nunca tem clip-path nele
    // mesmo (só opacity/transform num filho), então não repete o impasse
    // de interseção sempre-zero que esse clip-path causava no Chromium.
    prepararEObservar(
      Array.from(document.querySelectorAll<HTMLElement>('.entrada')),
      'entrada--preparado',
      'entrada--visivel',
      MARGEM_ENTRADA
    );

    // 1c) Linha que se desenha (ver LinhaDesenhada.astro) -------------------
    //
    // O BUG QUE ISTO CORRIGE: a versão anterior media com getTotalLength() no
    // carregamento e só preparava elementos com menos de 50% de visibilidade.
    // Como o cabeçalho fica no topo de todas as páginas de conteúdo, a linha
    // estava SEMPRE 100% visível no load — era filtrada fora, nunca recebia
    // dasharray e nunca animava, em página nenhuma.
    //
    // Agora TODOS os elementos são observados, e a medição acontece DENTRO do
    // callback do observer — ou seja, no instante em que o elemento está em
    // cena e renderizado. Medir escondido devolve 0, e com 0 o dasharray não
    // tem efeito. O IntersectionObserver dispara o callback imediatamente
    // para quem já está na viewport, então o caso "já visível no load"
    // também anima, sem tratamento especial.
    const linhas = Array.from(document.querySelectorAll<HTMLElement>('[data-linha-desenhada]'));

    function desenharLinha(container: HTMLElement) {
      const path = container.querySelector<SVGPathElement>('.linha-desenhada__curva');
      if (!path) return;

      // MEDIÇÃO NO MOMENTO CERTO: o elemento está visível e renderizado aqui.
      const comprimento = path.getTotalLength();

      // Rede de segurança: 0 ou NaN significa que a medição falhou. Não
      // aplica dasharray nenhum e sai — a linha fica visível e completa.
      // Traço invisível por falha de medição é o pior desfecho possível.
      if (!Number.isFinite(comprimento) || comprimento <= 0) return;

      const ponto = container.querySelector<HTMLElement>('[data-linha-ponto]');

      // Sem WAAPI não há como garantir o desenho: deixa a linha visível e
      // inteira em vez de arriscar escondê-la sem conseguir revelá-la.
      if (typeof path.animate !== 'function') return;

      // POR QUE Web Animations API e não transition CSS: a transição de
      // stroke-dashoffset dependia de o navegador registrar o valor inicial
      // como "before-change style". Como stroke-dashoffset não afeta a
      // geometria da caixa, nem getBoundingClientRect() nem a leitura do
      // próprio computed style forçavam esse registro de forma confiável —
      // medido no Chrome: zero eventos transitionstart/run/end e o offset já
      // em 0px no primeiro quadro. O traço aparecia pronto.
      // A WAAPI declara os dois keyframes explicitamente, então não existe
      // ambiguidade sobre o estado de partida.
      //
      // O dasharray fica inline e estático: é ele que corta o traço em um
      // segmento visível e um vão, ambos do tamanho do path. A unidade "px"
      // resolve nas user units do path — as mesmas de getTotalLength() —
      // não em pixels de tela.
      path.style.strokeDasharray = `${comprimento}px`;

      // Esconde o ponto (variante 'curva') enquanto o traço se desenha.
      container.classList.add('linha-desenhada--preparada');

      const animacao = path.animate(
        [{ strokeDashoffset: `${comprimento}px` }, { strokeDashoffset: '0px' }],
        {
          duration: 1700,
          delay: 150,
          easing: 'cubic-bezier(0.2, 0.7, 0.3, 1)',
          // 'both': segura o offset cheio durante o atraso e mantém o zero no
          // fim, sem depender de escrever no style depois.
          fill: 'both',
        }
      );

      if (ponto) {
        let pontoJaEntrou = false;
        const mostrarPonto = () => {
          if (pontoJaEntrou) return;
          pontoJaEntrou = true;
          ponto.classList.add('linha-desenhada__ponto--visivel');
        };
        animacao.finished.then(mostrarPonto).catch(() => mostrarPonto());
        // Rede de segurança: o ponto não pode ficar invisível pra sempre se
        // a promise não resolver. 1.7s + 0.15s + folga.
        setTimeout(mostrarPonto, 2300);
      }
    }

    if (linhas.length) {
      const linhaObserver = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (!entrada.isIntersecting) return;
            const container = entrada.target as HTMLElement;
            // Desobserva ANTES de desenhar: o callback não pode reentrar e
            // reiniciar um traço que já começou.
            linhaObserver.unobserve(container);
            desenharLinha(container);
          });
        },
        { threshold: 0.2 }
      );
      linhas.forEach((el) => linhaObserver.observe(el));
    }
  }

  // 3) e 4) Chevron + estrada ----------------------------------------------
  if (chevron || estrada) {
    // Paradas da estrada: uma por <section> dentro de <main> (inclui as que
    // estão dentro do wrapper .mundo-dinamico em /limousines/).
    const secoes = Array.from(document.querySelectorAll<HTMLElement>('main section'));
    if (linha && secoes.length > 1) {
      const alturaDocumento = document.documentElement.scrollHeight - window.innerHeight;
      secoes.forEach((secao) => {
        if (alturaDocumento <= 0) return;
        const proporcao = (secao.offsetTop / alturaDocumento) * 100;
        const parada = document.createElement('span');
        parada.className = 'estrada__parada';
        parada.style.top = `${Math.min(Math.max(proporcao, 0), 100)}%`;
        linha.appendChild(parada);
      });
    }

    // 5) Transição dia→noite em /limousines/ — só existe nessa página;
    // nas demais, estes querySelectors retornam null e o bloco não faz nada.
    const transicao = document.querySelector<HTMLElement>('[data-transicao-dia-noite]');
    const mundoDinamico = document.querySelector<HTMLElement>('[data-mundo-dinamico]');
    const pontosLuz = transicao ? Array.from(transicao.querySelectorAll<HTMLElement>('.ponto-luz')) : [];

    // Mesmos pares de cor do global.css (claro → escuro). Precisa ficar em
    // sincronia se a paleta mudar por lá.
    const paresDeCor: Record<string, [string, string]> = {
      '--bg': ['#f4f1eb', '#141210'],
      '--surface': ['#e7e0d4', '#211e18'],
      '--linha': ['#cfc6b5', '#3a342a'],
      '--texto': ['#1a1815', '#ede7db'],
      '--texto-mut': ['#8a8578', '#8c857a'],
      '--ouro': ['#a8823c', '#c6a25e'],
    };

    // O destino escuro do FUNDO pode ser sobrescrito pela página. A
    // /limousines/ termina num preto mais fundo (#020202) que o --escuro-bg
    // do resto do site: era o tom do bloco do sedan, e virou o alvo da
    // interpolação pra que se chegue nele sem emenda.
    const bgEscuroDaPagina = mundoDinamico
      ? getComputedStyle(mundoDinamico).getPropertyValue('--bg-escuro-pagina').trim()
      : '';
    if (/^#[0-9a-f]{6}$/i.test(bgEscuroDaPagina)) paresDeCor['--bg'] = ['#f4f1eb', bgEscuroDaPagina];

    function hexParaRgb(hex: string): [number, number, number] {
      const valor = parseInt(hex.slice(1), 16);
      return [(valor >> 16) & 255, (valor >> 8) & 255, valor & 255];
    }

    function interpolarCor(hexClaro: string, hexEscuro: string, t: number): string {
      const [r1, g1, b1] = hexParaRgb(hexClaro);
      const [r2, g2, b2] = hexParaRgb(hexEscuro);
      const r = Math.round(r1 + (r2 - r1) * t);
      const g = Math.round(g1 + (g2 - g1) * t);
      const b = Math.round(b1 + (b2 - b1) * t);
      return `rgb(${r}, ${g}, ${b})`;
    }


    // 5b) Transição Hero 1 → Hero 2 (ver CLAUDE.md) ------------------------
    // Só existe em "/"; nas demais páginas o querySelector devolve null e
    // todo este bloco fica inerte.
    //
    // O "prender na tela" é o `position: sticky` do painel, CSS puro — não
    // existe pin em JavaScript aqui. Este bloco só converte o scroll em
    // progresso e distribui esse progresso pelas cinco fases.
    //
    // As fases são ENCOSTADAS: cada uma começa onde a anterior termina, sem
    // folga e sem sobreposição — o intervalo entre duas entradas é a duração
    // da anterior. Trocar a ordem é trocar as janelas de lugar levando a
    // largura junto; a soma continua 1.00 e a sequência não fica mais longa.
    // Ordem: painel (0.35) → logo (0.17) → carro (0.20) → valores (0.12) →
    // procedência (0.16).
    //
    // REGRA DE SEGURANÇA: o CSS nasce no estado FINAL (tudo visível). Quem
    // aplica os estados iniciais é este código, e só depois de confirmar
    // que vai poder animar. Se ele não rodar, nada some.
    const transicaoHero = document.querySelector<HTMLElement>('[data-transicao-hero]');
    const heroPainel = document.querySelector<HTMLElement>('[data-transicao-painel]');
    const heroSilhueta = document.querySelector<HTMLElement>('[data-transicao-silhueta]');
    const heroLogo = document.querySelector<HTMLElement>('[data-transicao-logo]');
    const heroTagline = document.querySelector<HTMLElement>('[data-transicao-tagline]');
    const heroValores = document.querySelector<HTMLElement>('[data-transicao-valores]');

    const temTransicaoHero = !!(transicaoHero && heroPainel && heroSilhueta && heroLogo && heroTagline && heroValores);

    // power3.out — o mesmo easing do resto do site.
    const suavizar = (t: number) => 1 - Math.pow(1 - t, 3);
    // Progresso LOCAL de uma fase, normalizado e suavizado.
    const faseLocal = (p: number, inicio: number, fim: number) =>
      suavizar(Math.min(Math.max((p - inicio) / (fim - inicio), 0), 1));

    // Guardado entre quadros: a cor da barra do topo depende de saber se o
    // painel já cobriu a tela.
    let progressoHero = 0;

    function atualizarTransicaoHero() {
      if (!temTransicaoHero) return;

      const rect = transicaoHero!.getBoundingClientRect();
      const util = rect.height - window.innerHeight;
      if (util <= 0) return;
      // p = clamp((scrollY − topoDaSecao) / (alturaDaSecao − innerHeight), 0, 1)
      progressoHero = Math.min(Math.max(-rect.top / util, 0), 1);
      const p = progressoHero;

      // Fase 1 — o painel entra pela direita.
      const fPainel = faseLocal(p, 0, 0.35);
      heroPainel!.style.transform = `translateX(${(1 - fPainel) * 100}%)`;

      // Fase 2 — o logo aparece por transparência, sem deslocamento.
      heroLogo!.style.opacity = String(faseLocal(p, 0.35, 0.52));

      // Fase 3 — a silhueta entra de FORA da tela, pela direita.
      // O JS manda só o fator normalizado (1 = fora, 0 = no lugar); quem
      // traduz isso em distância é o CSS, em vw, porque o quanto ela
      // precisa andar depende da largura da tela e do repouso de cada
      // breakpoint. Mandar uma % daqui foi o que a deixava meio visível.
      const fSilhueta = faseLocal(p, 0.52, 0.72);
      heroSilhueta!.style.setProperty('--silhueta-entrada', String(1 - fSilhueta));

      // Fase 4 — as três palavras.
      heroValores!.style.opacity = String(faseLocal(p, 0.72, 0.84));

      // Fase 5 — a procedência entra pela esquerda, por último.
      const fTagline = faseLocal(p, 0.84, 1);
      heroTagline!.style.opacity = String(fTagline);
      heroTagline!.style.transform = `translateX(${(1 - fTagline) * -40}%)`;
    }

    // Estado inicial da sequência. Só aqui — nunca no CSS.
    if (temTransicaoHero) atualizarTransicaoHero();

    // O hero da home — só existe em "/"; nas demais páginas os
    // querySelectors retornam null e o bloco não faz nada.
    //
    // A BARRA DO TOPO é fixed e mora fora do wrapper do hero: sem isto ela
    // ficaria uma barra clara por cima do hero escuro.
    //
    // É CORTE LIMPO, sem interpolação: escura enquanto o mundo escuro ainda
    // cobre a barra, clara a partir daí. Durante a transição o fundo atrás
    // do painel continua sendo o mundo escuro até o painel cobrir a tela
    // (fim da fase 1), então a barra só clareia nesse ponto.
    const heroEstagio1 = document.querySelector<HTMLElement>('[data-hero-estagio1]');
    const alturaBarraHeader = document.querySelector<HTMLElement>('[data-header]')?.offsetHeight ?? 0;

    // A PALETA ESCURA NÃO MORA MAIS AQUI. Ela é a classe `topo-escuro` no
    // <html>, definida em global.css e renderizada já no build pela prop
    // `topoEscuro` do BaseLayout. Este bloco só ALTERNA a classe conforme o
    // scroll — nenhum estilo visual depende deste script para o primeiro
    // paint. Antes as seis variáveis eram escritas em
    // document.documentElement daqui, e o header e o botão de WhatsApp
    // nasciam claros sobre o hero escuro por 164ms no mobile / 270ms no
    // desktop: era esse o flash.
    const raiz = document.documentElement;
    // Semeado com o que veio do HTML, pra primeira passada não reescrever
    // um estado que já está correto.
    let barraEscura: boolean | null = raiz.classList.contains('topo-escuro') ? true : null;

    function atualizarCorDaBarra() {
      if (!heroEstagio1) return;
      let escura = heroEstagio1.getBoundingClientRect().bottom > alturaBarraHeader;

      if (!escura && temTransicaoHero) {
        const r = transicaoHero!.getBoundingClientRect();
        const cobreABarra = r.top <= alturaBarraHeader && r.bottom > alturaBarraHeader;
        // 0.35 é o fim da fase 1: antes disso o painel claro ainda não
        // chegou à borda esquerda e o que está sob a barra é o mundo escuro.
        if (cobreABarra && progressoHero < 0.35) escura = true;
      }

      if (escura === barraEscura) return;
      barraEscura = escura;
      raiz.classList.toggle('topo-escuro', escura);
    }

    function atualizarTransicaoDiaNoite() {
      // A ordem importa: a cor da barra depende do progresso calculado em
      // atualizarTransicaoHero().
      atualizarTransicaoHero();
      atualizarCorDaBarra();
      if (!transicao || !mundoDinamico) return;

      const rect = transicao.getBoundingClientRect();
      const progresso = Math.min(Math.max(-rect.top / rect.height, 0), 1);

      // As mesmas cores vão para o wrapper E para a raiz. O wrapper cobre o
      // conteúdo da página; a raiz alcança quem vive FORA dele — header,
      // rodapé e botão flutuante de WhatsApp. Sem isso o rodapé continuava
      // em `--surface` claro depois que a página já tinha chegado ao
      // #020202: a mesma borda dura que a camada única resolveu no miolo,
      // só que no pé. Escrever nos dois é redundante de propósito — o
      // repouso sem JS do wrapper vem do style inline dele, e a raiz não
      // pode herdar isso.
      for (const propriedade in paresDeCor) {
        const [claro, escuro] = paresDeCor[propriedade];
        const cor = interpolarCor(claro, escuro, progresso);
        mundoDinamico.style.setProperty(propriedade, cor);
        document.documentElement.style.setProperty(propriedade, cor);
      }

      // Cortina de luz como ambiente: rampa de entrada nos primeiros 15% do
      // progresso, platô, e rampa de saída nos últimos 15%. Teto em 0.5.
      const rampa = Math.min(progresso / 0.15, 1, (1 - progresso) / 0.15);
      mundoDinamico!.style.setProperty('--cortina-op', (Math.max(rampa, 0) * 0.5).toFixed(3));

      pontosLuz.forEach((ponto, indice) => {
        const limiar = indice / pontosLuz.length;
        const opacidadeAlvo = progresso > limiar ? Math.min((progresso - limiar) * 4, 1) : 0;
        ponto.style.opacity = String(opacidadeAlvo);
      });
    }

    // Header some ao descer, aparece ao subir (ver CLAUDE.md > Navegação).
    const header = document.querySelector<HTMLElement>('[data-header]');
    let ultimoScrollY = window.scrollY;

    let ticking = false;

    function atualizar() {
      ticking = false;
      const scrollY = window.scrollY;
      const alturaJanela = window.innerHeight;
      const alturaDocumento = document.documentElement.scrollHeight - alturaJanela;
      const progresso = alturaDocumento > 0 ? scrollY / alturaDocumento : 0;

      if (chevron) {
        chevron.setAttribute('data-oculto', scrollY > 40 ? 'true' : 'false');
      }

      if (estrada) {
        estrada.setAttribute('data-visivel', scrollY > alturaJanela * 0.6 ? 'true' : 'false');
      }

      if (marcador) {
        marcador.style.top = `${Math.min(Math.max(progresso, 0), 1) * 100}%`;
      }

      if (header && !reduzMovimento) {
        const delta = scrollY - ultimoScrollY;
        if (scrollY <= 0) {
          header.setAttribute('data-oculto', 'false');
          ultimoScrollY = scrollY;
        } else if (Math.abs(delta) > 8) {
          header.setAttribute('data-oculto', delta > 0 ? 'true' : 'false');
          ultimoScrollY = scrollY;
        }
      }

      if (!reduzMovimento) {
        atualizarTransicaoDiaNoite();
      }
    }

    function aoRolar() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(atualizar);
      }
    }

    atualizar();
    window.addEventListener('scroll', aoRolar, { passive: true });
    window.addEventListener('resize', aoRolar);
  }

  // 6) Âncoras internas — destino pela posição de LAYOUT -------------------
  //
  // O BUG QUE ISTO CORRIGE: o navegador calcula o destino de uma âncora pela
  // posição VISUAL do alvo no instante do clique. Se o alvo ainda está em
  // `reveal--preparado`, ele carrega translateY(56px) — o destino sai 56px
  // mais baixo, e quando a revelação dispara a seção sobe e o
  // `scroll-margin-top` acaba valendo 16px em vez dos 72 pedidos. Medido em
  // /limousines/#sedan: alvo calculado 3555, mas o alvo assentado era 3499.
  //
  // A correção não espera a revelação: usa `offsetTop`, que é LAYOUT e ignora
  // transform. Somando a cadeia de offsetParent temos a posição já assentada,
  // qualquer que seja o estado da animação.
  function topoDeLayout(el: HTMLElement) {
    let y = 0;
    let no: HTMLElement | null = el;
    while (no) {
      y += no.offsetTop;
      no = no.offsetParent as HTMLElement | null;
    }
    return y;
  }

  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (evento) => {
      const id = link.hash.slice(1);
      if (!id) return;
      const alvo = document.getElementById(id);
      if (!alvo) return;

      evento.preventDefault();
      const margem = parseFloat(getComputedStyle(alvo).scrollMarginTop) || 0;
      window.scrollTo({
        top: Math.max(0, topoDeLayout(alvo) - margem),
        behavior: reduzMovimento ? 'auto' : 'smooth',
      });

      // A URL continua mostrando a âncora — é ela que o visitante copia e
      // compartilha. `pushState` em vez de `location.hash` porque o hash
      // nativo dispara o salto que acabamos de substituir.
      history.pushState(null, '', link.hash);

      // Sem isto o teclado continuaria no botão: o salto nativo movia o foco
      // e o preventDefault tirou esse efeito. `preventScroll` para não
      // desfazer o scroll suave que acabou de começar.
      alvo.setAttribute('tabindex', '-1');
      alvo.focus({ preventScroll: true });
    });
  });

  // 2) Scroll suave com Lenis — só desktop, só sem reduced-motion ---------
  const ehDesktop = window.matchMedia('(min-width: 56rem)').matches;

  if (ehDesktop && !reduzMovimento) {
    import('lenis').then(({ default: Lenis }) => {
      // O scrub NÃO recebe amortecimento próprio: o Lenis já suaviza a
      // posição de scroll que `atualizarTransicaoHero()` lê via
      // getBoundingClientRect(). Amortecer de novo no scrub empilharia dois
      // filtros e deixaria a sequência borrachuda.
      const lenis = new Lenis({
        // PESO — tempo até o scroll assentar depois de uma rolada.
        //   0.1   padrão da biblioteca ·  ~970ms   (derivado)
        //   0.075                      · ~1310ms   (derivado)
        //   0.064 ATUAL                ·  1541ms   MEDIDO
        //   0.059                      ·  1670ms   MEDIDO
        //   0.05                       · ~1990ms   (derivado)
        //
        // MEDIR EM MILISSEGUNDOS DE RELÓGIO, NUNCA EM QUADROS. O lerp do Lenis
        // é corrigido por delta de tempo, então sob carga a contagem de quadros
        // varia (medi 82 a 92 quadros para este mesmo valor) enquanto o tempo
        // real fica estável (1509–1549ms em sete amostras). Contar quadros me
        // fez rejeitar o 0.064 uma vez por engano.
        // Método: evento de roda com deltaY 600 em 1440x900, mediana de 7,
        // "assentou" = 10 quadros consecutivos com menos de 0,5px de variação.
        //
        // Para converter: ms ≈ 102 / −ln(1 − lerp). A lei reproduz os dois
        // pontos medidos com erro abaixo de 0,5%, e é dela que vêm os valores
        // marcados como derivados. Diminuir o lerp aumenta o deslize; a
        // DISTÂNCIA por rolada não muda (quem manda nela é o wheelMultiplier).
        lerp: 0.064,
        wheelMultiplier: 0.9,
        smoothWheel: true,
        syncTouch: false,
      });

      function rafLenis(time: number) {
        lenis.raf(time);
        requestAnimationFrame(rafLenis);
      }

      requestAnimationFrame(rafLenis);
    });
  }
</script>
