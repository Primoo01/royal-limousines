---
// Movimento do site inteiro (ver CLAUDE.md > Movimento):
// 1) revelações no scroll (IntersectionObserver + classe .reveal)
// 2) scroll suave com Lenis, só desktop, só sem prefers-reduced-motion
// 3) chevron do hero, que some ao rolar
// 4) indicador "estrada" com as seções como paradas
// Um único componente, incluído uma vez no BaseLayout, pra manter o
// JavaScript do site inteiro fácil de auditar num só lugar.
---

<!--
  Puramente decorativo — não faz nada ao ser ativado, então não pode ser
  focável nem exposto a leitor de tela (senão é foco de teclado que não leva
  a lugar nenhum). Dar comportamento a ele é tarefa separada, futura.
-->
<div class="chevron-scroll" data-chevron aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="M4 9l8 8 8-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</div>

<nav class="estrada" data-estrada aria-hidden="true">
  <div class="estrada__linha">
    <span class="estrada__marcador" data-estrada-marcador></span>
  </div>
</nav>

<style>
  .chevron-scroll {
    position: fixed;
    bottom: var(--espaco-4);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-indicadores);
    color: var(--ouro);
    pointer-events: none;
    padding: var(--espaco-1);
    opacity: 1;
    transition: opacity 0.4s ease;
    animation: chevron-flutuar 1.8s ease-in-out infinite;
  }

  .chevron-scroll[data-oculto='true'] {
    opacity: 0;
  }

  @keyframes chevron-flutuar {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(8px);
    }
  }

  .estrada {
    position: fixed;
    left: var(--espaco-3);
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--z-indicadores);
    height: 40vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .estrada[data-visivel='true'] {
    opacity: 1;
  }

  .estrada__linha {
    position: relative;
    width: 1px;
    height: 100%;
    background-color: var(--linha);
  }

  .estrada__marcador {
    position: absolute;
    left: 50%;
    top: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--ouro);
    transform: translate(-50%, -50%);
  }

  .estrada__parada {
    position: absolute;
    left: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: var(--linha);
    transform: translate(-50%, -50%);
  }

  @media (max-width: 56rem) {
    .estrada {
      display: none;
    }

    /* O chevron continua visível no hero da home: o bloco de conteúdo do
       Estágio 1 reserva folga na base da primeira tela (ver ConteudoHome),
       então ele pousa em área livre em vez de cair por cima da mídia. */
  }

  /* No hero da home em desktop, o chevron sai do centro. O marquee ocupa a
     metade ESQUERDA da faixa inferior e nada pode se sobrepor a ele; como o
     chevron é fixo na viewport e a seção pode ficar mais alta que a tela,
     não existe altura em que ele fique garantidamente abaixo da faixa.
     Deslocá-lo pra metade direita resolve por geometria, em qualquer altura
     de tela, e ele continua ancorado à base. */
  @media (min-width: 56.25rem) {
    body:has([data-hero-estagio1]) .chevron-scroll {
      left: 75%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron-scroll {
      animation: none;
    }
  }
</style>

<script>
  const chevron = document.querySelector<HTMLElement>('[data-chevron]');
  const estrada = document.querySelector<HTMLElement>('[data-estrada]');
  const marcador = document.querySelector<HTMLElement>('[data-estrada-marcador]');
  const linha = document.querySelector<HTMLElement>('.estrada__linha');

  const reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1) Revelação no scroll ------------------------------------------------
  // .reveal (seções) e .reveal-grupo (escalonamento entre irmãos).
  //
  // Mesma regra de segurança do vocabulário de entrada: o conteúdo é visível
  // por padrão no CSS, e o JS só PREPARA (esconde) elementos que ainda não
  // entraram na viewport. Quem já está visível no carregamento não é tocado.
  // Se o JS não rodar, nada fica permanentemente invisível.
  function proporcaoVisivel(el: HTMLElement) {
    const rect = el.getBoundingClientRect();
    const alturaVisivel = Math.max(0, Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0));
    return rect.height > 0 ? alturaVisivel / rect.height : 0;
  }

  const elementosReveal = Array.from(document.querySelectorAll<HTMLElement>('.reveal, .reveal-grupo'));

  // Com prefers-reduced-motion, ou sem IntersectionObserver, não há nada a
  // fazer aqui: o conteúdo já nasce visível.
  if (!reduzMovimento && 'IntersectionObserver' in window) {
    // O mesmo limiar do observer abaixo, pra não preparar um elemento que o
    // observer já consideraria visível (o que o deixaria escondido até o
    // próximo scroll).
    const revealPendentes = elementosReveal.filter((el) => proporcaoVisivel(el) < 0.15);

    revealPendentes.forEach((el) => {
      // Força o navegador a "commitar" o estado atual (visível, sem classe)
      // antes de aplicar a que traz opacity:0 + transition no mesmo
      // elemento — sem isso a mudança pode não virar uma transição de fato.
      void el.getBoundingClientRect();
      el.classList.add('reveal--preparado');
    });

    const observer = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            entrada.target.classList.remove('reveal--preparado');
            entrada.target.classList.add('reveal--visivel');
            observer.unobserve(entrada.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );

    revealPendentes.forEach((el) => observer.observe(el));

    // 1b) Vocabulário de entrada (ver EntradaTitulo.astro) -----------------
    // Regra de segurança (CLAUDE.md > Vocabulário de entrada): o texto é
    // visível por padrão no CSS. Só elementos que ainda NÃO estão na
    // viewport no carregamento recebem a classe que os prepara pra animar
    // (escondidos). Os que já estão visíveis nunca são tocados — se o JS
    // falhar ou demorar, nada fica invisível. Diferente do antigo
    // reveal-titulo, o elemento observado aqui nunca tem clip-path nele
    // mesmo (só opacity/transform num filho), então não repete o impasse
    // de interseção sempre-zero que esse clip-path causava no Chromium.
    const entradaPendentes = Array.from(document.querySelectorAll<HTMLElement>('.entrada')).filter(
      (el) => proporcaoVisivel(el) < 0.35
    );
    entradaPendentes.forEach((el) => {
      // Força o navegador a "commitar" o estado atual (visível, sem a
      // classe) antes de aplicar a classe que traz opacity:0 + transition
      // no mesmo elemento — sem isso, a mudança pode não ser reconhecida
      // como uma transição de verdade.
      void el.getBoundingClientRect();
      el.classList.add('entrada--preparado');
    });

    if (entradaPendentes.length) {
      const entradaObserver = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (entrada.isIntersecting) {
              entrada.target.classList.remove('entrada--preparado');
              entrada.target.classList.add('entrada--visivel');
              entradaObserver.unobserve(entrada.target);
            }
          });
        },
        { threshold: 0.35 }
      );
      entradaPendentes.forEach((el) => entradaObserver.observe(el));
    }

    // 1b-bis) Wordmark do Estágio 2 (ver Wordmark.astro) -------------------
    // Mesma regra de segurança: visível por padrão, o JS só prepara quem
    // ainda não entrou na viewport. O clip-path fica no filho — aplicá-lo no
    // próprio elemento observado faz o Chromium calcular interseção sempre
    // zero, e o observer nunca dispararia.
    const wordmark = document.querySelector<HTMLElement>('[data-wordmark]');
    const wordmarkDepois = document.querySelector<HTMLElement>('[data-wordmark-depois]');
    // Terceiro degrau: as três palavras do Hero 2, que entram depois da
    // tagline (ver CLAUDE.md > Hero 2).
    const wordmarkDepois2 = document.querySelector<HTMLElement>('[data-wordmark-depois-2]');

    if (wordmark && proporcaoVisivel(wordmark) < 0.35) {
      void wordmark.getBoundingClientRect();
      wordmark.classList.add('wordmark--preparado');
      if (wordmarkDepois) {
        void wordmarkDepois.getBoundingClientRect();
        wordmarkDepois.classList.add('wordmark-depois--preparado');
      }
      if (wordmarkDepois2) {
        void wordmarkDepois2.getBoundingClientRect();
        wordmarkDepois2.classList.add('wordmark-depois--preparado');
      }

      const wordmarkObserver = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (!entrada.isIntersecting) return;
            const alvo = entrada.target as HTMLElement;
            const texto = alvo.querySelector<HTMLElement>('.wordmark__texto');
            alvo.classList.add('wordmark--visivel');

            // A tagline entra DEPOIS que a máscara termina de abrir — é a
            // procedência sustentando a marca, por isso vem por último.
            if (wordmarkDepois && texto) {
              const aoTerminar = (evento: TransitionEvent) => {
                if (evento.propertyName !== 'clip-path') return;
                void wordmarkDepois.getBoundingClientRect();
                wordmarkDepois.classList.add('wordmark-depois--visivel');
                // E as três palavras depois DELA, encadeadas na mesma
                // transição — a assinatura inteira antes dos valores.
                if (wordmarkDepois2) {
                  const aoTerminarTagline = (e: TransitionEvent) => {
                    if (e.propertyName !== 'opacity') return;
                    void wordmarkDepois2.getBoundingClientRect();
                    wordmarkDepois2.classList.add('wordmark-depois--visivel');
                    wordmarkDepois.removeEventListener('transitionend', aoTerminarTagline);
                  };
                  wordmarkDepois.addEventListener('transitionend', aoTerminarTagline);
                }
                texto.removeEventListener('transitionend', aoTerminar);
              };
              texto.addEventListener('transitionend', aoTerminar);
            }
            wordmarkObserver.unobserve(alvo);
          });
        },
        { threshold: 0.35 }
      );
      wordmarkObserver.observe(wordmark);
    }

    // 1c) Linha que se desenha (ver LinhaDesenhada.astro) -------------------
    // Mesma regra de segurança: sem dasharray/dashoffset definidos, a curva
    // aparece inteira; o ponto some só quando o JS prepara o elemento.
    const linhasPendentes = Array.from(document.querySelectorAll<HTMLElement>('[data-linha-desenhada]')).filter(
      (el) => proporcaoVisivel(el) < 0.5
    );

    linhasPendentes.forEach((container) => {
      const path = container.querySelector<SVGPathElement>('.linha-desenhada__curva');
      if (!path) return;
      const comprimento = path.getTotalLength();
      // .style, não setAttribute: transition só anima de forma confiável um
      // valor que já veio da cascata CSS — um valor só de atributo de
      // apresentação SVG não conta como estado "de onde" para o motor de
      // transição em alguns casos. E precisa de unidade (px): um número puro
      // é sintaxe CSS inválida e é ignorado silenciosamente. "px" aqui é
      // resolvido nas mesmas user units do sistema de coordenadas do path —
      // o mesmo que getTotalLength() usa — não pixels de tela.
      path.style.strokeDasharray = `${comprimento}px`;
      path.style.strokeDashoffset = `${comprimento}px`;
      // Força o navegador a "commitar" esse estado antes de aplicar a classe
      // — a leitura precisa ser no MESMO elemento que vai receber a classe
      // (o container, que também esconde o ponto via opacity+transition),
      // não em qualquer elemento do documento.
      void container.getBoundingClientRect();
      container.classList.add('linha-desenhada--preparada');
    });

    if (linhasPendentes.length) {
      const linhaObserver = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (!entrada.isIntersecting) return;
            const container = entrada.target as HTMLElement;
            const path = container.querySelector<SVGPathElement>('.linha-desenhada__curva');
            const ponto = container.querySelector<HTMLElement>('[data-linha-ponto]');
            // Mantém a classe "preparada" — é ela quem carrega a regra de
            // transition; removê-la agora tiraria o tapete da transição que
            // está prestes a começar. O ponto usa uma classe própria
            // (--visivel) por cima dela pra chegar ao estado final.
            if (path) {
              path.style.strokeDashoffset = '0px';
              const aoTerminar = (evento: TransitionEvent) => {
                if (evento.propertyName !== 'stroke-dashoffset') return;
                if (ponto) {
                  void ponto.getBoundingClientRect();
                  ponto.classList.add('linha-desenhada__ponto--visivel');
                }
                path.removeEventListener('transitionend', aoTerminar);
              };
              path.addEventListener('transitionend', aoTerminar);
            }
            linhaObserver.unobserve(container);
          });
        },
        { threshold: 0.5 }
      );
      linhasPendentes.forEach((el) => linhaObserver.observe(el));
    }
  }

  // 3) e 4) Chevron + estrada ----------------------------------------------
  if (chevron || estrada) {
    // Paradas da estrada: uma por <section> dentro de <main> (inclui as que
    // estão dentro do wrapper .mundo-dinamico em /limousines/).
    const secoes = Array.from(document.querySelectorAll<HTMLElement>('main section'));
    if (linha && secoes.length > 1) {
      const alturaDocumento = document.documentElement.scrollHeight - window.innerHeight;
      secoes.forEach((secao) => {
        if (alturaDocumento <= 0) return;
        const proporcao = (secao.offsetTop / alturaDocumento) * 100;
        const parada = document.createElement('span');
        parada.className = 'estrada__parada';
        parada.style.top = `${Math.min(Math.max(proporcao, 0), 100)}%`;
        linha.appendChild(parada);
      });
    }

    // 5) Transição dia→noite em /limousines/ — só existe nessa página;
    // nas demais, estes querySelectors retornam null e o bloco não faz nada.
    const transicao = document.querySelector<HTMLElement>('[data-transicao-dia-noite]');
    const mundoDinamico = document.querySelector<HTMLElement>('[data-mundo-dinamico]');
    const pontosLuz = transicao ? Array.from(transicao.querySelectorAll<HTMLElement>('.ponto-luz')) : [];

    // Mesmos pares de cor do global.css (claro → escuro). Precisa ficar em
    // sincronia se a paleta mudar por lá.
    const paresDeCor: Record<string, [string, string]> = {
      '--bg': ['#f4f1eb', '#141210'],
      '--surface': ['#e7e0d4', '#211e18'],
      '--linha': ['#cfc6b5', '#3a342a'],
      '--texto': ['#1a1815', '#ede7db'],
      '--texto-mut': ['#8a8578', '#8c857a'],
      '--ouro': ['#a8823c', '#c6a25e'],
    };

    function hexParaRgb(hex: string): [number, number, number] {
      const valor = parseInt(hex.slice(1), 16);
      return [(valor >> 16) & 255, (valor >> 8) & 255, valor & 255];
    }

    function interpolarCor(hexClaro: string, hexEscuro: string, t: number): string {
      const [r1, g1, b1] = hexParaRgb(hexClaro);
      const [r2, g2, b2] = hexParaRgb(hexEscuro);
      const r = Math.round(r1 + (r2 - r1) * t);
      const g = Math.round(g1 + (g2 - g1) * t);
      const b = Math.round(b1 + (b2 - b1) * t);
      return `rgb(${r}, ${g}, ${b})`;
    }


    // O hero da home — só existe em "/"; nas demais páginas os
    // querySelectors retornam null e o bloco não faz nada.
    //
    // A passagem INTERPOLADA (fundo do escuro pro claro + mídia crescendo)
    // saiu: quem faz a travessia do Hero 1 pro Hero 2 agora é a revelação em
    // persianas (ver Persianas.astro e CLAUDE.md). O que sobra aqui é só a
    // cor da BARRA DO TOPO, que é fixed e mora fora do wrapper do hero: sem
    // isto ela ficaria uma barra clara por cima do hero escuro.
    //
    // É CORTE LIMPO, sem interpolação: escuro enquanto o hero ainda cobre a
    // barra, claro a partir do momento em que ele sai de baixo dela. A
    // transição visual agora é a persiana; um fade de cor por baixo dela só
    // competiria.
    const heroEstagio1 = document.querySelector<HTMLElement>('[data-hero-estagio1]');
    const alturaBarraHeader = document.querySelector<HTMLElement>('[data-header]')?.offsetHeight ?? 0;
    const paletaEscura: Record<string, string> = {
      '--bg': '#141210',
      '--surface': '#211e18',
      '--linha': '#3a342a',
      '--texto': '#ede7db',
      '--texto-mut': '#8c857a',
      '--ouro': '#c6a25e',
    };
    let barraEscura: boolean | null = null;

    function atualizarCorDaBarra() {
      if (!heroEstagio1) return;
      const escura = heroEstagio1.getBoundingClientRect().bottom > alturaBarraHeader;
      if (escura === barraEscura) return;
      barraEscura = escura;
      const raiz = document.documentElement;
      for (const propriedade in paletaEscura) {
        if (escura) raiz.style.setProperty(propriedade, paletaEscura[propriedade]);
        else raiz.style.removeProperty(propriedade);
      }
    }

    function atualizarTransicaoDiaNoite() {
      atualizarCorDaBarra();
      if (!transicao || !mundoDinamico) return;

      const rect = transicao.getBoundingClientRect();
      const progresso = Math.min(Math.max(-rect.top / rect.height, 0), 1);

      for (const propriedade in paresDeCor) {
        const [claro, escuro] = paresDeCor[propriedade];
        mundoDinamico.style.setProperty(propriedade, interpolarCor(claro, escuro, progresso));
      }

      pontosLuz.forEach((ponto, indice) => {
        const limiar = indice / pontosLuz.length;
        const opacidadeAlvo = progresso > limiar ? Math.min((progresso - limiar) * 4, 1) : 0;
        ponto.style.opacity = String(opacidadeAlvo);
      });
    }

    // Galeria horizontal por scroll (ver Carrossel.astro).
    //
    // O "prender na tela" é o `position: sticky` do painel, CSS puro — não
    // existe pin em JavaScript aqui. O que este bloco faz é só:
    //
    //   1. MEDIR a tira e escrever a altura do trilho:
    //        distancia = trilho.scrollWidth - painel.clientWidth
    //        altura    = innerHeight + distancia
    //   2. CONVERTER scroll vertical em translateX, sem interpolação.
    //
    // Como a altura útil do spacer (altura - innerHeight) é exatamente
    // `distancia`, 1px de scroll vale 1px de deslocamento. A tira termina no
    // mesmo instante em que o sticky solta. A suavidade vem do Lenis.
    //
    // O modo conduzido é OPT-IN: sem ele o CSS deixa a tira em rolagem
    // horizontal nativa, então nenhuma foto fica inalcançável se o JS falhar.
    const mediaGaleriaConduzida = window.matchMedia('(min-width: 56.25rem)');
    const atualizarCarrosseis: Array<() => void> = [];

    document.querySelectorAll<HTMLElement>('[data-carrossel]').forEach((raiz) => {
      const spacer = raiz.querySelector<HTMLElement>('[data-carrossel-spacer]');
      const painel = raiz.querySelector<HTMLElement>('[data-carrossel-painel]');
      const trilho = raiz.querySelector<HTMLElement>('[data-carrossel-trilho]');
      const slides = Array.from(raiz.querySelectorAll<HTMLElement>('[data-carrossel-slide]'));
      const botaoAnterior = raiz.querySelector<HTMLButtonElement>('[data-carrossel-anterior]');
      const botaoProximo = raiz.querySelector<HTMLButtonElement>('[data-carrossel-proximo]');
      if (!spacer || !painel || !trilho || slides.length === 0) return;

      let distancia = 0;
      let conduzido = false;

      function aplicar() {
        if (!conduzido || distancia <= 0) return;
        // Uma única leitura de layout por frame. Todo o resto vem do cache
        // preenchido em medir().
        const topo = spacer!.getBoundingClientRect().top;
        const deslocamento = Math.min(Math.max(-topo, 0), distancia);
        trilho!.style.transform = `translate3d(${-deslocamento}px, 0, 0)`;
      }

      function medir() {
        if (!conduzido) {
          spacer!.style.height = '';
          trilho!.style.transform = '';
          distancia = 0;
          return;
        }
        // scrollWidth já inclui os gaps e o padding-inline do trilho. O
        // transform que aplicamos não afeta layout, então pode ser lido a
        // qualquer momento sem realimentar a conta.
        distancia = Math.max(0, trilho!.scrollWidth - painel!.clientWidth);
        const altura = window.innerHeight + distancia;
        // Só escreve se mudou de verdade: escrever a altura muda a altura do
        // documento, que em tese pode mexer na barra de rolagem e disparar o
        // ResizeObserver de novo. O limiar de 1px corta qualquer oscilação.
        if (Math.abs(parseFloat(spacer!.style.height || '0') - altura) > 1) {
          spacer!.style.height = `${altura}px`;
        }
        aplicar();
      }

      function avaliarModo() {
        const novo = mediaGaleriaConduzida.matches && !reduzMovimento;
        if (novo === conduzido) return;
        conduzido = novo;
        raiz.setAttribute('data-conduzido', String(conduzido));
      }

      avaliarModo();
      medir();
      atualizarCarrosseis.push(aplicar);

      // Recalcula quando a TIRA muda de tamanho por qualquer motivo: imagem
      // que terminou de carregar, fonte que trocou, layout que mexeu. É esta
      // linha que resolve o "medir antes das imagens carregarem dá conta
      // errada" — em vez de escutar o load de cada <img> e torcer pra não
      // esquecer nenhuma, observamos a consequência.
      new ResizeObserver(() => medir()).observe(trilho);

      // O observer acima não enxerga mudança de innerHeight, e ela entra na
      // altura do spacer. O resize também pode atravessar o breakpoint.
      window.addEventListener('resize', () => {
        avaliarModo();
        medir();
      });
      window.addEventListener('load', () => medir());

      // --- Setas ---
      // Passo de um slide pro próximo (largura + gap), medido do layout.
      const passo = () => (slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : 0);

      function indiceAtual() {
        const p = passo();
        if (p <= 0) return 0;
        const topo = spacer!.getBoundingClientRect().top;
        const deslocamento = Math.min(Math.max(-topo, 0), distancia);
        return Math.round(deslocamento / p);
      }

      function irPara(indice: number) {
        const alvo = Math.min(Math.max(indice, 0), slides.length - 1);

        if (!conduzido) {
          // Rolagem nativa: empurra o próprio trilho, sem tocar na página.
          const comportamento: ScrollBehavior = reduzMovimento ? 'auto' : 'smooth';
          trilho!.scrollTo({ left: alvo * (passo() || trilho!.clientWidth * 0.9), behavior: comportamento });
          return;
        }

        // No modo conduzido quem manda é o scroll da página. Como o
        // mapeamento é 1:1, a posição de scroll do slide `alvo` é
        // simplesmente o topo do spacer mais o deslocamento desejado.
        const deslocamento = Math.min(alvo * passo(), distancia);
        const topoSpacer = spacer!.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: topoSpacer + deslocamento, behavior: 'smooth' });
      }

      botaoAnterior?.addEventListener('click', () => irPara(indiceAtual() - 1));
      botaoProximo?.addEventListener('click', () => irPara(indiceAtual() + 1));

      // Acessível por teclado: setas ← → tanto no trilho focado quanto nos
      // próprios botões.
      const aoTeclar = (evento: KeyboardEvent) => {
        if (evento.key === 'ArrowLeft') {
          evento.preventDefault();
          irPara(indiceAtual() - 1);
        } else if (evento.key === 'ArrowRight') {
          evento.preventDefault();
          irPara(indiceAtual() + 1);
        }
      };
      trilho.addEventListener('keydown', aoTeclar);
      botaoAnterior?.addEventListener('keydown', aoTeclar);
      botaoProximo?.addEventListener('keydown', aoTeclar);
    });

    // Header some ao descer, aparece ao subir (ver CLAUDE.md > Navegação).
    const header = document.querySelector<HTMLElement>('[data-header]');
    let ultimoScrollY = window.scrollY;

    let ticking = false;

    function atualizar() {
      ticking = false;
      const scrollY = window.scrollY;
      const alturaJanela = window.innerHeight;
      const alturaDocumento = document.documentElement.scrollHeight - alturaJanela;
      const progresso = alturaDocumento > 0 ? scrollY / alturaDocumento : 0;

      if (chevron) {
        chevron.setAttribute('data-oculto', scrollY > 40 ? 'true' : 'false');
      }

      if (estrada) {
        estrada.setAttribute('data-visivel', scrollY > alturaJanela * 0.6 ? 'true' : 'false');
      }

      if (marcador) {
        marcador.style.top = `${Math.min(Math.max(progresso, 0), 1) * 100}%`;
      }

      if (header && !reduzMovimento) {
        const delta = scrollY - ultimoScrollY;
        if (scrollY <= 0) {
          header.setAttribute('data-oculto', 'false');
          ultimoScrollY = scrollY;
        } else if (Math.abs(delta) > 8) {
          header.setAttribute('data-oculto', delta > 0 ? 'true' : 'false');
          ultimoScrollY = scrollY;
        }
      }

      if (!reduzMovimento) {
        atualizarTransicaoDiaNoite();
        atualizarCarrosseis.forEach((fn) => fn());
      }
    }

    function aoRolar() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(atualizar);
      }
    }

    atualizar();
    window.addEventListener('scroll', aoRolar, { passive: true });
    window.addEventListener('resize', aoRolar);

    // 6) Persianas horizontais (ver Persianas.astro e CLAUDE.md) -----------
    //
    // O progresso do scroll NÃO vai direto pra máscara: passa por um arrasto
    // (atual += (alvo - atual) * 0.12) dentro de um rAF próprio. É esse
    // rastro que faz o efeito parecer físico — é o que o scrub do
    // ScrollTrigger dava de graça na referência, aqui em quatro linhas.
    const persianas = document.querySelector<HTMLElement>('[data-persianas]');

    if (persianas) {
      const svg = persianas.querySelector<SVGSVGElement>('[data-persianas-svg]');
      const fundo = persianas.querySelector<SVGRectElement>('[data-persianas-fundo]');
      const imagem = persianas.querySelector<SVGImageElement>('[data-persianas-imagem]');
      const rects = Array.from(persianas.querySelectorAll<SVGRectElement>('[data-persiana]'));
      const PARES = rects.length / 2;

      // Defasagem: passo de 0,02 por par, duração 1 por par, normalizado pra
      // que o ÚLTIMO par termine exatamente em progresso 1.
      const PASSO = 0.02;
      const DURACAO = 1;
      const TOTAL = DURACAO + (PARES - 1) * PASSO;

      let vbHeight = 0;

      function medirViewBox() {
        // Unidades virtuais: largura sempre 100, altura proporcional à tela.
        // É isso que mantém a conta consistente em qualquer resolução.
        vbHeight = (window.innerHeight / window.innerWidth) * 100;
        svg!.setAttribute('viewBox', `0 0 100 ${vbHeight}`);
        fundo!.setAttribute('height', String(vbHeight));
        imagem!.setAttribute('height', String(vbHeight));
        const mascara = svg!.querySelector('mask');
        mascara?.setAttribute('height', String(vbHeight));
      }

      function aplicar(progresso: number) {
        const h = vbHeight / PARES;
        const meia = h / 2;
        for (let i = 0; i < PARES; i++) {
          // De baixo pra cima: o par 0 é o mais próximo da base.
          const centerY = vbHeight - (i * h + meia);
          const inicio = (i * PASSO) / TOTAL;
          const fim = (i * PASSO + DURACAO) / TOTAL;
          const bruto = Math.min(Math.max((progresso - inicio) / (fim - inicio), 0), 1);
          // power3.out
          const t = 1 - Math.pow(1 - bruto, 3);

          // O +0.01 faz persianas vizinhas se sobreporem e mata os fios
          // claros de subpixel. Multiplicado por t (em vez de somado fixo)
          // pra que em repouso a altura seja exatamente 0 — somando fixo,
          // os 60 rects mostrariam um fio parado antes de a seção entrar.
          const altura = (meia + 0.01) * t;
          const cima = rects[i * 2];
          const baixo = rects[i * 2 + 1];
          // Os dois nascem na MESMA linha central e crescem em direções
          // opostas. Não é um retângulo encolhendo.
          cima.setAttribute('y', String(centerY - meia * t));
          cima.setAttribute('height', String(altura));
          baixo.setAttribute('y', String(centerY));
          baixo.setAttribute('height', String(altura));
        }
      }

      const mediaPersianasConduzidas = window.matchMedia('(min-width: 56.25rem)');
      const conduzir = () => mediaPersianasConduzidas.matches && !reduzMovimento;

      if (reduzMovimento) {
        // Sem máscara: a imagem aparece direto, como manda o CLAUDE.md.
        medirViewBox();
      } else if (!conduzir()) {
        // Mobile: sem controle por scroll. As persianas abrem TODAS juntas e
        // a imagem entra num fade curto, disparado uma vez ao entrar em cena.
        medirViewBox();
        svg!.setAttribute('mask', 'url(#persianas-mascara)');
        aplicar(1);
        persianas.setAttribute('data-fade', 'preparado');
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (!entrada.isIntersecting) return;
              persianas.setAttribute('data-fade', 'visivel');
              observador.unobserve(entrada.target);
            });
          },
          { threshold: 0.2 }
        );
        observador.observe(persianas);
        window.addEventListener('resize', () => {
          medirViewBox();
          aplicar(1);
        });
      } else {
        medirViewBox();
        svg!.setAttribute('mask', 'url(#persianas-mascara)');
        aplicar(0);

        let alvo = 0;
        let atual = 0;
        let rodando = false;

        function laco() {
          atual += (alvo - atual) * 0.12;
          if (Math.abs(alvo - atual) > 0.0001) {
            aplicar(atual);
            requestAnimationFrame(laco);
          } else {
            // Encosta no alvo e para: nada de rAF perpétuo.
            atual = alvo;
            aplicar(atual);
            rodando = false;
          }
        }

        function medirProgresso() {
          const rect = persianas!.getBoundingClientRect();
          const util = rect.height - window.innerHeight;
          if (util <= 0) return;
          alvo = Math.min(Math.max(-rect.top / util, 0), 1);
          if (!rodando) {
            rodando = true;
            requestAnimationFrame(laco);
          }
        }

        atualizarCarrosseis.push(medirProgresso);
        medirProgresso();
        window.addEventListener('resize', () => {
          medirViewBox();
          medirProgresso();
        });
      }
    }
  }

  // 2) Scroll suave com Lenis — só desktop, só sem reduced-motion ---------
  const ehDesktop = window.matchMedia('(min-width: 56rem)').matches;

  if (ehDesktop && !reduzMovimento) {
    import('lenis').then(({ default: Lenis }) => {
      const lenis = new Lenis();

      function rafLenis(time: number) {
        lenis.raf(time);
        requestAnimationFrame(rafLenis);
      }

      requestAnimationFrame(rafLenis);
    });
  }
</script>
