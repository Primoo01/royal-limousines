---
// Carrossel de fotos — Swiper (ver CLAUDE.md > Carrossel de fotos).
//
// Decisão consciente: a versão própria (galeria horizontal por scroll)
// quebrou duas vezes — a confiabilidade passou a valer mais que os KB.
//
// CARREGAMENTO RESTRITO: este componente só é importado pela home e por
// /limousines/. O <script> abaixo vira um chunk JS separado do script
// site-wide de Movimento.astro — só as páginas que renderizam <Carrossel />
// baixam o Swiper. As 8 páginas de serviço/região não o importam, então
// nunca o carregam. Confirme isso comparando o peso de JS de uma dessas
// páginas com o da home depois de qualquer mudança aqui.
//
// Só os módulos usados: Navigation, Pagination, Autoplay, Keyboard — nunca
// o bundle completo do Swiper.
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface FotoCarrossel {
  /** Texto alternativo descritivo. */
  alt: string;
  /** Foto real. Sem ela, entra um placeholder no lugar. */
  imagem?: ImageMetadata;
  /** object-position, quando o recorte central não é o certo pra esta foto. */
  posicao?: string;
}

interface Props {
  fotos: FotoCarrossel[];
  mundo?: 'claro' | 'escuro';
  /** Classe no elemento raiz — usada pra aplicar o filtro das fotos do sedan. */
  class?: string;
}

const { fotos, mundo = 'claro', class: className } = Astro.props;
---

<div
  class:list={['carrossel', mundo === 'escuro' && 'carrossel--escuro', className]}
  data-carrossel-swiper
  role="region"
  aria-roledescription="carrossel"
  aria-label="Fotos"
>
  <div class="swiper">
    <div class="swiper-wrapper">
      {
        fotos.map((foto) => (
          <div class="swiper-slide">
            <figure class="carrossel__slide">
              {foto.imagem ? (
                <Image
                  src={foto.imagem}
                  alt={foto.alt}
                  width={900}
                  height={1125}
                  fit="cover"
                  position="center"
                  format="webp"
                  loading="lazy"
                  style={foto.posicao ? `object-position: ${foto.posicao};` : undefined}
                />
              ) : (
                <ImagePlaceholder label={foto.alt} aspectRatio="4/5" mundo={mundo} />
              )}
            </figure>
          </div>
        ))
      }
    </div>

    <div class="carrossel__controles">
      <button type="button" class="carrossel__botao swiper-button-prev" aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path
            d="M15 5l-8 7 8 7"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="carrossel__botao swiper-button-next" aria-label="Próxima foto">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path
            d="M9 5l8 7-8 7"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <div class="swiper-pagination"></div>
  </div>
</div>

<style>
  .carrossel {
    /* O slide é dimensionado pela ALTURA: cresce até ~80% da altura da tela,
       e a largura sai da proporção 4/5. As fotos são verticais — um slide
       4/3 descartava 42% da altura de cada uma no recorte. O teto de 52vw é
       o que garante que DOIS slides caibam lado a lado no desktop mesmo em
       tela baixa e estreita (2 × 0,8 × 52vw + gap < 92vw). */
    --carrossel-altura: min(80svh, 52vw);
    --carrossel-botao: 2.75rem;
    padding-block: var(--espaco-4);
  }

  .swiper {
    padding-inline: var(--espaco-3);
    /* Espaço pra paginação, que fica ancorada embaixo do trilho. */
    padding-bottom: var(--espaco-5);
  }

  .swiper-slide {
    height: var(--carrossel-altura);
    width: calc(var(--carrossel-altura) * 4 / 5);
  }

  .carrossel__slide {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
  }

  /* :global porque a <img> e o placeholder são renderizados por OUTROS
     componentes (astro:assets e ImagePlaceholder) — o escopo deste arquivo
     não alcança elementos que ele mesmo não renderiza. */
  .carrossel__slide :global(img),
  .carrossel__slide :global(.placeholder-imagem) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ---- Setas: a paleta do projeto, não o padrão do Swiper -------------
     Dourado do mundo correspondente, sem sombra, cantos retos. */
  .carrossel__controles {
    position: absolute;
    right: var(--espaco-4);
    bottom: var(--espaco-4);
    z-index: 2;
    display: flex;
    gap: var(--espaco-2);
  }

  .carrossel__botao {
    position: static;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--carrossel-botao);
    height: var(--carrossel-botao);
    /* Cantos retos (CLAUDE.md), diferente do círculo do padrão antigo do
       site pra este componente — decisão explícita da rodada do Swiper. */
    border-radius: 0;
    /* Glass falso (rgba + borda, sem blur) — backdrop-filter é reservado pro
       header e pro botão de WhatsApp (CLAUDE.md > Vidro). Sem sombra. */
    background-color: color-mix(in srgb, var(--surface) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--linha) 80%, transparent);
    box-shadow: none;
    color: var(--ouro);
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  /* Remove o ícone padrão do Swiper (fonte própria via ::after) — o SVG
     entra como filho normal do botão. */
  .carrossel__botao::after {
    content: none;
  }

  .carrossel__botao:hover,
  .carrossel__botao:focus-visible {
    color: var(--ouro);
    border-color: var(--ouro);
  }

  .carrossel__botao.swiper-button-disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* ---- Paginação: idem, dourado do mundo, sem sombra, cantos retos ----
     Elementos injetados pelo Swiper em runtime — não carregam o atributo
     de escopo do Astro, por isso :global aqui. */
  .carrossel :global(.swiper-pagination) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: var(--espaco-1);
  }

  .carrossel :global(.swiper-pagination-bullet) {
    width: 8px;
    height: 8px;
    border-radius: 0;
    background-color: var(--linha);
    opacity: 1;
    box-shadow: none;
    transition: background-color 0.25s ease;
  }

  .carrossel :global(.swiper-pagination-bullet-active) {
    background-color: var(--ouro);
  }

  @media (max-width: 56.25rem) {
    .carrossel__controles {
      right: var(--espaco-3);
      bottom: var(--espaco-3);
    }

    /* ---- Proporção do slide no mobile -------------------------------
       O slide SAÍA DEITADO (342×203 = 1.686), não em 4:5 como o CSS
       acima pretende. Duas causas somadas:

       1. Com slidesPerView: 1 o Swiper escreve a largura inline no
          slide, anulando o `width: calc(--carrossel-altura * 4/5)`.
       2. A altura vinha de `min(80svh, 52vw)`: em 390px o 52vw vence e
          dá 203px — uma conta pensada pro desktop, onde 52vw é
          generoso, e que no celular achata o quadro.

       E dentro do slide o `aspect-ratio: 4/5` nunca valia, porque
       `width: 100%` + `height: 100%` explícitos têm precedência sobre
       ele.

       Consequência: as fotos retrato (0,56 a 0,80) entravam numa caixa
       deitada, o `cover` ampliava até preencher a largura e descartava
       de 53% a 67% da ALTURA — cortando a frente ou a traseira do carro
       em 6 das 12 fotos.

       Correção: soltar as duas alturas e deixar o aspect-ratio da
       figura mandar. A largura continua sendo a que o Swiper escreve; a
       altura passa a ser largura × 5/4. Assim as fotos retrato aparecem
       inteiras. */
    .swiper-slide {
      height: auto;
    }

    .carrossel__slide {
      height: auto;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay, Keyboard } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  const reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carrossel-swiper]').forEach((raiz) => {
    const container = raiz.querySelector<HTMLElement>('.swiper');
    if (!container) return;

    new Swiper(container, {
      modules: [Navigation, Pagination, Autoplay, Keyboard],
      centeredSlides: true,
      slidesPerView: 1,
      spaceBetween: 20,
      grabCursor: true,
      loop: true,
      // Em prefers-reduced-motion, o autoplay não roda (CLAUDE.md).
      autoplay: reduzMovimento ? false : { delay: 3000, disableOnInteraction: false },
      keyboard: { enabled: true },
      pagination: {
        el: raiz.querySelector('.swiper-pagination'),
        clickable: true,
      },
      navigation: {
        nextEl: raiz.querySelector('.swiper-button-next'),
        prevEl: raiz.querySelector('.swiper-button-prev'),
      },
      breakpoints: {
        640: { slidesPerView: 1.25, spaceBetween: 20 },
        1024: { slidesPerView: 2, spaceBetween: 20 },
      },
    });
  });
</script>
