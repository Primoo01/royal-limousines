---
// Galeria horizontal por scroll — um componente só, usado na seção de fotos
// da home e na do 300C preto em /limousines/.
//
// COMO FUNCIONA (desktop): um spacer alto com um painel `position: sticky`
// dentro. O "prender na tela" é 100% CSS — nenhum pin em JavaScript. O JS
// só faz duas coisas: mede, e converte scroll vertical em translateX.
//
//   larguraDaTira = trilho.scrollWidth   (já inclui gaps e padding-inline)
//   distancia     = larguraDaTira - painel.clientWidth
//   altura        = 100vh + distancia
//
// Como a altura útil do spacer (altura - 100vh) é exatamente `distancia`,
// 1px de scroll vertical vira 1px de deslocamento horizontal. A tira acaba
// no mesmo instante em que o sticky solta. Sincronia direta, sem
// interpolação nenhuma — a suavidade quem dá é o Lenis.
//
// MOBILE (< 900px) e reduced-motion: a MESMA marcação é rolagem horizontal
// nativa com scroll-snap. O JS nem entra, e as setas usam scrollBy nativo.
// O scroll vertical da página nunca é sequestrado no toque.
//
// SEGURANÇA: o modo conduzido é OPT-IN. O padrão do CSS é a rolagem nativa,
// que mostra todas as fotos; o JS é que liga `data-conduzido="true"` depois
// de confirmar desktop sem reduced-motion. Se o JS falhar, a galeria não
// trava com uma foto presa — ela vira uma tira rolável comum.
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface FotoCarrossel {
  /** Texto alternativo descritivo. */
  alt: string;
  /** Foto real. Sem ela, entra um placeholder no lugar. */
  imagem?: ImageMetadata;
  /** object-position, quando o recorte central não é o certo pra esta foto. */
  posicao?: string;
}

interface Props {
  fotos: FotoCarrossel[];
  mundo?: 'claro' | 'escuro';
  /** Classe no elemento raiz — usada pra aplicar o filtro das fotos do sedan. */
  class?: string;
}

const { fotos, mundo = 'claro', class: className } = Astro.props;
---

<div
  class:list={['carrossel', mundo === 'escuro' && 'carrossel--escuro', className]}
  data-carrossel
  role="group"
  aria-roledescription="carrossel"
  aria-label="Fotos"
>
  <div class="carrossel__spacer" data-carrossel-spacer>
    <div class="carrossel__pinado" data-carrossel-painel>
      <div class="carrossel__trilho" data-carrossel-trilho tabindex="0">
        {
          fotos.map((foto, indice) => (
            <figure class="carrossel__slide" data-carrossel-slide>
              {foto.imagem ? (
                <Image
                  src={foto.imagem}
                  alt={foto.alt}
                  width={900}
                  height={1125}
                  fit="cover"
                  position="center"
                  format="webp"
                  {/* Lazy inclusive no primeiro slide: o carrossel nunca é o
                      hero (na home e na /limousines/ ele fica abaixo da
                      dobra), e o eager aqui somava ~154 KB ao primeiro load
                      de uma imagem que ninguém vê ainda. */}
                  loading="lazy"
                  style={foto.posicao ? `object-position: ${foto.posicao};` : undefined}
                />
              ) : (
                <ImagePlaceholder label={foto.alt} aspectRatio="4/5" mundo={mundo} />
              )}
            </figure>
          ))
        }
      </div>

      <div class="carrossel__controles">
        <button type="button" class="carrossel__botao" data-carrossel-anterior aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path
              d="M15 5l-8 7 8 7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" class="carrossel__botao" data-carrossel-proximo aria-label="Próxima foto">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path
              d="M9 5l8 7-8 7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .carrossel {
    --carrossel-botao: 2.75rem;
    /* O slide é dimensionado pela ALTURA: cresce até ~80% da altura da tela,
       e a largura sai da proporção 4/5. As fotos são verticais — um slide
       4/3 descartava 42% da altura de cada uma no recorte.
       O teto de 52vw é o que garante que DOIS slides caibam lado a lado no
       desktop mesmo em tela baixa e estreita (2 × 0,8 × 52vw + gap < 92vw). */
    --carrossel-altura: min(80svh, 52vw);
  }

  /* ---- PADRÃO: rolagem horizontal nativa ----
     Vale no mobile, em reduced-motion e enquanto (ou se) o JS não rodar.
     Todas as fotos ficam alcançáveis por toque, roda e teclado. */
  .carrossel__spacer {
    position: relative;
  }

  .carrossel__pinado {
    padding-block: var(--espaco-4);
  }

  .carrossel__trilho {
    display: flex;
    align-items: center;
    gap: var(--espaco-3);
    padding-inline: var(--espaco-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Barra invisível, como no resto do site — o scroll continua funcionando
       por toque, roda e teclado. */
    scrollbar-width: none;
  }

  .carrossel__trilho::-webkit-scrollbar {
    display: none;
  }

  .carrossel__slide {
    scroll-snap-align: center;
  }

  .carrossel__trilho:focus-visible {
    outline: 2px solid var(--ouro);
    outline-offset: 4px;
  }

  .carrossel__slide {
    position: relative;
    flex-shrink: 0;
    /* Proporção fixa + object-fit: cover aceita foto de qualquer orientação
       sem distorcer. 4/5 (retrato) porque as fotos do sedan são verticais
       9:16 — assim o recorte preserva 70% da altura original em vez de 42%. */
    aspect-ratio: 4 / 5;
    /* No padrão (rolagem nativa) é um slide por vez, medido pela LARGURA da
       tela. No modo conduzido a altura é que manda — ver abaixo. */
    width: 85vw;
    height: auto;
    margin: 0;
    overflow: hidden;
  }

  /* :global porque a <img> e o placeholder são renderizados por OUTROS
     componentes (astro:assets e ImagePlaceholder) — o escopo deste arquivo
     não alcança elementos que ele mesmo não renderiza. */
  .carrossel__slide :global(img),
  .carrossel__slide :global(.placeholder-imagem) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .carrossel__controles {
    position: absolute;
    right: var(--espaco-4);
    bottom: var(--espaco-4);
    z-index: 1;
    display: flex;
    gap: var(--espaco-2);
  }

  .carrossel__botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--carrossel-botao);
    height: var(--carrossel-botao);
    border-radius: 50%;
    /* Glass falso (rgba + borda, sem blur) — backdrop-filter é reservado pro
       header e pro botão de WhatsApp (CLAUDE.md > Vidro). */
    background-color: color-mix(in srgb, var(--surface) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--linha) 80%, transparent);
    color: var(--texto);
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .carrossel__botao:hover,
  .carrossel__botao:focus-visible {
    color: var(--ouro);
    border-color: var(--ouro);
  }

  /* ---- MODO CONDUZIDO ----
     Ligado pelo JS (data-conduzido="true") só em >= 900px e sem
     reduced-motion. É aqui que entram o sticky e o avanço por transform.
     A altura do spacer é escrita pelo JS em px, medida da tira real. */
  .carrossel[data-conduzido='true'] .carrossel__pinado {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding-block: 0;
  }

  .carrossel[data-conduzido='true'] .carrossel__trilho {
    /* Quem rola aqui é o transform, não o overflow. */
    overflow-x: hidden;
    scroll-snap-type: none;
    padding-inline: 4vw;
    /* Sem transition: a sincronia com o scroll é direta, sem interpolação. */
    will-change: transform;
  }

  /* No modo conduzido o slide é dimensionado pela ALTURA: cresce até ~80% da
     altura da tela e a largura sai da proporção 4/5. O teto de 52vw garante
     que DOIS caibam lado a lado mesmo em tela baixa e estreita. */
  .carrossel[data-conduzido='true'] .carrossel__slide {
    height: var(--carrossel-altura);
    width: calc(var(--carrossel-altura) * 4 / 5);
    scroll-snap-align: none;
  }

  @media (max-width: 56.25rem) {
    .carrossel__controles {
      right: var(--espaco-3);
      bottom: var(--espaco-3);
    }
  }
</style>
