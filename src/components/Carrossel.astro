---
// Carrossel de fotos — um componente só, reutilizado em todos os lugares
// (ver CLAUDE.md > Carrossel de fotos).
//
// DESKTOP: um spacer alto com um painel `position: sticky` dentro. A entrada
// (a primeira foto cresce de ~45% pra ~92% da largura) e o avanço horizontal
// são os dois conduzidos pelo scroll vertical. A conta fica centralizada em
// Movimento.astro, junto dos outros efeitos de scroll, lendo os elementos
// daqui pelos atributos `data-carrossel*`.
//
// MOBILE: a MESMA marcação vira rolagem horizontal nativa com scroll-snap —
// muda só o CSS (sticky vira static, overflow hidden vira auto, transform
// desligado com !important). Nenhum JS toca no scroll do mobile, e as setas
// ali usam scrollBy nativo. O scroll vertical da página nunca é sequestrado.
//
// SEGURANÇA: sem JS, o trilho não recebe transform nenhum — a primeira foto
// aparece inteira, no tamanho final. Quem encolhe pra iniciar a entrada é o
// JS, e só depois de confirmar que vai poder animar (desktop, sem
// prefers-reduced-motion). Nenhuma animação deixa conteúdo invisível se o JS
// falhar.
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface FotoCarrossel {
  /** Legenda visível, que troca junto com a foto */
  legenda: string;
  /** Texto alternativo. Igual à legenda por padrão em quem chama. */
  alt: string;
  /** Foto real. Sem ela, entra um placeholder no lugar. */
  imagem?: ImageMetadata;
}

interface Props {
  fotos: FotoCarrossel[];
  mundo?: 'claro' | 'escuro';
  /** Mostra a legenda sobre a foto. Falso na seção do sedan, onde fica só a imagem. */
  legendas?: boolean;
}

const { fotos, mundo = 'claro', legendas = true } = Astro.props;

// Distância de scroll: uma tela pra entrada + 70svh por avanço entre fotos.
// Calculado no servidor, então o tamanho está certo mesmo antes de o JS rodar.
const alturaSpacer = `calc(100svh + ${(fotos.length - 1) * 70}svh)`;
---

<div
  class:list={['carrossel', mundo === 'escuro' && 'carrossel--escuro']}
  data-carrossel
  role="group"
  aria-roledescription="carrossel"
  aria-label="Fotos"
>
  <div class="carrossel__spacer" data-carrossel-spacer style={`height: ${alturaSpacer};`}>
    <div class="carrossel__pinado">
      <div class="carrossel__trilho" data-carrossel-trilho tabindex="0">
        {
          fotos.map((foto, indice) => (
            <figure class="carrossel__slide" data-carrossel-slide>
              {foto.imagem ? (
                <Image
                  src={foto.imagem}
                  alt={foto.alt}
                  width={900}
                  height={1125}
                  fit="cover"
                  position="center"
                  format="webp"
                  loading={indice === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <ImagePlaceholder label={foto.alt} aspectRatio="4/5" mundo={mundo} />
              )}
              {legendas && <figcaption class="carrossel__legenda">{foto.legenda}</figcaption>}
            </figure>
          ))
        }
      </div>

      <div class="carrossel__controles">
        <button type="button" class="carrossel__botao" data-carrossel-anterior aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path
              d="M15 5l-8 7 8 7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" class="carrossel__botao" data-carrossel-proximo aria-label="Próxima foto">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path
              d="M9 5l8 7-8 7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .carrossel {
    --carrossel-botao: 2.75rem;
    /* O slide é dimensionado pela ALTURA: cresce até ~80% da altura da tela,
       e a largura sai da proporção 4/5. As fotos são verticais — um slide
       4/3 descartava 42% da altura de cada uma no recorte.
       O teto de 52vw é o que garante que DOIS slides caibam lado a lado no
       desktop mesmo em tela baixa e estreita (2 × 0,8 × 52vw + gap < 92vw). */
    --carrossel-altura: min(80svh, 52vw);
  }

  .carrossel__spacer {
    position: relative;
  }

  .carrossel__pinado {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .carrossel__trilho {
    display: flex;
    align-items: center;
    gap: var(--espaco-3);
    padding-inline: 4vw;
    /* A entrada cresce a partir da esquerda. */
    transform-origin: left center;
  }

  .carrossel__trilho:focus-visible {
    outline: 2px solid var(--ouro);
    outline-offset: 4px;
  }

  .carrossel__slide {
    position: relative;
    flex-shrink: 0;
    /* Proporção fixa + object-fit: cover aceita foto de qualquer orientação
       sem distorcer. 4/5 (retrato) porque as 6 fotos do sedan são verticais
       9:16 — assim o recorte preserva 70% da altura original em vez de 42%. */
    aspect-ratio: 4 / 5;
    height: var(--carrossel-altura);
    width: calc(var(--carrossel-altura) * 4 / 5);
    margin: 0;
    overflow: hidden;
  }

  /* :global porque a <img> e o placeholder são renderizados por OUTROS
     componentes (astro:assets e ImagePlaceholder) — o escopo deste arquivo
     não alcança elementos que ele mesmo não renderiza. */
  .carrossel__slide :global(img),
  .carrossel__slide :global(.placeholder-imagem) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Legenda no ALTO e botões embaixo à direita: assim os dois nunca se
     cruzam, em largura nenhuma. Reservar padding na legenda não resolveria —
     o slide é mais largo que a tela e, no meio do avanço, a borda direita da
     legenda fica fora da viewport, então os botões cairiam sobre o MEIO do
     texto, não sobre a ponta. */
  .carrossel__legenda {
    position: absolute;
    inset-inline: 0;
    top: 0;
    padding: var(--espaco-3);
    padding-bottom: var(--espaco-5);
    background: linear-gradient(to bottom, rgba(10, 9, 8, 0.7), transparent);
    color: #ede7db;
    font-family: var(--fonte-sans);
    font-size: 0.875rem;
    letter-spacing: 0.03em;
  }

  .carrossel__controles {
    position: absolute;
    right: var(--espaco-4);
    bottom: var(--espaco-4);
    z-index: 1;
    display: flex;
    gap: var(--espaco-2);
  }

  .carrossel__botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--carrossel-botao);
    height: var(--carrossel-botao);
    border-radius: 50%;
    /* Glass falso (rgba + borda, sem blur) — backdrop-filter é reservado pro
       header e pro botão de WhatsApp (CLAUDE.md > Vidro). */
    background-color: color-mix(in srgb, var(--surface) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--linha) 80%, transparent);
    color: var(--texto);
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .carrossel__botao:hover,
  .carrossel__botao:focus-visible {
    color: var(--ouro);
    border-color: var(--ouro);
  }

  @media (max-width: 56rem) {
    /* O spacer alto só faz sentido pro scroll conduzido do desktop. No
       mobile ele colapsa e a seção volta a ter a altura do conteúdo. */
    .carrossel__spacer {
      height: auto !important;
    }

    .carrossel__pinado {
      position: static;
      height: auto;
      display: block;
      padding-block: var(--espaco-4);
    }

    .carrossel__trilho {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-inline: var(--espaco-3);
      /* !important: cancela qualquer transform que o JS tenha deixado antes
         de uma rotação de tela. No mobile quem rola é o dedo, não o JS. */
      transform: none !important;
      /* Barra invisível, como no resto do site — o scroll continua
         funcionando por toque, roda e teclado. */
      scrollbar-width: none;
    }

    .carrossel__trilho::-webkit-scrollbar {
      display: none;
    }

    /* No mobile é um slide por vez, medido pela LARGURA da tela — a altura
       volta a sair da proporção. */
    .carrossel__slide {
      width: 85vw;
      height: auto;
      scroll-snap-align: center;
    }

    .carrossel__controles {
      right: var(--espaco-3);
      bottom: var(--espaco-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carrossel__spacer {
      height: auto !important;
    }

    .carrossel__pinado {
      position: static;
      height: auto;
      display: block;
    }

    .carrossel__trilho {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      transform: none !important;
      scrollbar-width: none;
    }

    .carrossel__trilho::-webkit-scrollbar {
      display: none;
    }

    .carrossel__slide {
      scroll-snap-align: center;
    }
  }
</style>
