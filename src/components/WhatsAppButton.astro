---
import site from '../config/site.js';
---

<a
  href={site.contato.whatsapp.link}
  class="whatsapp-flutuante glass-real"
  target="_blank"
  rel="noopener"
  aria-label={`${site.cta.whatsapp} — ${site.contato.whatsapp.exibicao}`}
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.2.58 4.27 1.6 6.06L4 29l8.1-1.56a12 12 0 0 0 3.92.66c6.62 0 12.02-5.4 12.02-12.02C28.04 8.4 22.64 3 16.02 3Zm0 21.86c-1.9 0-3.68-.5-5.24-1.44l-.38-.22-4.8.93.94-4.68-.25-.4a9.83 9.83 0 0 1-1.5-5.03c0-5.43 4.42-9.85 9.85-9.85s9.85 4.42 9.85 9.85-4.42 9.84-9.85 9.84Zm5.4-7.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.63.07-.3-.15-1.24-.46-2.37-1.47-.87-.78-1.46-1.74-1.63-2.03-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.9-2.18-.24-.58-.48-.5-.66-.5h-.56c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.09 1.75-.71 2-1.4.24-.68.24-1.27.17-1.4-.07-.13-.27-.2-.56-.35Z"
    ></path>
  </svg>
</a>

<style>
  .whatsapp-flutuante {
    position: fixed;
    right: var(--espaco-3);
    bottom: var(--espaco-3);
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    color: var(--ouro);
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .whatsapp-flutuante:hover {
    transform: translateY(-2px) scale(1.03);
  }
</style>
