---
// Linha que se desenha — curva única e suave terminando num ponto marcado
// (ver CLAUDE.md > Linha que se desenha). O comprimento do traçado é medido
// com getTotalLength() em Movimento.astro, nunca chutado.
//
// Regra de segurança (mesmo princípio do vocabulário de entrada): sem
// dasharray/dashoffset definidos, a curva do SVG aparece inteira e o ponto
// é visível por padrão. Só ficam escondidos quando o JS decide preparar o
// elemento pra animar — nunca por padrão do CSS.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const classes = ['linha-desenhada', className].filter(Boolean).join(' ');
---

<div class={classes} data-linha-desenhada aria-hidden="true">
  <svg viewBox="0 0 200 24" preserveAspectRatio="none" focusable="false">
    <path class="linha-desenhada__curva" d="M2 18 C 55 2, 145 2, 198 16" fill="none" />
  </svg>
  <span class="linha-desenhada__ponto" data-linha-ponto></span>
</div>

<style>
  .linha-desenhada {
    position: relative;
    width: 100%;
    max-width: 11rem;
    height: 1.5rem;
  }

  .linha-desenhada svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .linha-desenhada__curva {
    stroke: var(--ouro);
    stroke-width: 1.5;
    stroke-linecap: round;
    fill: none;
  }

  /* Só existe transição quando o JS decidiu preparar este elemento —
     evitando qualquer transição fantasma no estado padrão (sem JS). */
  .linha-desenhada--preparada .linha-desenhada__curva {
    transition: stroke-dashoffset 1.6s cubic-bezier(0.2, 0.7, 0.3, 1) 0.2s;
  }

  .linha-desenhada__ponto {
    position: absolute;
    right: 1px;
    bottom: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--ouro);
    opacity: 1;
  }

  .linha-desenhada--preparada .linha-desenhada__ponto {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .linha-desenhada--preparada .linha-desenhada__ponto.linha-desenhada__ponto--visivel {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .linha-desenhada__curva {
      transition: none !important;
    }

    .linha-desenhada__ponto {
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
