---
// Linha que se desenha (ver CLAUDE.md > Linha que se desenha). O comprimento
// do traçado é medido com getTotalLength() em Movimento.astro, nunca chutado.
//
// Duas variantes:
//
// - 'curva' (padrão): a curva única e suave terminando num ponto marcado.
//   É a das 10 páginas de conteúdo.
// - 'assinatura': gesto de rubrica, usado só na /contato/. Duas ondulações em
//   alturas diferentes (a primeira mais alta e ampla, a segunda mais baixa e
//   curta) e um arremate curto subindo no fim. Traço mais grosso e SEM o
//   ponto: quem fecha o gesto é o arremate.
//
// Regra de segurança (mesmo princípio do vocabulário de entrada): sem
// dasharray/dashoffset definidos, o traçado aparece inteiro e o ponto é
// visível por padrão. Só ficam escondidos quando o JS decide preparar o
// elemento pra animar — nunca por padrão do CSS.
interface Props {
  variante?: 'curva' | 'assinatura';
  class?: string;
}

const { variante = 'curva', class: className } = Astro.props;
const assinatura = variante === 'assinatura';
const classes = ['linha-desenhada', assinatura && 'linha-desenhada--assinatura', className]
  .filter(Boolean)
  .join(' ');
---

<div class={classes} data-linha-desenhada aria-hidden="true">
  {
    assinatura ? (
      // Traço único e contínuo, com o laço no meio — o gesto de uma
      // assinatura real. preserveAspectRatio "none" conforme especificado;
      // a caixa recebe aspect-ratio igual ao do viewBox (700/120) pra que
      // "none" não deforme a espessura do traço, que em 2.4 apareceria.
      <svg viewBox="0 0 700 120" preserveAspectRatio="none" focusable="false">
        <path
          class="linha-desenhada__curva"
          d="M20,86 C90,86 118,34 190,32 C250,30 258,74 214,80 C182,84 176,52 226,44 C300,32 360,70 430,64 C500,58 540,30 620,36 C650,38 668,46 682,50"
          fill="none"
        />
      </svg>
    ) : (
      <svg viewBox="0 0 200 24" preserveAspectRatio="none" focusable="false">
        <path class="linha-desenhada__curva" d="M2 18 C 55 2, 145 2, 198 16" fill="none" />
      </svg>
    )
  }
  {!assinatura && <span class="linha-desenhada__ponto" data-linha-ponto />}
</div>

<style>
  .linha-desenhada {
    position: relative;
    width: 100%;
    max-width: 11rem;
    height: 1.5rem;
  }

  /* O gesto é bem mais largo que a curva simples. A caixa repete a
     proporção do viewBox (700/120) — com preserveAspectRatio="none" é isso
     que impede o traço de esticar e engrossar num eixo só. */
  .linha-desenhada--assinatura {
    max-width: 22rem;
    height: auto;
    aspect-ratio: 700 / 120;
  }

  .linha-desenhada svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .linha-desenhada__curva {
    stroke: var(--ouro);
    stroke-width: 1.5;
    stroke-linecap: round;
    fill: none;
  }

  /* Dourado do MUNDO CLARO, fixo: a assinatura só existe na /contato/, que
     é mundo claro do começo ao fim. */
  .linha-desenhada--assinatura .linha-desenhada__curva {
    stroke: var(--ouro-claro);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    /* Com preserveAspectRatio="none" a espessura acompanharia a escala do
       viewBox; isto mantém 2.4 em unidades de tela. */
    vector-effect: non-scaling-stroke;
  }

  /* O desenho do traço é conduzido pela Web Animations API em
     Movimento.astro, não por transition: a transição de stroke-dashoffset
     não engatava de forma confiável (ver o comentário longo lá).
     A classe --preparada continua existindo só para esconder o ponto
     enquanto o traço se desenha. */

  .linha-desenhada__ponto {
    position: absolute;
    right: 1px;
    bottom: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--ouro);
    opacity: 1;
  }

  .linha-desenhada--preparada .linha-desenhada__ponto {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .linha-desenhada--preparada .linha-desenhada__ponto.linha-desenhada__ponto--visivel {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .linha-desenhada__curva {
      transition: none !important;
    }

    .linha-desenhada__ponto {
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
