---
// Foto real do cliente, no lugar onde antes havia <ImagePlaceholder>.
//
// Mesma API de posicionamento do placeholder (aspectRatio + class), pra que a
// troca em cada página seja mecânica e nenhum layout mude: o container já
// tinha aspect-ratio definido, então não há CLS na substituição.
//
// O recorte é sempre CENTRAL (object-fit: cover + object-position: center).
// Várias fotos são retrato 9:16 entrando em espaços largos; cover recorta,
// nunca distorce (ver CLAUDE.md > Imagens).
import { Image, Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** Obrigatório: toda imagem do site leva alt descritivo. */
  alt: string;
  /** Proporção do container, ex.: "16/9", "4/3", "3/4", "4/5" */
  aspectRatio?: string;
  /** Largura máxima que a foto será servida. Teto de 1600px do CLAUDE.md. */
  larguraServida?: number;
  /**
   * Quanto do viewport a foto ocupa, por breakpoint. Precisa bater com o CSS
   * real do espaço: um `sizes` largo demais faz o navegador baixar um arquivo
   * muito maior do que o que cabe na tela. O padrão serve pros blocos de meia
   * largura; o hero, que é estreito no desktop, passa o seu.
   */
  sizes?: string;
  /** Só o hero carrega adiantado; o resto é lazy. */
  prioridade?: boolean;
  /** object-position, quando o recorte central não é o certo pra esta foto. */
  posicao?: string;
  /**
   * Qualidade da compressão. Ausente = padrão do astro:assets. Só vale a
   * pena subir em foto com gradiente amplo (céu, lataria clara), onde a
   * compressão agressiva deixa banding visível.
   */
  qualidade?: number;
  /**
   * Emite <picture> com fallback JPG além do WebP. Reservado ao LCP: para
   * o resto do site o WebP sozinho basta e pesa menos.
   */
  comFallback?: boolean;
  class?: string;
}

const {
  src,
  alt,
  aspectRatio = '4/3',
  larguraServida = 1200,
  sizes = '(max-width: 56.25rem) 100vw, 50vw',
  prioridade = false,
  posicao,
  qualidade,
  comFallback = false,
  class: className,
} = Astro.props;

// Comuns às duas saídas, pra que trocar de <Image> pra <Picture> não possa
// mudar nada além do formato.
const comuns = {
  src,
  alt,
  widths: [480, 800, larguraServida],
  sizes,
  loading: prioridade ? ('eager' as const) : ('lazy' as const),
  fetchpriority: prioridade ? ('high' as const) : ('auto' as const),
  decoding: prioridade ? ('sync' as const) : ('async' as const),
  style: posicao ? `object-position: ${posicao};` : undefined,
  ...(qualidade ? { quality: qualidade } : {}),
};
---

<div class:list={['foto', className]} style={`aspect-ratio: ${aspectRatio};`}>
  {
    comFallback ? (
      <Picture {...comuns} formats={['webp']} fallbackFormat="jpg" />
    ) : (
      <Image {...comuns} format="webp" />
    )
  }
</div>

<style>
  .foto {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--surface);
  }

  /* Com `comFallback`, o astro:assets embrulha a <img> num <picture>, que
     nasce `display: inline`. Nesse caso o `height: 100%` da <img> passa a
     resolver contra uma caixa inline sem altura e é ignorado: a foto
     encolhe pra própria proporção e sobra fundo dentro do contêiner.
     Este bloco reconstrói a cadeia de altura. */
  .foto :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* :global porque a <img> é renderizada pelo astro:assets, não por este
     arquivo — o escopo daqui não alcança elemento que ele não emite. */
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
</style>
