---
// Foto real do cliente, no lugar onde antes havia <ImagePlaceholder>.
//
// Mesma API de posicionamento do placeholder (aspectRatio + class), pra que a
// troca em cada página seja mecânica e nenhum layout mude: o container já
// tinha aspect-ratio definido, então não há CLS na substituição.
//
// O recorte é sempre CENTRAL (object-fit: cover + object-position: center).
// Várias fotos são retrato 9:16 entrando em espaços largos; cover recorta,
// nunca distorce (ver CLAUDE.md > Imagens).
import { Image, Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** Obrigatório: toda imagem do site leva alt descritivo. */
  alt: string;
  /**
   * Proporção do container, ex.: "16/9", "4/3", "3/4", "4/5".
   * OMITIR quando ela precisar variar por breakpoint: sem esta prop nada
   * é escrito inline, e o CSS assume via `--foto-proporcao` (padrão 4/3).
   * É o caso do hero da home, que usa 4/5 no desktop e 8/5 no mobile.
   */
  aspectRatio?: string;
  /** Largura máxima que a foto será servida. Teto de 1600px do CLAUDE.md. */
  larguraServida?: number;
  /**
   * Degraus do srcset, quando os três padrões são grosseiros demais. Sem
   * um degrau intermediário o navegador pula direto para o maior arquivo e
   * baixa muito mais byte do que precisa. Vale para o LCP.
   */
  larguras?: number[];
  /**
   * Quanto do viewport a foto ocupa, por breakpoint. Precisa bater com o CSS
   * real do espaço: um `sizes` largo demais faz o navegador baixar um arquivo
   * muito maior do que o que cabe na tela. O padrão serve pros blocos de meia
   * largura; o hero, que é estreito no desktop, passa o seu.
   */
  sizes?: string;
  /** Só o hero carrega adiantado; o resto é lazy. */
  prioridade?: boolean;
  /** object-position, quando o recorte central não é o certo pra esta foto. */
  posicao?: string;
  /**
   * Qualidade da compressão. Ausente = padrão do astro:assets. Só vale a
   * pena subir em foto com gradiente amplo (céu, lataria clara), onde a
   * compressão agressiva deixa banding visível.
   */
  qualidade?: number;
  /**
   * Emite <picture> com fallback JPG além do WebP. Reservado ao LCP: para
   * o resto do site o WebP sozinho basta e pesa menos.
   */
  comFallback?: boolean;
  /**
   * ART DIRECTION: arquivo DIFERENTE para telas estreitas — não outro tamanho
   * do mesmo arquivo, que é o que `larguras`/`sizes` já resolvem.
   *
   * Existe porque foto retrato e foto paisagem não são intercambiáveis: a do
   * hero da home é 2.22 (paisagem) e cabe na caixa larga do desktop, enquanto
   * no celular a tela é vertical e pede uma retrato.
   *
   * Emite <picture> com `<source media>`, e é isso que garante UMA imagem
   * baixada. Dois <Foto> com `display: none` não servem: o navegador busca a
   * imagem escondida também, e aqui estamos na rota do LCP.
   */
  srcEstreito?: ImageMetadata;
  /** Media query que ativa `srcEstreito`. Precisa bater com o CSS de quem chama. */
  mediaEstreito?: string;
  /** Degraus do srcset da variante estreita. Teto = largura nativa dela. */
  largurasEstreito?: number[];
  /** `sizes` da variante estreita, medido no espaço dela, não no do desktop. */
  sizesEstreito?: string;
  class?: string;
}

const {
  src,
  alt,
  aspectRatio,
  larguraServida = 1200,
  larguras,
  sizes = '(max-width: 56.25rem) 100vw, 50vw',
  prioridade = false,
  posicao,
  qualidade,
  comFallback = false,
  srcEstreito,
  mediaEstreito = '(max-width: 56.25rem)',
  largurasEstreito,
  sizesEstreito = '100vw',
  class: className,
} = Astro.props;

// Comuns às duas saídas, pra que trocar de <Image> pra <Picture> não possa
// mudar nada além do formato.
const comuns = {
  src,
  alt,
  widths: larguras ?? [480, 800, larguraServida],
  sizes,
  loading: prioridade ? ('eager' as const) : ('lazy' as const),
  fetchpriority: prioridade ? ('high' as const) : ('auto' as const),
  decoding: prioridade ? ('sync' as const) : ('async' as const),
  style: posicao ? `object-position: ${posicao};` : undefined,
  ...(qualidade ? { quality: qualidade } : {}),
};

// Só quando há art direction. O <Picture> do astro:assets não aceita um
// <source media> extra, então aqui o <picture> é montado à mão — e para isso
// precisamos dos srcsets prontos, que é o que getImage() devolve em
// `.srcSet.attribute`.
const arte = srcEstreito
  ? await (async () => {
      const gerar = (imagem: ImageMetadata, widths: number[], format: 'webp' | 'jpg') =>
        getImage({ src: imagem, widths, format, ...(qualidade ? { quality: qualidade } : {}) });

      const degrausEstreito = largurasEstreito ?? [480, srcEstreito.width];
      const degrausLargo = comuns.widths;

      const [estreitoWebp, estreitoJpg, largoWebp, largoJpg] = await Promise.all([
        gerar(srcEstreito, degrausEstreito, 'webp'),
        gerar(srcEstreito, degrausEstreito, 'jpg'),
        gerar(src, degrausLargo, 'webp'),
        gerar(src, degrausLargo, 'jpg'),
      ]);

      return { estreitoWebp, estreitoJpg, largoWebp, largoJpg };
    })()
  : null;
---

{/*
  A proporção entra como CUSTOM PROPERTY, e SÓ quando a prop foi passada.
  Motivo: style inline vence media query — se a variável fosse escrita
  aqui sempre, nenhum breakpoint conseguiria trocá-la. Omitindo a prop, o
  CSS assume pelo fallback do `var()` e pode variar por largura de tela.
  Para quem passa a prop, o resultado é idêntico ao de antes.
*/}
<div class:list={['foto', className]} style={aspectRatio ? `--foto-proporcao: ${aspectRatio};` : undefined}>
  {
    arte ? (
      /*
        ORDEM IMPORTA: o navegador para no PRIMEIRO <source> que casa. Os dois
        com `media` vêm antes, então a variante estreita ganha na tela pequena;
        acima da media query eles não casam e sobra o par de baixo. O <img> é
        o último recurso e carrega o JPG largo.
      */
      <picture>
        <source media={mediaEstreito} type="image/webp" srcset={arte.estreitoWebp.srcSet.attribute} sizes={sizesEstreito} />
        <source media={mediaEstreito} type="image/jpeg" srcset={arte.estreitoJpg.srcSet.attribute} sizes={sizesEstreito} />
        <source type="image/webp" srcset={arte.largoWebp.srcSet.attribute} sizes={sizes} />
        <img
          src={arte.largoJpg.src}
          srcset={arte.largoJpg.srcSet.attribute}
          sizes={sizes}
          {/* As dimensões vêm do RESULTADO do getImage, não de `src.width` /
              `src.height`. Ler a propriedade direto da ImageMetadata faz o
              Astro emitir o arquivo ORIGINAL em _astro/ além dos derivados —
              e ninguém referencia esse original, então ele vira peso morto no
              deploy. Medido: 453 KB só do Casamento1 aqui, e 3,5 MB quando o
              mesmo padrão estava no MenuMidia. Os valores são idênticos: o
              `attributes` do getImage traz a largura e a altura nativas. */}
          width={arte.largoJpg.attributes.width}
          height={arte.largoJpg.attributes.height}
          alt={alt}
          loading={comuns.loading}
          fetchpriority={comuns.fetchpriority}
          decoding={comuns.decoding}
          style={comuns.style}
        />
      </picture>
    ) : comFallback ? (
      <Picture {...comuns} formats={['webp']} fallbackFormat="jpg" />
    ) : (
      <Image {...comuns} format="webp" />
    )
  }
</div>

<style>
  .foto {
    position: relative;
    width: 100%;
    aspect-ratio: var(--foto-proporcao, 4 / 3);
    overflow: hidden;
    background-color: var(--surface);
  }

  /* Com `comFallback`, o astro:assets embrulha a <img> num <picture>, que
     nasce `display: inline`. Nesse caso o `height: 100%` da <img> passa a
     resolver contra uma caixa inline sem altura e é ignorado: a foto
     encolhe pra própria proporção e sobra fundo dentro do contêiner.
     Este bloco reconstrói a cadeia de altura. */
  .foto :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* :global porque a <img> é renderizada pelo astro:assets, não por este
     arquivo — o escopo daqui não alcança elemento que ele não emite. */
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
</style>
