---
// Vídeo 360 — um por página, logo acima do carrossel (ver CLAUDE.md >
// Vídeos 360).
//
// CORTE DE 35% DO TOPO, por CSS e sem editar o arquivo: o contêiner recebe
// overflow hidden e um aspect-ratio mais largo que o do vídeo —
//
//     largura / (altura × 0.65)
//
// — e o vídeo dentro preenche esse espaço com object-fit: cover ancorado em
// `center bottom`. Como a caixa é mais baixa do que a proporção original, o
// cover escala pela largura e o excedente sai por CIMA, que é exatamente o
// terço superior que queremos descartar. Nenhum pixel do arquivo é tocado.
//
// O <script> abaixo vira um chunk próprio, carregado só nas páginas que
// renderizam este componente (home e /limousines/) — as 8 páginas de
// serviço/região não o baixam.
import { Image } from 'astro:assets';

interface Props {
  /** Caminho do MP4 em public/ (o astro:assets não processa vídeo). */
  src: string;
  /** Poster, importado de src/assets pra passar pelo astro:assets. */
  poster: ImageMetadata;
  /** Largura real do arquivo de vídeo. */
  largura: number;
  /** Altura real do arquivo de vídeo. */
  altura: number;
  /** Descrição do que o vídeo mostra — vira o rótulo acessível. */
  alt: string;
  class?: string;
}

const { src, poster, largura, altura, alt, class: className } = Astro.props;

// Fração do topo que sai fora. 0.65 = mantém 65%, corta 35%.
const MANTIDO = 0.65;
const proporcao = largura / (altura * MANTIDO);

// O POSTER NÃO É MAIS O ATRIBUTO `poster` DO <video>. É um <img> sobreposto, e
// a troca resolveu dois defeitos que o atributo não permitia consertar:
//
// 1. `poster` é atributo de URL ÚNICA — não existe `srcset` nem `sizes` nele
//    (confirmado no motor: `HTMLVideoElement.prototype` tem `poster` e não tem
//    `srcset`). Servia 1440w para todo mundo: desperdício no mobile, onde a
//    caixa tem 390px de largura, e ainda assim insuficiente no desktop, onde
//    em DPR 2 a 1440px seriam necessários 2880.
// 2. `poster` é baixado de qualquer forma, MESMO com `preload="none"` no vídeo
//    e sem ninguém rolar. Medido: 43,8 KB a +1215ms na home, para um vídeo que
//    começa em y=6064 — sete telas abaixo da dobra. Não existe
//    `loading="lazy"` para `poster`; existe para `<img>`.
//
// POR QUE SOBREPOR É SEGURO AQUI, e não seria num player comum: este vídeo
// NUNCA toca sem JavaScript. Não há atributo `autoplay` (ver a nota grande
// abaixo) — quem dá play é o observer. Então não existe o cenário "JS falhou e
// a imagem ficou cobrindo um vídeo rodando": se o JS falhar, nada toca e o
// poster é justamente o que deve ficar na tela. É o mesmo estado final do
// atributo `poster`, inclusive em reduced-motion e no iOS com Modo de Dados
// Reduzidos, onde as tentativas de play se esgotam.
//
// O teto do `srcset` é 1440w porque é o tamanho do ARQUIVO de origem. O
// desktop em DPR 2 continua recebendo menos do que gostaria — isso não piorou,
// era assim antes, e só melhora com um poster de origem maior.
const LARGURAS_POSTER = [390, 480, 640, 768, 960, 1200, 1440];
---

<div class:list={['video360', className]} style={`aspect-ratio: ${proporcao};`} data-video360>
  {/*
    SEM `autoplay` de propósito. O atributo faz o navegador buscar o arquivo
    assim que a tag é lida — medido: somava 1,4 MB à carga inicial da home,
    para um vídeo que está abaixo da dobra.

    `preload="none"` e não "metadata" pelo mesmo motivo, medido no Chrome:
    com "metadata" ele bufferizava de 768 KB a 1 MB antes de o visitante
    rolar até o vídeo — quase o arquivo inteiro, o que anularia a economia.
    Com "none" são 0 KB até o vídeo entrar em cena. Não há perda: quem pede
    o carregamento é o video.load() do IntersectionObserver, que já existia
    porque o iOS ignora `preload` de qualquer forma.

    Quem dispara a reprodução é o play() no observer. O que o iOS exige para
    permitir play() sem gesto do usuário são `muted` e `playsinline`, que
    continuam aqui como atributos no HTML (o iOS avalia os dois no momento em
    que lê a tag; defini-los por JS depois é tarde demais).
  */}
  <video
    src={src}
    width={largura}
    height={altura}
    muted
    loop
    playsinline
    preload="none"
    aria-label={alt}
    data-video360-media></video>

  {/*
    POSTER. `alt=""` de propósito: o <video> acima já carrega a descrição no
    `aria-label`, e repeti-la aqui faria o leitor de tela anunciar a mesma cena
    duas vezes. A imagem é redundante em relação ao vídeo que ela representa.

    `sizes="100vw"` porque a caixa é full-bleed em toda largura — medido em
    360, 390, 402, 430, 768, 1280, 1440 e 1920px: a caixa sai sempre com a
    largura exata da viewport.

    O mesmo `object-position: center bottom` do vídeo, senão o poster mostraria
    um recorte e o vídeo outro no instante da troca.
  */}
  <Image
    src={poster}
    widths={LARGURAS_POSTER}
    sizes="100vw"
    format="webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="video360__poster"
    data-video360-poster
  />

  {/*
    Botão de play — EXCEÇÃO DELIBERADA ao "sem controles" do CLAUDE.md.
    Nasce oculto (hidden) e só aparece quando o play() é recusado em todas as
    tentativas, o que acontece no iOS com Modo de Dados Reduzidos ligado: o
    aparelho se recusa a carregar mídia sozinho e o visitante ficaria diante
    de um poster estático, sem nenhuma pista de que ali existe vídeo. Em quem
    toca normalmente ele nunca é exibido. É <button> de verdade para
    funcionar com teclado e ser anunciado por leitor de tela.
  */}
  <button type="button" class="video360__play" data-video360-play hidden aria-label={`Reproduzir vídeo: ${alt}`}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
      <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
    </svg>
  </button>
</div>

<style>
  /* O overflow hidden é o que efetivamente recorta: a caixa tem a proporção
     do corte (mais larga que a do vídeo), e o que sobra do vídeo sai por
     fora dela. */
  .video360 {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--surface);
  }

  .video360 video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ancorado embaixo: o excedente sai pelo TOPO, que é o que o corte de
       35% descarta. */
    object-position: center bottom;
  }

  /* O poster cobre a mesma caixa do vídeo, com o mesmo recorte. Fica ABAIXO do
     botão de play na pilha (o botão é z-index 1) para que, quando o play é
     recusado no iOS, o botão apareça SOBRE o poster e não atrás dele. */
  .video360__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    pointer-events: none;
  }

  /* Sai de cena quando o vídeo REALMENTE começa a tocar — o JS marca o
     contêiner no evento `playing`, não na chamada de play(), que resolve antes
     do primeiro quadro aparecer e deixaria um piscada preta.
     `opacity` e não `display`: só o compositor, sem layout (CLAUDE.md >
     Movimento). E é de mão única — ao rolar para fora o vídeo pausa, mas o
     poster não volta, senão piscaria a cada ida e volta. */
  .video360[data-tocando='true'] .video360__poster {
    opacity: 0;
  }

  /* Discreto de propósito: é uma saída de emergência, não um controle de
     player. Glass falso (rgba + borda, sem blur), como manda o CLAUDE.md
     fora dos dois lugares onde backdrop-filter é permitido. */
  .video360__play {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--escuro-bg) 62%, transparent);
    border: 1px solid color-mix(in srgb, var(--claro-bg) 55%, transparent);
    color: var(--claro-bg);
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.3, 1), background-color 0.25s ease;
  }

  /* `hidden` sozinho perde para o display do próprio seletor; explicitar
     evita o botão aparecer por um quadro antes do JS decidir. */
  .video360__play[hidden] {
    display: none;
  }

  .video360__play:hover,
  .video360__play:focus-visible {
    transform: translate(-50%, -50%) scale(1.06);
    background-color: color-mix(in srgb, var(--escuro-bg) 78%, transparent);
  }

  .video360__play svg {
    /* Empurra o triângulo para o centro óptico do círculo. */
    margin-left: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .video360__play {
      transition: none;
    }
  }
</style>

<script>
  // Toca só quando entra na viewport, pausa ao sair — um vídeo rodando fora
  // de cena é bateria e banda gastas à toa.
  //
  // Em prefers-reduced-motion o vídeo nunca toca: fica no poster, que já é o
  // estado de repouso do <video>. Não há nada a fazer além de não chamar
  // play(), então o observer sequer é criado.
  //
  // POR QUE ISTO NÃO É UM `play()` SOLTO:
  //
  // O vídeo mora dentro de uma <section class="reveal">, que fica em
  // opacity ~0 até entrar em cena e leva 1,1s transicionando. O WebKit (iOS)
  // é mais rigoroso que o Chrome quanto a reproduzir vídeo que considera não
  // visível. Por isso: threshold alto para só disparar com metade à vista,
  // RETENTATIVAS em vez de desistir na primeira rejeição, e o erro
  // registrado em vez de engolido.
  //
  // O `video.load()` mais abaixo é o que destrava o iOS de verdade: medido
  // num iPhone real, o elemento chegava com networkState=0 (NETWORK_EMPTY),
  // ou seja o aparelho nunca buscava o arquivo — e não há como reproduzir
  // mídia que não foi carregada. O iOS ignora `preload` para poupar dados,
  // então quem tem que pedir o carregamento somos nós, no momento em que o
  // vídeo entra em cena.
  const reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Diagnóstico visível no aparelho: abra a página com ?videodebug na URL.
  // Fora disso não aparece nada para o visitante.
  const modoDebug = new URLSearchParams(location.search).has('videodebug');

  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-video360-media]'));

  // TIRA O POSTER DE CENA. Escuta `playing`, não o `.then()` do play(): a
  // promessa resolve quando a reprodução é AUTORIZADA, que é antes de existir
  // quadro na tela — esconder ali deixaria uma piscada da caixa vazia.
  //
  // De mão única de propósito. Ao rolar para fora o observer pausa o vídeo, mas
  // o poster não volta: voltar faria a imagem piscar a cada ida e volta, e o
  // vídeo pausado já mostra o último quadro, que é uma imagem legítima.
  //
  // Fora do `if (!reduzMovimento)` porque não depende do observer: se o vídeo
  // tocar por qualquer via — inclusive o botão de toque do iOS —, o poster tem
  // que sair. Em reduced-motion nada toca e o poster fica, que é o correto.
  for (const video of videos) {
    video.addEventListener(
      'playing',
      () => {
        const caixa = video.closest<HTMLElement>('[data-video360]');
        if (caixa) caixa.dataset.tocando = 'true';
      },
      { once: true }
    );
  }

  // Em prefers-reduced-motion basta não chamar play(): sem o atributo
  // `autoplay` no HTML, nada dispara sozinho e o vídeo fica no poster, como
  // manda o CLAUDE.md. O observer abaixo sequer é criado nesse caso.

  // Estado do elemento no momento da falha — é o que diz se o problema é
  // política de autoplay, mídia não carregada ou o vídeo sem `muted`.
  function estado(video: HTMLVideoElement) {
    return `muted=${video.muted} inline=${video.playsInline} autoplay=${video.autoplay} ready=${video.readyState} net=${video.networkState}`;
  }

  function registrarErro(video: HTMLVideoElement, texto: string) {
    // Fica no DOM para inspeção remota, mesmo sem console.
    video.setAttribute('data-video-erro', texto);
    if (!modoDebug) return;
    const caixa = video.parentElement;
    if (!caixa) return;
    let rotulo = caixa.querySelector<HTMLElement>('[data-video-debug]');
    if (!rotulo) {
      rotulo = document.createElement('p');
      rotulo.setAttribute('data-video-debug', '');
      rotulo.style.cssText =
        'position:absolute;inset-inline:0;bottom:0;margin:0;padding:.4em .6em;' +
        'background:rgba(0,0,0,.78);color:#fff;font:500 12px/1.35 monospace;' +
        'z-index:2;word-break:break-word;';
      caixa.appendChild(rotulo);
    }
    rotulo.textContent = texto;
  }

  if (!reduzMovimento && 'IntersectionObserver' in window) {
    // Quantas tentativas e de quanto em quanto tempo. 6 × 400ms = 2,4s,
    // folgado sobre os 1,1s que a revelação da seção leva.
    const MAX_TENTATIVAS = 6;
    const INTERVALO = 400;
    const agendados = new WeakMap<HTMLVideoElement, number>();

    function cancelar(video: HTMLVideoElement) {
      const id = agendados.get(video);
      if (id !== undefined) {
        clearTimeout(id);
        agendados.delete(video);
      }
    }

    // Último recurso: play por gesto do usuário — a única via que nenhum
    // navegador recusa. Revela o botão, que até aqui estava oculto.
    const comToque = new WeakSet<HTMLVideoElement>();
    function permitirToque(video: HTMLVideoElement) {
      if (comToque.has(video)) return;
      comToque.add(video);

      const caixa = video.parentElement;
      const botao = caixa?.querySelector<HTMLButtonElement>('[data-video360-play]');
      if (!botao) return;

      botao.hidden = false;

      botao.addEventListener('click', () => {
        video.load();
        video.play().then(() => {
          video.removeAttribute('data-video-erro');
          botao.hidden = true;
          if (modoDebug) registrarErro(video, `tocando por toque | ${estado(video)}`);
        });
      });
    }

    // Se o vídeo voltar a tocar sozinho depois (ex.: o visitante rolou fora
    // e voltou), o botão não pode continuar na tela.
    function esconderBotao(video: HTMLVideoElement) {
      const botao = video.parentElement?.querySelector<HTMLButtonElement>('[data-video360-play]');
      if (botao) botao.hidden = true;
    }

    function tentarTocar(video: HTMLVideoElement, tentativa = 0) {
      // MEDIDO NUM IPHONE REAL: networkState=0 (NETWORK_EMPTY) e
      // readyState=0 (HAVE_NOTHING) — o iOS não tinha sequer iniciado a
      // seleção de recurso, ou seja, nunca buscou o arquivo. O
      // NotAllowedError era consequência disso: não há como tocar mídia que
      // não foi carregada. O iOS ignora `preload` para poupar dados do
      // usuário, então quem tem que pedir o carregamento somos nós.
      if (video.networkState === HTMLMediaElement.NETWORK_EMPTY || video.readyState === 0) {
        video.load();
      }

      const promessa = video.play();
      // Navegadores antigos devolvem undefined em vez de Promise.
      if (!promessa || typeof promessa.catch !== 'function') return;

      promessa
        .then(() => {
          video.removeAttribute('data-video-erro');
          esconderBotao(video);
          if (modoDebug) registrarErro(video, `tocando (tentativa ${tentativa + 1}) | ${estado(video)}`);
        })
        .catch((erro: unknown) => {
          const nome = erro instanceof Error ? erro.name : 'Erro';
          const msg = erro instanceof Error ? erro.message : String(erro);
          registrarErro(video, `${nome}: ${msg} | ${estado(video)} (tentativa ${tentativa + 1})`);

          // Só insiste enquanto o vídeo continua em cena. Se falhar em
          // todas, o <video> permanece exibindo o poster — nunca vira um
          // retângulo vazio, porque nada aqui esconde o poster.
          if (tentativa + 1 < MAX_TENTATIVAS) {
            const id = window.setTimeout(() => tentarTocar(video, tentativa + 1), INTERVALO);
            agendados.set(video, id);
          } else {
            // Esgotadas as tentativas, resta a única via que o iOS nunca
            // recusa: um gesto do usuário. O toque na área do vídeo passa a
            // dar play. Até lá o poster continua na tela, então quem não
            // tocar não vê nada quebrado.
            permitirToque(video);
          }
        });
    }

    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          const video = entrada.target as HTMLVideoElement;
          if (entrada.isIntersecting) {
            tentarTocar(video);
          } else {
            cancelar(video);
            video.pause();
          }
        });
      },
      // Metade do vídeo à vista: no iOS, disparar com uma nesga visível é
      // justamente o caso em que o WebKit recusa.
      { threshold: 0.5 }
    );

    videos.forEach((video) => observador.observe(video));
  }
</script>
