---
// Vídeo 360 — um por página, logo acima do carrossel (ver CLAUDE.md >
// Vídeos 360).
//
// CORTE DE 35% DO TOPO, por CSS e sem editar o arquivo: o contêiner recebe
// overflow hidden e um aspect-ratio mais largo que o do vídeo —
//
//     largura / (altura × 0.65)
//
// — e o vídeo dentro preenche esse espaço com object-fit: cover ancorado em
// `center bottom`. Como a caixa é mais baixa do que a proporção original, o
// cover escala pela largura e o excedente sai por CIMA, que é exatamente o
// terço superior que queremos descartar. Nenhum pixel do arquivo é tocado.
//
// O <script> abaixo vira um chunk próprio, carregado só nas páginas que
// renderizam este componente (home e /limousines/) — as 8 páginas de
// serviço/região não o baixam.
import { getImage } from 'astro:assets';

interface Props {
  /** Caminho do MP4 em public/ (o astro:assets não processa vídeo). */
  src: string;
  /** Poster, importado de src/assets pra passar pelo astro:assets. */
  poster: ImageMetadata;
  /** Largura real do arquivo de vídeo. */
  largura: number;
  /** Altura real do arquivo de vídeo. */
  altura: number;
  /** Descrição do que o vídeo mostra — vira o rótulo acessível. */
  alt: string;
  class?: string;
}

const { src, poster, largura, altura, alt, class: className } = Astro.props;

// Fração do topo que sai fora. 0.65 = mantém 65%, corta 35%.
const MANTIDO = 0.65;
const proporcao = largura / (altura * MANTIDO);

// O poster passa pelo astro:assets pra sair em WebP; o atributo `poster` do
// <video> só aceita URL, então o componente <Image> não serve aqui.
const posterOtimizado = await getImage({ src: poster, format: 'webp', width: largura });
---

<div class:list={['video360', className]} style={`aspect-ratio: ${proporcao};`} data-video360>
  {/*
    O `autoplay` é obrigatório para o iOS, e não é redundante com o play()
    do script. O WebKit trata os dois por caminhos diferentes: o play()
    programático sem gesto do usuário é recusado com NotAllowedError (medido
    num iPhone real, nas 6 tentativas), enquanto `autoplay` + `muted` +
    `playsinline` é o caminho declarativo que a Apple documenta como
    permitido. O script continua existindo para pausar fora de cena e para
    retomar quando o vídeo volta — coisas que o atributo sozinho não faz.
  */}
  <video
    src={src}
    poster={posterOtimizado.src}
    width={largura}
    height={altura}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-label={alt}
    data-video360-media></video>
</div>

<style>
  /* O overflow hidden é o que efetivamente recorta: a caixa tem a proporção
     do corte (mais larga que a do vídeo), e o que sobra do vídeo sai por
     fora dela. */
  .video360 {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--surface);
  }

  .video360 video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ancorado embaixo: o excedente sai pelo TOPO, que é o que o corte de
       35% descarta. */
    object-position: center bottom;
  }
</style>

<script>
  // Toca só quando entra na viewport, pausa ao sair — um vídeo rodando fora
  // de cena é bateria e banda gastas à toa.
  //
  // Em prefers-reduced-motion o vídeo nunca toca: fica no poster, que já é o
  // estado de repouso do <video>. Não há nada a fazer além de não chamar
  // play(), então o observer sequer é criado.
  //
  // POR QUE ISTO NÃO É UM `play()` SOLTO:
  //
  // O vídeo mora dentro de uma <section class="reveal">, que fica em
  // opacity ~0 e com transform aplicado até entrar em cena, e leva 1,1s
  // transicionando. O WebKit (iOS) é bem mais rigoroso que o Chrome e
  // recusa reproduzir vídeo que considera não visível na tela — então a
  // primeira chamada de play(), disparada no meio dessa transição, era
  // rejeitada. Como o .catch() antigo descartava o erro, o vídeo ficava
  // parado no primeiro quadro sem deixar rastro.
  //
  // A correção tem três partes: exigir mais área visível para disparar,
  // TENTAR DE NOVO algumas vezes em vez de desistir na primeira rejeição
  // (cobrindo a duração da revelação), e registrar o erro em vez de engoli-lo.
  const reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Diagnóstico visível no aparelho: abra a página com ?videodebug na URL.
  // Fora disso não aparece nada para o visitante.
  const modoDebug = new URLSearchParams(location.search).has('videodebug');

  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-video360-media]'));

  // Com `autoplay` no HTML, o navegador começa a tocar por conta própria —
  // então em prefers-reduced-motion é preciso DESLIGAR o atributo, não
  // apenas deixar de chamar play(). Feito o quanto antes, para o vídeo não
  // chegar a andar: fica no poster, como manda o CLAUDE.md.
  if (reduzMovimento) {
    videos.forEach((video) => {
      video.removeAttribute('autoplay');
      video.autoplay = false;
      video.pause();
      video.currentTime = 0;
    });
  }

  // Estado do elemento no momento da falha — é o que diz se o problema é
  // política de autoplay, mídia não carregada ou o vídeo sem `muted`.
  function estado(video: HTMLVideoElement) {
    return `muted=${video.muted} inline=${video.playsInline} autoplay=${video.autoplay} ready=${video.readyState} net=${video.networkState}`;
  }

  function registrarErro(video: HTMLVideoElement, texto: string) {
    // Fica no DOM para inspeção remota, mesmo sem console.
    video.setAttribute('data-video-erro', texto);
    if (!modoDebug) return;
    const caixa = video.parentElement;
    if (!caixa) return;
    let rotulo = caixa.querySelector<HTMLElement>('[data-video-debug]');
    if (!rotulo) {
      rotulo = document.createElement('p');
      rotulo.setAttribute('data-video-debug', '');
      rotulo.style.cssText =
        'position:absolute;inset-inline:0;bottom:0;margin:0;padding:.4em .6em;' +
        'background:rgba(0,0,0,.78);color:#fff;font:500 12px/1.35 monospace;' +
        'z-index:2;word-break:break-word;';
      caixa.appendChild(rotulo);
    }
    rotulo.textContent = texto;
  }

  if (!reduzMovimento && 'IntersectionObserver' in window) {
    // Quantas tentativas e de quanto em quanto tempo. 6 × 400ms = 2,4s,
    // folgado sobre os 1,1s que a revelação da seção leva.
    const MAX_TENTATIVAS = 6;
    const INTERVALO = 400;
    const agendados = new WeakMap<HTMLVideoElement, number>();

    function cancelar(video: HTMLVideoElement) {
      const id = agendados.get(video);
      if (id !== undefined) {
        clearTimeout(id);
        agendados.delete(video);
      }
    }

    function tentarTocar(video: HTMLVideoElement, tentativa = 0) {
      const promessa = video.play();
      // Navegadores antigos devolvem undefined em vez de Promise.
      if (!promessa || typeof promessa.catch !== 'function') return;

      promessa
        .then(() => {
          video.removeAttribute('data-video-erro');
          if (modoDebug) registrarErro(video, `tocando (tentativa ${tentativa + 1}) | ${estado(video)}`);
        })
        .catch((erro: unknown) => {
          const nome = erro instanceof Error ? erro.name : 'Erro';
          const msg = erro instanceof Error ? erro.message : String(erro);
          registrarErro(video, `${nome}: ${msg} | ${estado(video)} (tentativa ${tentativa + 1})`);

          // Só insiste enquanto o vídeo continua em cena. Se falhar em
          // todas, o <video> permanece exibindo o poster — nunca vira um
          // retângulo vazio, porque nada aqui esconde o poster.
          if (tentativa + 1 < MAX_TENTATIVAS) {
            const id = window.setTimeout(() => tentarTocar(video, tentativa + 1), INTERVALO);
            agendados.set(video, id);
          }
        });
    }

    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          const video = entrada.target as HTMLVideoElement;
          if (entrada.isIntersecting) {
            tentarTocar(video);
          } else {
            cancelar(video);
            video.pause();
          }
        });
      },
      // Metade do vídeo à vista: no iOS, disparar com uma nesga visível é
      // justamente o caso em que o WebKit recusa.
      { threshold: 0.5 }
    );

    videos.forEach((video) => observador.observe(video));
  }
</script>
